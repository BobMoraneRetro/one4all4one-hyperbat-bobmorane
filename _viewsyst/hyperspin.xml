						<path>${intlogoclearallregion}</path>
						<storyboard event="activate" ifSubset="systemwheelfade:amoitie">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0.3" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="scroll" ifSubset="systemwheelfade:amoitie">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0.3" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="deactivate" ifSubset="systemwheelfade:amoitie">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0.3" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="activate" ifSubset="systemwheelfade:activate">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="scroll" ifSubset="systemwheelfade:activate">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="deactivate" ifSubset="systemwheelfade:activate">
