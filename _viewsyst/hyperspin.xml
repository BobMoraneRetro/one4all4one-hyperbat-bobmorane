							<animation property="opacity" from="1" to="0" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
					</image>
					<image name="logo" ifSubset="systemlogocops1:logobd|logoovalcarb|logoovalcarbfresh|hmaxovalsilver|logorect|logorectfresh|hmaxrectrefl|glassnekhros" pos="0.5 0.5" origin="0.5" maxSize="1" linearSmooth="true">
