<?xml version="1.0" encoding="UTF-8"?>
<theme defaultView="hyperbat">
	<!-- <theme> -->
	<formatVersion>7</formatVersion>
	<variables>
		<!-- <bobmediapath ifSubset="folder:bobmedia">${themePath}/../_bobmedia</bobmediapath> -->
		<!-- <bobmediapath ifSubset="folder:default">${themePath}</bobmediapath> -->
		<bobmediapath>${themePath}</bobmediapath>
		<path_game_theme ifSubset="extfoldergametheme:extfolder">${themePath}/../_bobmedia/_gametheme</path_game_theme>
		<path_game_theme ifSubset="extfoldergametheme:intheme">${themePath}/_gametheme</path_game_theme>
		<path_syst_theme ifSubset="extfoldervideosyst:extfolder">${themePath}/../_bobmedia/_systemmedia/videosyst</path_syst_theme>
		<path_syst_theme ifSubset="extfoldervideosyst:intheme">${themePath}/_systemmedia/videosyst</path_syst_theme>
		<path_game_media ifSubset="extfoldergamemedia:extfolder">${themePath}/../_bobmedia/_gamemedia/</path_game_media>
		<path_game_media ifSubset="extfoldergamemedia:intheme">${themePath}/_gamemedia/</path_game_media>
		<path_game_manuf ifSubset="extfoldermanufacturer:extfolder">${themePath}/../_bobmedia/_gamemedia/_manufacturer</path_game_manuf>
		<path_game_manuf ifSubset="extfoldermanufacturer:intheme">${themePath}/_gamemedia/_manufacturer</path_game_manuf>
		<path_syst_logo ifSubset="extfolderlogosyst:extfolder">${themePath}/../_bobmedia/_systemmedia/_logosyst</path_syst_logo>
		<path_syst_logo ifSubset="extfolderlogosyst:intheme">${themePath}/_systemmedia/_logosyst</path_syst_logo>
		<path_syst_fanart ifSubset="extfolderfanart:extfolder">${themePath}/../_bobmedia/_systemmedia/_fanartsysteme</path_syst_fanart>
		<path_syst_fanart ifSubset="extfolderfanart:intheme">${themePath}/_systemmedia/_fanartsysteme</path_syst_fanart>
		<path_syst_bezel ifSubset="extfolderbezelsyst:extfolder">${themePath}/../_bobmedia/_systemmedia/bezelsyst</path_syst_bezel>
		<path_syst_bezel ifSubset="extfolderbezelsyst:intheme">${themePath}/_systemmedia/bezelsyst</path_syst_bezel>
		<path_couleurs_infos ifSubset="extfoldercouleursinfos:extfolder">${themePath}/../_bobmedia/_common</path_couleurs_infos>
		<path_couleurs_infos ifSubset="extfoldercouleursinfos:intheme">${themePath}/_common</path_couleurs_infos>
		<!-- <path_com_shaders ifSubset="extfoldershaders:extfolder">${themePath}/../_bobmedia/_common/shaders</path_com_shaders> -->
		<!-- <path_com_shaders ifSubset="extfoldershaders:intheme">${themePath}/_common/shaders</path_com_shaders> -->
		<path_com_shaders>${themePath}/_common/shaders</path_com_shaders>
		<!-- ###### Dossiers d'interface du theme : 1 variable par dossier ###### -->
		<path_common>${themePath}/_common</path_common>
		<path_sysmedia>${themePath}/_systemmedia</path_sysmedia>
		<path_vgameopt>${themePath}/_viewgameoption</path_vgameopt>
		<path_vgame>${themePath}/_viewgame</path_vgame>
		<path_vsystopt>${themePath}/_viewsystoption</path_vsystopt>
		<path_vsyst>${themePath}/_viewsyst</path_vsyst>
	</variables>
	<variables>
		<!-- #### System ################################################################################################################################################################# -->
		<!-- Utilisé par Hyperbat : nouveau dans standalone -->
		<firstbackgrsyst>firstfile(
			"${path_game_theme}/" + stem({game:system:theme}) + "/hyperbat/_default/" + {game:system:theme} + "-" + {game:region} + ".png",
			"${path_game_theme}/" + stem({game:system:theme}) + "/hyperbat/_default/defautback.png")</firstbackgrsyst>
		<!-- Utilisé par Hyperbat et Fanartstar -->
		<extmanufacturer>"${path_game_manuf}/" + {game:publisher} + ".png"</extmanufacturer>
		<!-- Condition si aucun thème pour ce jeu n'existe -->
		<IfnoextGamethemeexist>!exists("${path_game_theme}/${system.theme}/hyperbat/" + stem({game:rom}) + "/theme.xml")</IfnoextGamethemeexist>
		<Ifnosystemdefautexist>!exists("${path_game_theme}/${system.theme}/hyperbat/_default/theme.xml")</Ifnosystemdefautexist>
		<!-- System Chemin pour les logo système clear de base -->
		<intlogoclearallregion>firstfile(
                    "${path_syst_logo}/clearlogos/lang-${lang}/" + {system:theme} + "-${lang}.png",
					"${path_syst_logo}/clearlogos/region-${region}/" + {system:theme} + "-${region}.png",
					"${path_syst_logo}/clearlogos/" + {system:theme} + ".png",
					"${path_syst_logo}/clearlogos/lang-${lang}/" + {system:theme} + "-${lang}.svg",
					"${path_syst_logo}/clearlogos/region-${region}/" + {system:theme} + "-${region}.svg",
					"${path_syst_logo}/clearlogos/" + {system:theme} + ".svg")</intlogoclearallregion>
		<intlogoclearpng>${path_syst_logo}/clearlogos/${system.theme}.png</intlogoclearpng>
		<intlogoclearfrpng>${path_syst_logo}/clearlogos/${system.theme}-fr.png</intlogoclearfrpng>
		<intlogoclearuspng>${path_syst_logo}/clearlogos/${system.theme}-us.png</intlogoclearuspng>
		<intlogoclearjppng>${path_syst_logo}/clearlogos/${system.theme}-jp.png</intlogoclearjppng>
		<!-- <intlogoclearpng>"${path_syst_logo}/clearlogos/" + {system:theme} + ".png"</intlogoclearpng> -->
		<!-- <intlogoclearfrpng>"${path_syst_logo}/clearlogos/" + {system:theme} + "-fr.png"</intlogoclearfrpng> -->
		<!-- <intlogoclearuspng>"${path_syst_logo}/clearlogos/" + {system:theme} + "-us.png"</intlogoclearuspng> -->
		<!-- <intlogoclearjppng>"${path_syst_logo}/clearlogos/" + {system:theme} + "-jp.png"</intlogoclearjppng> -->
		<!-- System Chemin pour les logos systèmes supplémentaires -->
		<extlogobd>				firstfile(
								"${path_syst_logo}/comic/lang-${lang}/" + {system:theme} + "-${lang}.png",
								"${path_syst_logo}/comic/region-${region}/" + {system:theme} + "-${region}.png",
								"${path_syst_logo}/comic/" + {system:theme} + ".png",
								"${path_syst_logo}/clearlogos/" + {system:theme} + ".png",
								"${path_syst_logo}/clearlogos/" + {system:theme} + ".svg")</extlogobd>
		<extlogohcarbon>		firstfile(
								"${path_syst_logo}/hmaxcarbon/lang-${lang}/" + {system:theme} + "-${lang}.png",
								"${path_syst_logo}/hmaxcarbon/region-${region}/" + {system:theme} + "-${region}.png",
								"${path_syst_logo}/hmaxcarbon/" + {system:theme} + ".png",
								"${path_syst_logo}/clearlogos/" + {system:theme} + ".png",
								"${path_syst_logo}/clearlogos/" + {system:theme} + ".svg")</extlogohcarbon>
		<exthmaxovalsilver>		firstfile(
								"${path_syst_logo}/hmaxovalsilver/lang-${lang}/" + {system:theme} + "-${lang}.png",
								"${path_syst_logo}/hmaxovalsilver/region-${region}/" + {system:theme} + "-${region}.png",
								"${path_syst_logo}/hmaxovalsilver/" + {system:theme} + ".png",
								"${path_syst_logo}/clearlogos/" + {system:theme} + ".png",
								"${path_syst_logo}/clearlogos/" + {system:theme} + ".svg")</exthmaxovalsilver>
		<extlogohrect>			firstfile(
								"${path_syst_logo}/hmaxrect/lang-${lang}/" + {system:theme} + "-${lang}.png",
								"${path_syst_logo}/hmaxrect/region-${region}/" + {system:theme} + "-${region}.png",
								"${path_syst_logo}/hmaxrect/" + {system:theme} + ".png",
								"${path_syst_logo}/clearlogos/" + {system:theme} + ".png",
								"${path_syst_logo}/clearlogos/" + {system:theme} + ".svg")</extlogohrect>
		<!-- System Chemin pour les logos systèmes de la team Fresh -->
		<extlogohrectfresh>		firstfile(
								"${path_syst_logo}/hmaxrectfresh/lang-${lang}/" + {system:theme} + "-${lang}.png",
								"${path_syst_logo}/hmaxrectfresh/region-${region}/" + {system:theme} + "-${region}.png",
								"${path_syst_logo}/hmaxrectfresh/" + {system:theme} + ".png",
								"${path_syst_logo}/clearlogos/" + {system:theme} + ".png",
								"${path_syst_logo}/clearlogos/" + {system:theme} + ".svg")</extlogohrectfresh>
		<exthmaxrectrefl>		firstfile(
								"${path_syst_logo}/hmaxrectrefl/lang-${lang}/" + {system:theme} + "-${lang}.png",
								"${path_syst_logo}/hmaxrectrefl/region-${region}/" + {system:theme} + "-${region}.png",
								"${path_syst_logo}/hmaxrectrefl/" + {system:theme} + ".png",
								"${path_syst_logo}/clearlogos/" + {system:theme} + ".png",
								"${path_syst_logo}/clearlogos/" + {system:theme} + ".svg")</exthmaxrectrefl>
		<extlogohcarbonfresh>	firstfile(
								"${path_syst_logo}/hmaxcarbonfresh/lang-${lang}/" + {system:theme} + "-${lang}.png",
								"${path_syst_logo}/hmaxcarbonfresh/region-${region}/" + {system:theme} + "-${region}.png",
								"${path_syst_logo}/hmaxcarbonfresh/" + {system:theme} + ".png",
								"${path_syst_logo}/clearlogos/" + {system:theme} + ".png",
								"${path_syst_logo}/clearlogos/" + {system:theme} + ".svg")</extlogohcarbonfresh>
		<extglassnekhros>		firstfile(
								"${path_syst_logo}/nekhglass/lang-${lang}/" + {system:theme} + "-${lang}.png",
								"${path_syst_logo}/nekhglass/region-${region}/" + {system:theme} + "-${region}.png",
								"${path_syst_logo}/nekhglass/" + {system:theme} + ".png",
								"${path_syst_logo}/clearlogos/" + {system:theme} + ".png",
								"${path_syst_logo}/clearlogos/" + {system:theme} + ".svg")</extglassnekhros>
		<!-- System Gestion des bezels système : videosyst.xml -->
		<intbezelsyst>firstfile(
					"${path_syst_bezel}/region-${region}/" + {system:theme} + "-${region}.png",
					"${path_syst_bezel}/" + ({system:theme}) + ".png")</intbezelsyst>
		<!-- System : Vidéos de présentation système : videosyst.xml -->
		<exthyperpie>${path_syst_theme}/hyperpie/${system.theme}.mp4</exthyperpie>
		<extunified>${path_syst_theme}/unified/${system.theme}.mkv</extunified>
		<extbouchetrou>${path_syst_theme}/bouchetrou/${system.theme}.mp4</extbouchetrou>
		<extvideofresh>${themePath}/../../videothemes/${system.theme}.mp4</extvideofresh>
		<!-- System : Vidéos de présentation système : videosyst.xml -->
		<extspinxml>${path_syst_theme}/hyperspin/${system.theme}.xml</extspinxml>
		<extspinxpxml>${path_syst_theme}/hyperspinxp/${system.theme}/systheme.xml</extspinxpxml>
		
		<!-- System : Affichage des fanart système : fanartsyst.xml -->
		<intfanartfresh>${path_syst_fanart}/fresh/${system.theme}.jpg</intfanartfresh>
		<intfanartfresh2>("${path_syst_fanart}/fresh/" + {system:theme} + ".jpg")</intfanartfresh2>
		<intfanartcustom>("${path_syst_fanart}/custom/" + {system:theme} + ".jpg")</intfanartcustom>
		<intfondsystem>("${themePath}/_viewgame/hyperbat/fondsysteme/" + {system:theme} + ".png")</intfondsystem>
		
		<!-- <intfondsystem>"${themePath}/_viewgame/hyperbat/fondsysteme/" + stem({system:theme}) + ".png"</intfondsystem> -->
		<intspinback>"${themePath}/_viewgame/hyperbat/fondsysteme/" + {game:system:theme} + ".png"</intspinback>
		<!-- System : Actif si absence de systheme.xml dans le thème hyperbat : videosyst.xml, fanartsyst.xml -->
		<ifnoextsysthemeexist>!exists("${path_syst_theme}/hyperspinxp/" + stem({system:theme}) + "/systheme.xml")</ifnoextsysthemeexist>
		<!-- System : personnage en png associé aux systèmes -->
		<intcharsyst>${themePath}/_systemmedia/charsystem/{game:system:theme}.png</intcharsyst>
		<!-- System : pointeurs en png associé aux systèmes -->
		<!-- <pointers4syst>${themePath}/_systemmedia/pointers-r/${system.theme}.png</pointers4syst> -->
		<pointers4syst>firstfile(
					"${themePath}/_systemmedia/pointers-r/region-${region}/" + {system:theme} + "-${region}.png",
					"${themePath}/_systemmedia/pointers-r/" + {system:theme} + ".png")</pointers4syst>
		<!-- <pointers4games>"${themePath}/_systemmedia/pointers-r/" + {game:system:theme} + ".png"</pointers4games> -->
		<pointers4games>firstfile("${themePath}/_systemmedia/pointers-r/region-" + {game:region} + "/"  + ({game:system:theme}) + "-" + {game:region} + ".png",
						"${themePath}/_systemmedia/pointers-r/" + {game:system:theme} + ".png")</pointers4games>
		<!-- <pointers4games>firstfile("${themePath}/_systemmedia/pointers-r/region-${region}/" + {system:theme} + "-${region}.png", -->
		<!-- "${themePath}/_systemmedia/pointers-r/" + {system:theme} + ".png")</pointers4games> -->
		<!-- Syste & Jeux Logo Système en fonction du jeu -->
		<extgamesyst>"${path_syst_logo}/clearlogos/" + {game:system} ".png"</extgamesyst>
		<!-- Jeux : gamethème Hyperbat -->
		<!-- <extgametheme>${path_game_theme}/${system.theme}/hyperbat</extgametheme> -->
		<extgametheme>${path_game_theme}/${system.theme}/hyperbat</extgametheme>
		<extgametheme.persyst>"${path_game_theme}/" + {game:system:theme} + "/hyperbat"</extgametheme.persyst>
		<extGametheme.defaut>${path_game_theme}/${system.theme}/hyperbat/_default/theme.xml</extGametheme.defaut>
		<extgemetheme.generic>${path_game_theme}/${system.theme}/hyperbat/_default/theme.xml</extgemetheme.generic>
		<extGametheme.defautarcade>${path_game_theme}/arcade/hyperbat/_default/theme.xml</extGametheme.defautarcade>
		<!-- Jeux : Condition si fanart ou box 2d -->
		<!-- <standardsbuildsfanart>exists({game:fanart}) ? {game:fanart} : {game:thumbnail}</standardsbuildsfanart> -->
		<standardsbuildsfanart>{game:fanart}</standardsbuildsfanart>
		<freshbuildfanart>exists({game:image}) ? {game:image} : {game:thumbnail}</freshbuildfanart>
		<!-- Jeux : action si fanart existe : detailed.xml -->
		<standardsbuildsfanarttestyes>exists({game:fanart})</standardsbuildsfanarttestyes>
		<standardsbuildsfanarttest>!exists({game:fanart})</standardsbuildsfanarttest>
		<freshbuildfanarttestyes>exists({game:image})</freshbuildfanarttestyes>
		<freshbuildfanarttest>!exists({game:image})</freshbuildfanarttest>
		<!-- Jeux média spécifique -->
		<extgameartpng>("${themePath}/../../../../roms/${system.theme}/@media/wheel - Art/" + stem({game:rom}) + "-wheel.png")</extgameartpng>
		<extgamefanartjpg>firstfile("${path_game_media}/" + ({game:system:theme}) + "/cover/" + stem({game:rom}) + ".jpg",
			"${path_game_media}/"  + ({game:system:theme}) + "/medium_artwork/fanart/" + stem({game:rom}) + ".jpg")</extgamefanartjpg>
		<extgame3dbox>firstfile("${path_game_media}/" + ({game:system:theme}) + "/3dbox/" + stem({game:rom}) + ".png",
			"${path_game_media}/"  + ({game:system:theme}) + "/medium_artwork/artwork_3d/" + stem({game:rom}) + ".png")</extgame3dbox>
		<extgamescreenjpg>"${path_game_media}/" + ({game:system:theme}) + "/screenshots/" + stem({game:rom}) + ".png"</extgamescreenjpg>
		<extgamevideo>firstfile(
			"${path_game_media}" + ({game:system:theme}) + "/video/" + stem({game:rom}) + ".avi",
			"${path_game_media}" + ({game:system:theme}) + "/video/" + stem({game:rom}) + ".mp4",
			"${path_game_media}" + ({game:system:theme}) + "/medium_artwork/video/" + stem({game:rom}) + ".avi",
			"${path_game_media}" + ({game:system:theme}) + "/medium_artwork/video/" + stem({game:rom}) + ".mp4")</extgamevideo>
		<corefrontart>"${path_game_media}/" + ({game:system:theme}) + "/medium_artwork/artwork_front/" + stem({game:rom}) + ".png"</corefrontart>
		<!-- ###### Bloc sous-systeme : centralise depuis les 940 _gametheme/*/hyperbat/<syst>/theme.xml ###### -->
		<extsubsystvideo>firstfile(
			"${path_syst_theme}/hyperpie/" + ({game:system:theme}) + ".mp4",
			"${path_syst_theme}/subsystem/" + ({game:system:theme}) + ".mp4",
			"${path_syst_theme}/subsystem/" + ({game:system:theme}) + ".avi",
			"${path_syst_theme}/subsystem/" + ({game:system:theme}) + ".flv",
			"${path_syst_theme}/subsystem/" + ({game:system:theme}) + ".mkv")</extsubsystvideo>
		<ifnosubsystvideo>!exists("${path_syst_theme}/hyperpie/" + ({game:system:theme}) + ".mp4") &amp;&amp;
			!exists("${path_syst_theme}/subsystem/" + ({game:system:theme}) + ".mp4") &amp;&amp;
			!exists("${path_syst_theme}/subsystem/" + ({game:system:theme}) + ".avi") &amp;&amp;
			!exists("${path_syst_theme}/subsystem/" + ({game:system:theme}) + ".flv") &amp;&amp;
			!exists("${path_syst_theme}/subsystem/" + ({game:system:theme}) + ".mkv")</ifnosubsystvideo>
		<extsubsystimage>firstfile(
			"${path_syst_theme}/subsystem/" + ({game:system:theme}) + ".jpg",
			"${path_syst_theme}/subsystem/" + ({game:system:theme}) + ".png")</extsubsystimage>
		<!-- ###### Artworks lateraux hyperspin : centralises depuis 770 _gametheme/**/theme.xml ###### -->
		<extspinleftart>"${path_syst_theme}/hyperspin/leftart/" + {game:system:theme} + ".png"</extspinleftart>
		<extspinrightart>"${path_syst_theme}/hyperspin/rightart/" + {game:system:theme} + ".png"</extspinrightart>
		<!-- ###### Cadre 16/9 commun : centralise depuis 1710 fichiers ###### -->
		<comcadre169>${themePath}/_common/images/169v2.png</comcadre169>
		<!-- ###### Polices : une variable par police ###### -->
		<fontcabinbold>${themePath}/_common/fonts/Cabin-Bold.ttf</fontcabinbold>
		<fontdigitalserial>${themePath}/_common/fonts/Digital-Serial-Bold-folder.ttf</fontdigitalserial>
		<fontopensans>${themePath}/_viewgame/fanartstar/OpenSans_Condensed-Bold.ttf</fontopensans>
		<fontimpact>${themePath}/_common/fonts/impact.ttf</fontimpact>
		<fonttekobold>${themePath}/_viewsyst/hyperbat/teko-bold.ttf</fonttekobold>
		<fonttmonmonsori>${themePath}/_viewgame/retrower/fonts/TmonMonsori.ttf</fonttmonmonsori>
		<!-- Couleur de selection du menu système -->
		<colordea>999999</colordea>
		<coloract>ffffff</coloract>
		<!-- Couleurs des infos de jeux (vue hyperbat) : valeurs par défaut, remplacées par hyperbatgameinfocolors.xml -->
		<infotitre_couleur>f0f000</infotitre_couleur>
		<infotitre_halo>0c002e</infotitre_halo>
		<infotitre_halotaille>1.5</infotitre_halotaille>
		<infotitre_halodecalage>2</infotitre_halodecalage>
		<infoligne_couleur>ffff00</infoligne_couleur>
		<infoligne_halo>0c002e</infoligne_halo>
		<infoligne_halotaille>1.5</infoligne_halotaille>
		<infoligne_halodecalage>2</infoligne_halodecalage>
		<infotitre_police>${path_vgame}/hyperbat/AlphaFridgeMagnets.ttf</infotitre_police>
		<infotitre_taille>0.05</infotitre_taille>
		<infoligne_police>${path_vgame}/hyperbat/AlphaFridgeMagnets.ttf</infoligne_police>
		<infoligne_taille>0.02</infoligne_taille>
		<!-- Suffixe des fichiers de correction par ratio -->
		<ratiosfx ifSubset="screenratio:r43">43</ratiosfx>
		<ratiosfx ifSubset="screenratio:r1610">1610</ratiosfx>
		<ratiosfx ifSubset="screenratio:r169">169</ratiosfx>
		<!-- Fichier du theme de jeu charge par gameextras (_viewgame/hyperbat.xml) ; vide si aucun.
		     Sert aussi a la visibilite des generiques (_genericdefault) : une seule liste de chemins.
		     ATTENTION : lu avant _advancedusers.xml, l'option par defaut (mamefolder) DOIT rester en dernier. -->
		<gamethemefile ifSubset="gameviewsource:actualsystem">firstfile(
			"${path_game_theme}/${system.theme}/hyperbat/" + stem({game:rom}) + "/theme-${ratiosfx}.xml",
			"${path_game_theme}/${system.theme}/hyperbat/" + stem({game:rom}) + "/theme.xml",
			"${path_game_theme}/" + {system:theme} + "/hyperbat/_default/theme-${ratiosfx}.xml",
			"${path_game_theme}/" + {system:theme} + "/hyperbat/_default/theme.xml",
			"${path_game_theme}/" + {game:system:theme} + "/hyperbat/" + stem({game:rom}) + "/theme-${ratiosfx}.xml",
			"${path_game_theme}/" + {game:system:theme} + "/hyperbat/" + stem({game:rom}) + "/theme.xml",
			"${path_game_theme}/" + {game:system:theme} + "/hyperbat/_default/theme-${ratiosfx}.xml",
			"${path_game_theme}/" + {game:system:theme} + "/hyperbat/_default/theme.xml")</gamethemefile>
		<gamethemefile ifSubset="gameviewsource:genericstyleonly">""</gamethemefile>
		<gamethemefile ifSubset="gameviewsource:mamefolder">firstfile(
			"${path_game_theme}/" + {game:system:theme} + "/hyperbat/" + stem({game:rom}) + "/theme-${ratiosfx}.xml",
			"${path_game_theme}/" + {game:system:theme} + "/hyperbat/" + stem({game:rom}) + "/theme.xml",
			"${path_game_theme}/mame/hyperbat/" + stem({game:rom}) + "/theme-${ratiosfx}.xml",
			"${path_game_theme}/mame/hyperbat/" + stem({game:rom}) + "/theme.xml",
			"${path_game_theme}/" + {game:system:theme} + "/hyperbat/_default/theme-${ratiosfx}.xml",
			"${path_game_theme}/" + {game:system:theme} + "/hyperbat/_default/theme.xml",
			"${path_game_theme}/" + {system:theme} + "/hyperbat/_default/theme-${ratiosfx}.xml",
			"${path_game_theme}/" + {system:theme} + "/hyperbat/_default/theme.xml")</gamethemefile>
		<!-- Video par defaut des generiques (ni capture ni video) : option videodefaut (_advancedusers.xml).
		     Lu avant _advancedusers.xml : l'option par defaut (activate) DOIT rester en dernier. -->
		<videodefautpath ifSubset="videodefaut:desactive"></videodefautpath>
		<videodefautpath ifSubset="videodefaut:activate">${bobmediapath}/_systemmedia/defaut/scotty.mp4</videodefautpath>
	</variables>
	<!-- fichiers de traductions disponibles -->
	<include>${themePath}/_common/_langs/fr.xml</include>
	<include>${themePath}/_common/_langs/${lang}.xml</include>
	<!-- Couleurs des infos de jeux par système -->
	<include>${path_couleurs_infos}/hyperbatgameinfocolors.xml</include>
