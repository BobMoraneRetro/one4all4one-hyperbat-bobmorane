		<!-- <text>{game:stars}</text> -->
		<!-- <origin>0.5 0.5</origin> -->
		<!-- <pos>0.825 0.800</pos> -->
		<!-- <size>0.17 0.05</size> -->
		<!-- <alignment>center</alignment> -->
		<!-- <fontSize>0.036</fontSize> -->
		<!-- <color>FFCC00D0</color> -->
		<!-- <zIndex>340</zIndex> -->
		<!-- </text> -->
		<!-- ################################ Affichage de la notation vide pour l'arriere plan ######################################## -->
		<!-- Fond de 5 étoiles grises, toujours affiché (zIndex=289 = derrière les étoiles colorées) -->
		<text name="blank_rating" extra="true">
			<fontPath>${path_vgame}/retrower/fonts/fontawesome.ttf</fontPath>
			<origin>0.5 0.5</origin>
			<pos>0.85 0.800</pos>
			<size>0.17 0.05</size>
			<color>968f8f</color>
			<fontSize>0.036</fontSize>
			<glowOffset>0</glowOffset>
			<glowColor>000000</glowColor>
			<glowSize>1</glowSize>
			<!-- Affiche toujours 5 icônes grises comme fond -->
			<text>${gamerating}${gamerating}${gamerating}${gamerating}${gamerating}</text>
			<zIndex>289</zIndex>
		</text>
		<!-- Affichage et remplissage de la notation en fonction de {game:rating} -->
		<!-- 0.20000 un icone -->
		<!-- 0.40000 deux icones -->
		<!-- 0.60000 trois icones -->
		<!-- 0.80000 quatre icones -->
		<!-- 1.00000 cinq icones -->
		<!-- 1 étoile or : visible uniquement si la note est exactement 0.200000 -->
		<text name="rating_filled_1" extra="true">
			<visible>contains({game:rating},'0.200000')</visible>
			<text>${gamerating}</text>
		</text>
		<!-- 2 étoiles or -->
		<text name="rating_filled_2" extra="true">
			<visible>contains({game:rating},'0.400000')</visible>
			<text>${gamerating}${gamerating}</text>
		</text>
		<!-- 3 étoiles or -->
		<text name="rating_filled_3" extra="true">
			<visible>contains({game:rating},'0.600000')</visible>
			<text>${gamerating}${gamerating}${gamerating}</text>
		</text>
		<!-- 4 étoiles or -->
		<text name="rating_filled_4" extra="true">
			<visible>contains({game:rating},'0.800000')</visible>
			<text>${gamerating}${gamerating}${gamerating}${gamerating}</text>
		</text>
		<!-- 5 étoiles or -->
		<text name="rating_filled_5" extra="true">
			<visible>contains({game:rating},'1.000000')</visible>
			<text>${gamerating}${gamerating}${gamerating}${gamerating}${gamerating}</text>
		</text>
		<!-- Paramètres communs à tous les rating_filled_X : position, taille, police, couleur or.
		     zIndex=290 : juste devant le fond gris (zIndex 289). -->
		<!--Definition des parametres commun pour l'affichage des icones-->
		<control name="rating_filled_1, rating_filled_2, rating_filled_3, rating_filled_4, rating_filled_5">
			<origin>0.5 0.5</origin>
