<?xml version="1.0" encoding="UTF-8"?>
<!--
    ════════════════════════════════════════════════════════════════════
    GUIDE DÉBUTANT — retrower.xml
    ════════════════════════════════════════════════════════════════════
    Ce fichier définit la VUE DE JEU "retrower" du thème HyperBat.
    Il s'affiche quand on parcourt la liste des jeux d'une console.

    CONCEPTS DE BASE :
    ──────────────────
    • Toutes les positions (pos) et tailles (size) sont en PROPORTIONS
      de l'écran : 0.0 = bord gauche/haut, 1.0 = bord droit/bas.
    • zIndex : ordre d'empilement. Plus grand = plus en avant-plan.
    • extra="true" : élément décoratif ajouté par le thème (pas un
      élément standard d'EmulationStation).
    • inherits="gamecarousel" : cette vue HÉRITE d'une vue parente,
      elle récupère tous ses éléments et peut les surcharger/ajouter.
    • {game:xxx}  → valeur dynamique liée au JEU sélectionné.
    • {system:xxx} → valeur dynamique liée à la CONSOLE en cours.
    • ${mavariable} → variable définie dans le bloc <variables>.
    • firstfile(A,B,C) → cherche le premier fichier qui existe parmi A, B, C.
    • contains(texte,"mot") → renvoie vrai si "texte" contient "mot".
    ════════════════════════════════════════════════════════════════════
-->
<theme defaultView="hyperbat">
	<!-- Version du format de thème RetroBat/EmulationStation. Ne pas modifier. -->
	<formatVersion>7</formatVersion>
	<!-- ═══════════════════════════════════════════════════════════════
	     BLOC VARIABLES
	     ═══════════════════════════════════════════════════════════════
	     Les variables sont des raccourcis réutilisables partout dans
	     le fichier via la syntaxe ${nomvariable}.
	     Elles évitent de répéter de longs chemins ou expressions.
	     Pour créer la vôtre : <mavariable>valeur</mavariable>
	     ═══════════════════════════════════════════════════════════════ -->
	<variables>
		<!-- Variables utilisees dans ce fichier (definitions reprises de theme.xml) -->
		<!-- <bobmediapath>${themePath}/../_bobmedia</bobmediapath> -->
		<!-- Chemin vers le screenshot du jeu dans le dossier de médias externe -->
		<extgamescreenjpg>("${path_game_media}/"  + ({game:system:theme}) + "/screenshots/" + stem({game:rom}) + ".jpg")</extgamescreenjpg>
		<!-- Chemin vers l'image de borne arcade (cab) du jeu -->
		<globalgamecabs>"${path_game_media}/" + ({game:system:theme}) + "/cabs/" + stem({game:rom}) + ".png"</globalgamecabs>
		<!-- firstfile() cherche dans l'ordre : cab du jeu > cab générique console > cab système > cab par défaut.
		     C'est le mécanisme de FALLBACK : si l'image du jeu n'existe pas, on prend la suivante. -->
		<intcoinopscollec>firstfile( "${path_game_media}/" + ({game:system:theme}) + "/cabs/" + stem({game:rom}) + ".png",
					"${path_game_media}/" + ({game:system:theme}) + "/cabs/_"  + ({game:system:theme}) + ".png",
					"${path_game_media}/_systemcoinops/"  + ({game:system:theme}) + ".png",
					"${path_game_media}/_defaultgamemedia/cabs/default.png")
		</intcoinopscollec>
		<!-- Logo de borne CoinOps Next pour la console en cours -->
		<intcoinopsnext>("${themePath}/_viewgame/coinops/coinopsnext/"  + ({game:system:theme}) + ".png")</intcoinopsnext>
		<!-- <bobmediapath>${themePath}</bobmediapath> -->
		<!-- firstfile() pour le personnage/mascotte associé à la console.
		     Cherche d'abord dans ce thème, puis dans le thème Animatics-DX en fallback. -->
		<firstscharsystem>		firstfile("${themePath}/_systemmedia/charsystem/" + {system:theme} + ".png","${themePath}/../es-theme-Animatics-DX/art/figurines/" + {system:theme} + ".png")</firstscharsystem>
		<firstsnapouille>		firstfile("${themePath}/../es-theme-Animatics-DX/art/figurines/" + {system:theme} + ".png","${themePath}/_systemmedia/charsystem/" + {system:theme} + ".png")</firstsnapouille>
		<!-- Image du hardware/console physique (photo de la machine) -->
		<firstsystemhardware>	firstfile("${themePath}/_systemmedia/hardware/" + {system:theme} + ".png","${themePath}/_systemmedia/charsystem/" + {system:theme} + ".png")</firstsystemhardware>
		<!-- Fanart système : cherche d'abord la version "fresh" puis "custom" -->
		<firstsystfanart>		firstfile("${path_syst_fanart}/fresh/" + {system:theme} + ".jpg","${path_syst_fanart}/custom/" + {system:theme} + ".jpg")</firstsystfanart>
		<!-- Image système : priorité à "custom" puis "fresh" (ordre inverse de firstsystfanart) -->
		<firstsystemimage>		firstfile("${path_syst_fanart}/custom/" + {system:theme} + ".jpg","${path_syst_fanart}/fresh/" + {system:theme} + ".jpg")</firstsystemimage>
		<!-- Icône de notation (étoile FontAwesome &#xf005;).
		     Les lignes commentées ci-dessous montrent des variantes possibles :
		     coeur (&#xf004;), gamepad (&#xf11b;), smiley (&#xf599;), etc.
		     Décommentez-en une et commentez l'autre pour changer l'icône. -->
		<!-- <gamerating ifSubset="rating:coeur">&#xf004;</gamerating> -->
		<!-- <gamerating ifSubset="rating:gamepad">&#xf11b;</gamerating> -->
		<!-- <gamerating ifSubset="rating:smiles">&#xf599;</gamerating> -->
		<!-- <gamerating ifSubset="rating:ghost">&#xf6e2;</gamerating> -->
		<gamerating>&#xf005;</gamerating>
		<!-- <gamerating ifSubset="rating:skull">&#xf54c;</gamerating> -->
		<!-- <gamerating ifSubset="rating:dollar">&#xf155;</gamerating> -->
	</variables>
	<!-- ═══════════════════════════════════════════════════════════════
	     VUE PERSONNALISÉE "retrower"
	     ═══════════════════════════════════════════════════════════════
	     inherits="gamecarousel" : on part de la vue carrousel standard
	     et on ajoute/remplace tous les éléments ci-dessous.
	     ═══════════════════════════════════════════════════════════════ -->
	<customView name="retrower" displayName="${retrower}" inherits="gamecarousel">
		<!-- ── Masquage des éléments hérités non désirés ──────────────
		     Ces éléments existent dans gamecarousel mais on les cache
		     pour utiliser nos propres équivalents à la place. -->
		<!-- Désactive les zones fanart/screenshot/vidéo standards héritées -->
		<control name="fanart_extra,screenshot_extra,video_extra">
			<visible>false</visible>
		</control>
		<!-- Cache l'image principale du jeu héritée (on utilise notre propre <image name="screenshot">) -->
		<image name="md_image">
			<visible>false</visible>
		</image>
		<!-- Cache la vignette héritée (on gère les vignettes dans l'itemTemplate du carrousel) -->
		<image name="md_thumbnail">
			<visible>false</visible>
		</image>
		<!-- ═══════════════════════════════════════════════════════════
		     CARROUSEL DE JEUX
		     ═══════════════════════════════════════════════════════════
		     Le carrousel affiche les jeux sous forme de roue/liste.
		     Chaque jeu est représenté par un "item" dont le rendu
		     est défini dans <itemTemplate>.
		     ═══════════════════════════════════════════════════════════ -->
		<gamecarousel name="gamecarousel">
			<zIndex>800</zIndex>
			<!-- type="vertical" : défilement vertical (haut/bas).
			     Autres valeurs possibles : horizontal, wheel, etc. -->
			<type>vertical</type>
			<!-- pos et size très larges : le carrousel occupe presque tout l'écran
			     mais ses items sont repositionnés individuellement dans itemTemplate. -->
			<pos>-0.07 0.133</pos>
			<size>2 0.621</size>
			<!-- logoScale : facteur de zoom sur le logo de l'item sélectionné -->
			<logoScale>1</logoScale>
			<logoSize>0.1 0.1</logoSize>
			<!-- color transparent : pas de fond coloré sur le carrousel lui-même -->
			<color>00000000</color>
			<logoAlignment>bottom</logoAlignment>
			<!-- minLogoOpacity=1 : les items non-sélectionnés restent opaques (pas d'estompage) -->
			<minLogoOpacity>1</minLogoOpacity>
			<!-- transitionSpeed : durée en ms du défilement entre deux jeux -->
			<transitionSpeed>800</transitionSpeed>
			<logoPos>0.15 0.25</logoPos>
			<!-- imageSource="thumbnail" : utilise la vignette comme image des items -->
			<imageSource>thumbnail</imageSource>
			<!-- defaultTransition="instant" : pas d'animation lors du premier affichage -->
			<defaultTransition>instant</defaultTransition>
			<!-- maxLogoCount=3 : affiche 3 items visibles simultanément dans le carrousel -->
			<maxLogoCount>3</maxLogoCount>
			<scaledLogoSpacing>0</scaledLogoSpacing>
			<!-- ── itemTemplate ──────────────────────────────────────
			     Définit le rendu de CHAQUE CASE du carrousel.
			     Tout ce qui est ici se répète pour chaque jeu affiché.
			     Les éléments réagissent aux événements :
			       activate   = quand ce jeu devient sélectionné
			       deactivate = quand on passe à un autre jeu
			       scroll     = pendant le défilement rapide
			     ─────────────────────────────────────────────────── -->
			<itemTemplate>
				<container>
					<!-- ── VIGNETTE / POCHETTE du jeu ────────────────────── -->
					<!-- Affiche {game:image} par défaut. -->
					<!-- ifSubset="starthumb:starbox3d" : si l'option "starbox3d" -->
					<!-- est activée dans les réglages du thème, utilise l'art 3D -->
					<!-- en priorité. Même logique pour "starbox2d". -->
					<!-- pos très à droite (x=2.81) : les vignettes sont positionnées -->
					<!-- hors écran par défaut ; c'est le carrousel qui les replace. -->
					<image name="thumbnail">
						<pos>2.81 0.51</pos>
						<origin>0.5 0</origin>
						<rotation>0</rotation>
						<maxSize>1 1</maxSize>
						<!-- Chemin par défaut : image principale du jeu -->
						<path>{game:image}</path>
						<!-- Variante 3D (boîte 3D) si l'option est activée -->
						<path ifSubset="starthumb:starbox3d">firstfile(${core3dart},{game:boxart})</path>
						<!-- Variante 2D (couverture frontale) si l'option est activée -->
						<path ifSubset="starthumb:starbox2d">firstfile(${corefrontart},{game:thumbnail})</path>
						<zIndex>800</zIndex>
						<!-- À l'activation (jeu sélectionné) : apparition en fondu + légère remontée -->
						<storyboard event="activate">
							<animation property="opacity" to="1" begin="" duration="250" mode="Linear"/>
							<animation property="offsetY" to="-0.006" begin="" duration="" mode="easeIn"/>
						</storyboard>
						<!-- À la désactivation : légère redescente, puis désaturation et assombrissement -->
						<storyboard event="deactivate">
							<!-- <animation property="opacity" to="0.18" begin="2000" duration="1000" mode="Linear"/> -->
							<animation property="offsetY" to="0" begin="" duration="" mode="easeIn"/>
							<animation property="saturation" to="0.3" begin="2000" duration="2000" mode="Linear"/>
							<animation property="color" to="555555" begin="2000" duration="2000" mode="Linear"/>
						</storyboard>
						<!-- <storyboard event="scroll"> -->
						<!-- <animation property="y" to="0.6" begin="" duration="" mode="Linear"/> -->
						<!-- </storyboard> -->
						<!-- Shader de bordure arrondie (commenté = désactivé).
						     Pour l'activer, décommentez et ajustez cornerRadius, borderSize, etc. -->
						<!-- <shader> -->
						<!-- <path>:/shaders/border.glsl</path> -->
						<!-- <cornerRadius>0.03</cornerRadius> -->
						<!-- <borderSize>0</borderSize> -->
						<!-- <borderColor>00000080</borderColor> -->
						<!-- <innerShadowSize>0.02</innerShadowSize> -->
						<!-- <innerShadowColor>00000070</innerShadowColor> -->
						<!-- <outerShadowSize>0.02</outerShadowSize> -->
						<!-- <outerShadowColor>00000080</outerShadowColor> -->
						<!-- </shader> -->
					</image>
					<!-- ── MARQUEE (bandeau titre/logo du jeu) ──────────────
					     Affiché en grand à droite lors de la sélection.
					     Les animations jouent un effet d'entrée/sortie par glissement horizontal.
					     offsetX décale horizontalement sans changer la position de base. -->
					<image name="marquee">
						<pos>5.3 1</pos>
						<origin>0.5 0.5</origin>
						<rotation>0</rotation>
						<maxSize>1.7 2</maxSize>
						<path>{game:marquee}</path>
						<!-- Activation : le marquee glisse de droite vers sa position finale -->
						<storyboard event="activate">
							<animation property="offsetX" to="-0.2" begin="" duration="0" mode="Linear"/>
							<animation property="opacity" to="0" begin="0" duration="0" mode="Linear"/>
							<animation property="offsetX" to="-0.55" begin="800" duration="850" mode="easeOut"/>
							<animation property="opacity" to="1" begin="1050" duration="0" mode="Linear"/>
							<animation property="offsetX" to="-0.5" begin="1650" duration="550" mode="easeIn"/>
						</storyboard>
						<!-- Désactivation : le marquee repart vers la droite -->
						<storyboard event="deactivate">
							<animation property="offsetX" to="-0.18" begin="" duration="0" mode="Linear"/>
							<animation property="opacity" to="0" begin="0" duration="0" mode="Linear"/>
							<animation property="offsetX" to="0.05" begin="800" duration="850" mode="easeOut"/>
							<animation property="opacity" to="1" begin="1050" duration="0" mode="Linear"/>
							<animation property="offsetX" to="0" begin="1650" duration="550" mode="easeIn"/>
							<!-- <animation property="offsetX" to="0" begin="" duration="0" mode="Linear"/> -->
						</storyboard>
						<!-- <storyboard event="open"> -->
						<!-- <animation property="rotation" to="-3" begin="" duration="350" mode="Linear"/> -->
						<!-- </storyboard> -->
						<!-- Scroll : même effet que désactivation, pour le défilement rapide -->
						<storyboard event="scroll">
							<animation property="offsetX" to="-0.18" begin="" duration="0" mode="Linear"/>
							<animation property="opacity" to="0" begin="0" duration="0" mode="Linear"/>
							<animation property="offsetX" to="0.05" begin="800" duration="850" mode="easeOut"/>
							<animation property="opacity" to="1" begin="1050" duration="0" mode="Linear"/>
							<animation property="offsetX" to="0" begin="1650" duration="550" mode="easeIn"/>
						</storyboard>
					</image>
					<!-- ── NOM DU JEU (texte de secours) ─────────────────────
					     Affiché UNIQUEMENT si ni marquee ni pochette n'existent
					     pour ce jeu. Les conditions ifSubset vérifient l'option
					     de vignette active.
					     storyboard ifSubset="starboxang:active/deactive" : applique
					     des animations différentes selon l'option d'angle de boîte. -->
					<text name="gamename">
						<visible ifSubset="starthumb:starbox3d">!exists({game:marquee}) &amp;&amp; !exists({game:boxart}) &amp;&amp; !exists(${core3dart})</visible>
						<visible ifSubset="starthumb:starbox2d">!exists({game:marquee}) &amp;&amp; !exists({game:thumbnail}) &amp;&amp; !exists(${corefrontart})</visible>
						<origin>0.5</origin>
						<text>{game:name}</text>
						<fontPath>${fontimpact}</fontPath>
						<color>FFFFFF</color>
						<alignment>center</alignment>
						<fontSize>0.025</fontSize>
						<lineSpacing>1</lineSpacing>
						<size>0.3 2</size>
						<pos>0.5 0.8</pos>
						<glowColor>00000066</glowColor>
						<glowSize>2</glowSize>
						<zIndex>400</zIndex>
						<storyboard ifSubset="starboxang:deactive" event="activate">
							<animation property="y" to="0.65" begin="250" duration="350" mode="easeIn"/>
						</storyboard>
						<storyboard ifSubset="starboxang:deactive" event="deactivate">
							<animation property="y" to="0.6" begin="" duration="" mode="Linear"/>
						</storyboard>
						<storyboard ifSubset="starboxang:active" event="open">
							<animation property="rotation" to="-3" begin="" duration="350" mode="Linear"/>
						</storyboard>
						<storyboard ifSubset="starboxang:active" event="activate">
							<animation property="rotation" to="-3" begin="" duration="350" mode="Linear"/>
							<animation property="y" to="0.65" begin="250" duration="350" mode="easeIn"/>
						</storyboard>
						<storyboard ifSubset="starboxang:active" event="deactivate">
							<animation property="rotation" to="0" begin="" duration="150" mode="Linear"/>
							<animation property="y" to="0.6" begin="" duration="" mode="Linear"/>
						</storyboard>
						<storyboard event="scroll">
							<animation property="y" to="0.6" begin="" duration="" mode="Linear"/>
						</storyboard>
					</text>
				</container>
			</itemTemplate>
		</gamecarousel>
		<!-- Lissage activé sur le logo du carrousel hérité -->
		<image name="gamecarouselLogo">
			<linearSmooth>true</linearSmooth>
		</image>
		<!-- ═══════════════════════════════════════════════════════════
		     ICÔNES DE GENRE
		     ═══════════════════════════════════════════════════════════
		     Chaque <image> ci-dessous affiche une icône de genre UNIQUEMENT
		     si le genre du jeu sélectionné correspond (via contains()).
		     contains(lower({game:genre}),"mot") : cherche "mot" dans le
		     genre du jeu (en minuscules pour éviter les problèmes de casse).
		     Toutes ces images sont ensuite regroupées dans un <control>
		     qui leur applique position, taille et animations communes.
		     ═══════════════════════════════════════════════════════════ -->
		<!-- Deuxième occurrence de genre_plateforme (peut coexister avec la première) -->
		<image name="genre_plateforme" extra="true">
			<visible>contains(lower({game:genre}),"platefor")</visible>
			<path>${path_vgame}/retrower/genres/genre_plateforme.png</path>
		</image>
		<!-- Icône Action (utilise genre_arcade.png) -->
		<image name="genre_action" extra="true">
			<visible>contains(lower({game:genre}),"action")</visible>
			<path>${path_vgame}/retrower/genres/genre_arcade.png</path>
		</image>
		<image name="genre_tir" extra="true">
			<visible>contains(lower({game:genre}),"tir")</visible>
			<path>${path_vgame}/retrower/genres/genre_fps_scifi.png</path>
		</image>
		<!-- Icône Shoot'em up / Science-fiction -->
		<image name="genre_shmup_scifi" extra="true">
			<visible>contains(lower({game:genre}),"shoot'em")</visible>
			<path>${path_vgame}/retrower/genres/genre_shmup_scifi.png</path>
		</image>
		<!-- Icône Plateforme (première occurrence, utilisée dans le control du bas) -->
		<image name="genre_plateforme" extra="true">
			<visible>contains(lower({game:genre}),"platefor")</visible>
			<path>${path_vgame}/retrower/genres/genre_plateforme.png</path>
		</image>
		<!-- Icône Aventure (variante pour le mot "avent") -->
		<image name="genre_adventure2" extra="true">
			<visible>contains(lower({game:genre}),"avent")</visible>
			<path>${path_vgame}/retrower/genres/genre_adventure.png</path>
		</image>
				<!-- Icône Aventure / Rôle -->
		<image name="genre_adventure" extra="true">
			<visible>contains(lower({game:genre}),"rôle")</visible>
			<path>${path_vgame}/retrower/genres/genre_rpgfantasy.png</path>
		</image>
		<!-- Icône Beat'em up -->
		<image name="genre_beatemup" extra="true">
			<visible>contains(lower({game:genre}),"beat")</visible>
			<path>${path_vgame}/retrower/genres/genre_beatemup.png</path>
		</image>
		<!-- Icône Course / Racing -->
		<image name="genre_racing" extra="true">
			<visible>contains(lower({game:genre}),"course")</visible>
			<path>${path_vgame}/retrower/genres/genre_racing.png</path>
		</image>
		<!-- Icône Sport -->
		<image name="genre_sports" extra="true">
			<visible>contains(lower({game:genre}),"sport")</visible>
			<path>${path_vgame}/retrower/genres/genre_sports.png</path>
		</image>
		<!-- Icône Combat / Fighting -->
		<image name="genre_fighting" extra="true">
			<visible>contains(lower({game:genre}),"combat")</visible>
			<path>${path_vgame}/retrower/genres/genre_fighting.png</path>
		</image>
		<!-- Icône RPG / Fantasy -->
		<image name="genre_simulation" extra="true">
			<visible>contains(lower({game:genre}),"rpg")</visible>
			<path>${path_vgame}/retrower/genres/genre_rpgfantasy.png</path>
		</image>
		<!-- Icône Puzzle (image dédiée cette fois) -->
		<image name="genre_puzzle" extra="true">
			<visible>contains(lower({game:genre}),"puzzle")</visible>
			<path>${path_vgame}/retrower/genres/genre_puzzle.png</path>
		</image>
		<image name="genre_simulation" extra="true">
			<visible>contains(lower({game:genre}),"simu")</visible>
			<path>${path_vgame}/retrower/genres/genre_simulation.png</path>
		</image>
		<image name="genre_avion" extra="true">
			<visible>contains(lower({game:genre}),"avion")</visible>
			<path>${path_vgame}/retrower/genres/genre_shmup_history.png</path>
		</image>
		<image name="genre_casual" extra="true">
			<visible>contains(lower({game:genre}),"casual")</visible>
			<path>${path_vgame}/retrower/genres/genre_puzzle.png</path>
		</image>
		<image name="genre_strategy" extra="true">
			<visible>contains(lower({game:genre}),"strat")</visible>
			<path>${path_vgame}/retrower/genres/genre_strategy.png</path>
		</image>
		<image name="genre_pinball" extra="true">
			<visible>contains(lower({game:genre}),"flipper")</visible>
			<path>${path_vgame}/retrower/genres/genre_pinball.png</path>
		</image>
		<image name="genre_horror" extra="true">
			<visible>contains(lower({game:genre}),"horr")</visible>
			<path>${path_vgame}/retrower/genres/genre_horror.png</path>
		</image>
		<image name="genre_fps" extra="true">
			<visible>contains(lower({game:genre}),"first")</visible>
			<path>${path_vgame}/retrower/genres/genre_fps.png</path>
		</image>
		<image name="genre_fps2" extra="true">
			<visible>contains(lower({game:genre}),"1ere")</visible>
			<path>${path_vgame}/retrower/genres/genre_fps.png</path>
		</image>
		<!-- ── Paramètres communs à toutes les icônes de genre ────────
		     Ce <control> applique d'un coup position, taille, zIndex et
		     animations identiques à toutes les icônes listées dans name="...".
		     Animation : invisible à la sélection, puis fondu vers opaque après 1650ms. -->
		<control name="
		genre_shmup_scifi, 
		genre_plateforme, 
		genre_adventure, 
		genre_adventure2, 
		genre_beatemup, 
		genre_racing, 
		genre_sports, 
		genre_fighting, 
		genre_arcade, 
		genre_action,
		genre_simulation,
		genre_avion,
		genre_puzzle,
		genre_casual,
		genre_strategy,
		genre_pinball,
		genre_horror,
		genre_fps,
		genre_fps2,
		genre_tir">
			<origin>0.5 0.5</origin>
			<!-- Zone d'affichage de l'icône de genre : centre-gauche de l'écran -->
