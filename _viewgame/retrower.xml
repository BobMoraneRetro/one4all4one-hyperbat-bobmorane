			<text>{game:players} ${player}</text>
			<color>FFFFFF</color>
			<origin>0.5 0.5</origin>
			<pos>0.771 0.737</pos>
			<size>0.08 0.035</size>
			<fontPath>${path_vgame}/retrower/fonts/Roboto-Bold.ttf</fontPath>
			<alignment>center</alignment>
			<fontSize>0.020</fontSize>
			<zIndex>360</zIndex>
		</text>
		<!-- Cas : aucune donnée joueurs -->
		<text name="binds_noplayers" extra="true">
			<visible>{game:players} &gt; 0 ? 0 : 1</visible>
			<text>${noplayerdata}</text>
			<color>FFFFFF</color>
			<origin>0.5 0.5</origin>
			<pos>0.771 0.737</pos>
			<size>0.08 0.035</size>
			<fontPath>${path_vgame}/retrower/fonts/Roboto-Bold.ttf</fontPath>
			<alignment>center</alignment>
			<fontSize>0.020</fontSize>
			<zIndex>360</zIndex>
		</text>
		<!-- ── NOMBRE DE PARTIES JOUÉES ──────────────────────────────
		     Même logique que les joueurs, avec trois cas :
		     • binds_playcount_one : exactement 1 partie jouée
		     • binds_playcount     : 2 parties ou plus
		     • binds_noplaycount   : jamais joué (0)
		     ${playcountone}, ${playcount}, ${nogametime} = textes traduits
		     définis dans les variables du thème principal. -->
		<!-- Nombre de parties jouées dynamique dans le bloc bleu. -->
		<!-- Cas : 1 partie jouée -->
		<text name="binds_playcount_one" extra="true">
			<visible>{game:playcount} == 1 ? 1 : 0</visible>
			<color>FFFFFF</color>
			<text>{game:playcount} ${playcountone}</text>
			<origin>0.5 0.5</origin>
			<pos>0.863 0.737</pos>
			<size>0.08 0.035</size>
			<fontPath>${path_vgame}/retrower/fonts/Roboto-Bold.ttf</fontPath>
			<alignment>center</alignment>
			<fontSize>0.020</fontSize>
			<zIndex>360</zIndex>
		</text>
		<!-- Cas : plusieurs parties jouées -->
		<text name="binds_playcount" extra="true">
			<visible>{game:playcount} &gt; 1 ? 1 : 0</visible>
			<color>FFFFFF</color>
			<text>{game:playcount} ${playcount}</text>
			<origin>0.5 0.5</origin>
			<pos>0.863 0.737</pos>
			<size>0.08 0.035</size>
			<fontPath>${path_vgame}/retrower/fonts/Roboto-Bold.ttf</fontPath>
			<alignment>center</alignment>
			<fontSize>0.020</fontSize>
			<zIndex>360</zIndex>
		</text>
		<!-- Cas : jamais joué -->
		<text name="binds_noplaycount" extra="true">
			<visible>{game:playcount} &gt; 0 ? 0 : 1</visible>
			<color>FFFFFF</color>
			<text>${nogametime}</text>
			<origin>0.5 0.5</origin>
			<pos>0.863 0.737</pos>
			<size>0.08 0.035</size>
			<fontPath>${path_vgame}/retrower/fonts/Roboto-Bold.ttf</fontPath>
			<alignment>center</alignment>
			<fontSize>0.020</fontSize>
			<zIndex>360</zIndex>
		</text>
		<!-- ── EFFETS DE NUIT (vignettage haut et bas du panneau gauche) ──
		     Deux images semi-transparentes qui créent un assombrissement
		     progressif en haut et en bas du panneau des vignettes.
		     Animation : apparaissent progressivement après 2s à l'activation,
		     disparaissent instantanément à la désactivation.
		     opacity=0.72 : partiellement transparentes pour un effet doux. -->
		<image name="_top_night" extra="true">
			<path>${path_vgame}/retrower/_top_night.png</path>
			<origin>0.5 0.5</origin>
			<!-- <pos>0.3618 0.2535</pos> -->
			<pos>0.3618 0.2595</pos>
			<size>0.339062500000 0.209259259259</size>
			<zIndex>400</zIndex>
			<scaleOrigin>-0.3 -0.3</scaleOrigin>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<linearSmooth>true</linearSmooth>
			<!-- Apparition progressive après 2s -->
			<storyboard event="activate">
				<animation property="opacity" to="0" begin="" duration="0" mode="Linear"/>
				<animation property="opacity" to="0.72" begin="2000" duration="2000" mode="easeOut"/>
			</storyboard>
			<!-- Disparition instantanée lors du changement de jeu -->
			<storyboard event="deactivate">
				<animation property="opacity" to="0" begin="" duration="0" mode="Linear"/>
			</storyboard>
		</image>
		<image name="_bottom_night" extra="true">
			<path>${path_vgame}/retrower/_bottom_night.png</path>
			<origin>0.5 0.5</origin>
			<!-- <pos>0.3618 0.707</pos> -->
			<pos>0.3618 0.7045</pos>
			<size>0.339062500000 0.209259259259</size>
			<zIndex>390</zIndex>
			<scaleOrigin>-0.3 -0.3</scaleOrigin>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<linearSmooth>true</linearSmooth>
			<storyboard event="activate">
				<animation property="opacity" to="0" begin="" duration="0" mode="Linear"/>
				<animation property="opacity" to="0.72" begin="2000" duration="2000" mode="easeOut"/>
			</storyboard>
			<storyboard event="deactivate">
				<animation property="opacity" to="0" begin="" duration="0" mode="Linear"/>
			</storyboard>
		</image>
		<!-- ── CHEVALET (support de présentation des vignettes) ───────
		     Petit élément graphique très fin (5% x 0.6%) centré sur les vignettes.
		     zIndex=1400 : tout au premier plan, par-dessus tout le reste. -->
		<image name="chevalet" extra="true">
			<path>${path_vgame}/retrower/chevalet.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.36 0.531427731203</pos>
			<!-- Taille très petite : cet élément est un détail fin de présentation -->
			<size>0.049518308710 0.006555615337</size>
			<zIndex>1400</zIndex>
			<scaleOrigin>-0.3 -0.3</scaleOrigin>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<linearSmooth>true</linearSmooth>
		</image>
		<!-- ── ÉLÉMENTS STANDARDS CACHÉS ─────────────────────────────
		     Ces éléments existent dans gamecarousel mais sont masqués
		     car ce thème gère ses propres images à leur place. -->
		<!-- Cartouche du jeu (métadonnée) — cachée -->
		<image name="md_cartridge" extra="true">
			<visible>false</visible>
			<zIndex>380</zIndex>
		</image>
		<!-- Boîte/pochette du jeu (métadonnée) — cachée -->
		<image name="md_boxart" extra="true">
			<visible>false</visible>
			<zIndex>380</zIndex>
		</image>
		<!-- ── ANCIEN BLOC D'ANIMATIONS DE TRANSITION (désactivé) ────
		     Ce <control> gérait des animations zoom+fondu sur les calques
		     lors des transitions entre jeux. Il a été remplacé par les
		     storyboards individuels sur chaque élément.
		     Conservé en commentaire comme référence. -->
