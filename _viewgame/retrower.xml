		<!-- ═══════════════════════════════════════════════════════════
		     SYSTÈME DE NOTATION PAR ÉTOILES
		     ═══════════════════════════════════════════════════════════
		     Deux couches :
		     1. blank_rating : 5 icônes grises (fond vide) toujours visibles
		     2. rating_filled_X : icônes colorées en or, visibles selon la note

		     {game:rating} retourne une valeur comme "0.200000", "0.400000", etc.
		     Chaque text ne s'affiche QUE si la valeur correspond exactement.
		     La police FontAwesome est utilisée pour les icônes (caractères Unicode).
		     ${gamerating} = l'icône choisie dans les variables (étoile par défaut).

		     Valeurs de {game:rating} :
		       0.20000 = 1 étoile
		       0.40000 = 2 étoiles
		       0.60000 = 3 étoiles
		       0.80000 = 4 étoiles
		       1.00000 = 5 étoiles
		     ═══════════════════════════════════════════════════════════ -->
		<!-- Versions commentées avec texte statique (non utilisées ici) :
		     les étoiles étaient affichées via {game:stars} mais ce champ
		     n'est pas standard. La solution ci-dessous via rating_filled_X est plus robuste. -->
		<!-- <text name="rating_stars_shadow" extra="true"> -->
		<!-- <text>{game:stars}</text> -->
		<!-- <origin>0.5 0.5</origin> -->
		<!-- <pos>0.827 0.802</pos> -->
		<!-- <size>0.17 0.05</size> -->
		<!-- <alignment>center</alignment> -->
