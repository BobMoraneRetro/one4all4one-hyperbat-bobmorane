		<text name="bobmediapath" extra="true" zIndex="5000" fontPath="${path_vgame}/mediatester/TmonMonsori.ttf" fontSize="0.012" size="1 1" alignment="left" verticalAlignment="top" pos="0.37 0.86" color="ffd13b" glowColor="000000" glowOffset="0" glowSize="4">
