			<maxSize>0.1 0.1</maxSize>
			<zIndex>280</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="md_cartridge" extra="true">
			<visible>false</visible>
			<zIndex>290</zIndex>
		</image>
		<image name="md_boxart" extra="true">
			<visible>false</visible>
			<zIndex>290</zIndex>
		</image>
		<text name="consolesys" extra="true" zIndex="5000" fontPath="${path_vgame}/mediatester/TmonMonsori.ttf" fontSize="0.012" size="1 1" alignment="left" verticalAlignment="top" pos="0.48 0.575" color="ffd13b" glowColor="000000" glowOffset="0" glowSize="4">
			<text>
