				<!-- <borderColorEnd>000000</borderColorEnd> -->
			</shader>
		</image>
		<image name="screenshotgames_fond" ifSubset="starvideo:starvideoang" extra="true">
			<path>${path_vgame}/fanartstar/fiber.png</path>
			<pos>0.995 0.35</pos>
			<size>0.38 0.472</size>
			<origin>1 0.5</origin>
			<effect>none</effect>
			<zIndex>55</zIndex>
			<scaleOrigin>0.15 0.15</scaleOrigin>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
			<shader>
				<path>${path_com_shaders}/Angled_border_gradient.glsl</path>
				<tiltAngle>0</tiltAngle>
				<tiltAngleX>30</tiltAngleX>
				<perspectiveDepth>0.8</perspectiveDepth>
			</shader>
		</image>
		<video name="videogameplay" ifSubset="starvideo:starvideoang" extra="true">
			<path>firstfile(${extgamevideoavi},${extgamevideomp4},{game:video})</path>
			<delay>0.3</delay>
			<pos>0.995 0.35</pos>
			<size>0.38 0.47</size>
			<origin>1 0.5</origin>
			<effect>none</effect>
			<zIndex>80</zIndex>
			<shader>
				<path>${path_com_shaders}/Angled_border_gradient.glsl</path>
				<tiltAngle>0</tiltAngle>
				<tiltAngleX>30</tiltAngleX>
				<perspectiveDepth>0.8</perspectiveDepth>
			</shader>
		</video>
		<control name="screenshotgames,screenshotgames_cadre,screenshotgames_fond,videogameplay" ifSubset="starvideo:starvideoang">
			<offsetX>0.038</offsetX>
		</control>
		<!-- ### FIN Screens et gameplay video ################################################################################################# -->
		<!-- ############################ Début Meta DATA ######################################################################################################################### -->
		<image name="marqueetitre" extra="true">
			<autoFade>false</autoFade>
