			<size>0.15 1</size>
			<pos>0.855 0</pos>
			<blur>10</blur>
			<zIndex>3</zIndex>
			<!-- <blurColor>000000</blurColor> -->
		</screenshader>
		<screenshader name="blurright1" extra="true">
			<visible ifSubset="custombuilds:standardbuilds">${standardsbuildsfanarttestyes}</visible>
			<visible ifSubset="custombuilds:retrofreshbat">${freshbuildfanarttestyes}</visible>
			<visible ifSubset="custombuilds:coretyperfanart">${corefanarttestyes}</visible>
			<path>:/shaders/blur.glsl</path>
			<size>0.18 1</size>
			<pos>0.853 0</pos>
			<blur>8</blur>
			<zIndex>4</zIndex>
			<blurColor>000000</blurColor>
		</screenshader>
		<screenshader name="blurright" extra="true">
			<visible ifSubset="custombuilds:standardbuilds">${standardsbuildsfanarttestyes}</visible>
			<visible ifSubset="custombuilds:retrofreshbat">${freshbuildfanarttestyes}</visible>
			<visible ifSubset="custombuilds:coretyperfanart">${corefanarttestyes}</visible>
			<path>:/shaders/blur.glsl</path>
			<size>0.2 1</size>
			<pos>0.85 0</pos>
			<blur>6</blur>
			<zIndex>5</zIndex>
			<blurColor>000000</blurColor>
		</screenshader>
		<screenshader name="blurbottom2" static="true">
			<visible ifSubset="custombuilds:standardbuilds">${standardsbuildsfanarttestyes}</visible>
			<visible ifSubset="custombuilds:retrofreshbat">${freshbuildfanarttestyes}</visible>
			<visible ifSubset="custombuilds:coretyperfanart">${corefanarttestyes}</visible>
			<path>:/shaders/blur.glsl</path>
			<size>1 0.3</size>
			<pos>0 0.695</pos>
			<blur>10</blur>
			<zIndex>3</zIndex>
			<blurColor>000000</blurColor>
		</screenshader>
		<!-- ############################# Overlays ############################################################################################################# -->
		<image name="overlayvignettage" extra="true">
			<path>${path_vgame}/fanartstar/overlay.png</path>
			<size>1 1</size>
			<flipX>true</flipX>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<zIndex>30</zIndex>
		</image>
		<image name="overlayastro" extra="true">
			<path>${path_vgame}/fanartstar/overlayAstro.png</path>
			<size>1 1</size>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<zIndex>9</zIndex>
			<opacity>0.8</opacity>
		</image>
		<!-- ############################# Graphismes et Metadata ################################ -->
		<!-- Logo systeme en fonction de la region du jeu -->
		
		<image name="logosytemgamelistshadow" extra="true">
			<origin>0.5 0.5</origin>
			<pos>0.94 0.045</pos>
			<path>firstfile("${path_syst_logo}/clearlogos/"  + ({game:system:theme}) + "-" + {game:region} + ".png",
			"${path_syst_logo}/clearlogos/"  + ({game:system:theme}) + ".png")</path>
			<maxSize>0.1 0.1</maxSize>
			<linearSmooth>true</linearSmooth>
			<horizontalAlignment>left</horizontalAlignment>
			<color>000000</color>
			<zIndex>80</zIndex>
		</image>
		<image name="logosytemgamelist" extra="true">
			<origin>0.5 0.5</origin>
			<pos>0.94 0.045</pos>
			<path>firstfile("${path_syst_logo}/clearlogos/"  + ({game:system:theme}) + "-" + {game:region} + ".png",
			"${path_syst_logo}/clearlogos/"  + ({game:system:theme}) + ".png")</path>
			<maxSize>0.1 0.1</maxSize>
			<linearSmooth>true</linearSmooth>
			<horizontalAlignment>left</horizontalAlignment>
			<zIndex>80</zIndex>
		</image>
		<!-- ### Screens et gameplay video classique grands ou petit ################################################################################################# -->
		<image name="screenshotgames" ifSubset="starvideo:starvideobig|starvideodef" extra="true">
			<path>firstfile(${extgamescreenjpg},{game:image})</path>
			<pos>0.98 0.375</pos>
			<maxSize ifSubset="starvideo:starvideobig">0.4 0.54</maxSize>
			<maxSize ifSubset="starvideo:starvideodef">0.3 0.54</maxSize>
			<origin>1 0.5</origin>
			<zIndex>79</zIndex>
			<scaleOrigin>0.15 0.15</scaleOrigin>
			<autoFade>false</autoFade>
			<shader>
				<path>:/shaders/border.glsl</path>
				<cornerRadius>0</cornerRadius>
				<borderSize>0.01</borderSize>
				<borderColor>000000</borderColor>
				<innerShadowSize>0.05</innerShadowSize>
				<innerShadowColor>00000010</innerShadowColor>
				<outerShadowSize>0.02</outerShadowSize>
				<outerShadowColor>00000090</outerShadowColor>
			</shader>
			<storyboard event="open">
				<animation property="opacity" to="1" duration="20" mode="easeIn"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="1" duration="0" mode="linear"/>
				<animation enabled="exists({game:video})" property="opacity" from="1" to="0" begin="500" duration="300" mode="easeIn"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="1" duration="0" mode="linear"/>
				<animation enabled="exists({game:video})" property="opacity" from="1" to="0" begin="500" duration="300" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" begin="50" duration="0" mode="linear"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" begin="50" duration="0" mode="linear"/>
			</storyboard>
		</image>
		<video name="videogameplay" ifSubset="starvideo:starvideobig|starvideodef" extra="true">
			<path>firstfile(${extgamevideoavi},${extgamevideomp4},{game:video})</path>
			<delay>0.3</delay>
			<pos>0.98 0.375</pos>
			<maxSize ifSubset="starvideo:starvideobig">0.4 0.54</maxSize>
			<maxSize ifSubset="starvideo:starvideodef">0.3 0.54</maxSize>
			<origin>1 0.5</origin>
			<effect>none</effect>
			<zIndex>80</zIndex>
			<shader>
				<path>:/shaders/border.glsl</path>
				<cornerRadius>0</cornerRadius>
				<borderSize>0.01</borderSize>
				<borderColor>000000</borderColor>
				<innerShadowSize>0.05</innerShadowSize>
				<innerShadowColor>00000010</innerShadowColor>
				<outerShadowSize>0.02</outerShadowSize>
				<outerShadowColor>00000090</outerShadowColor>
			</shader>
		</video>
		<!-- ### FIN Screens et gameplay video ################################################################################################# -->
		<!-- ### Screens et gameplay video angle de 30 degrés ################################################################################################# -->
		<image name="screenshotgames" ifSubset="starvideo:starvideoang" extra="true">
			<path>firstfile(${extgamescreenjpg},{game:image})</path>
			<pos>0.995 0.35</pos>
			<size>0.38 0.47</size>
			<origin>1 0.5</origin>
			<zIndex>79</zIndex>
			<scaleOrigin>0.15 0.15</scaleOrigin>
			<autoFade>false</autoFade>
			<shader>
				<path>${path_com_shaders}/Angled_border_gradient.glsl</path>
				<tiltAngle>0</tiltAngle>
				<tiltAngleX>30</tiltAngleX>
				<perspectiveDepth>0.8</perspectiveDepth>
			</shader>
			<storyboard event="open">
				<animation property="opacity" to="1" duration="20" mode="easeIn"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="1" duration="0" mode="linear"/>
				<animation enabled="exists({game:video})" property="opacity" from="1" to="0" begin="500" duration="300" mode="easeIn"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="1" duration="0" mode="linear"/>
				<animation enabled="exists({game:video})" property="opacity" from="1" to="0" begin="500" duration="300" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" begin="50" duration="0" mode="linear"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" begin="50" duration="0" mode="linear"/>
			</storyboard>
		</image>
		<image name="screenshotgames_cadre" ifSubset="starvideo:starvideoang" extra="true">
			<path>${path_vgame}/fanartstar/169alt1.png</path>
			<pos>0.995 0.35</pos>
			<pos>1 0.35</pos>
			<size>0.38 0.488</size>
			<size>0.39 0.505</size>
			<origin>1 0.5</origin>
			<effect>none</effect>
			<zIndex>89</zIndex>
			<scaleOrigin>0.15 0.15</scaleOrigin>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
			<shader>
				<path>${path_com_shaders}/Angled_border_gradient.glsl</path>
				<tiltAngle>0</tiltAngle>
