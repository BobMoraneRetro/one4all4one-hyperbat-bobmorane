		<image name="OpenBOR_Sys" extra="true">
			<path>./OpenBOR.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.500000000000 0.500000000000</pos>
			<size>1.000000000000 1.000000000000</size>
			<zIndex>2</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="solarus_Sys" extra="true">
			<path>./solarus.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.724479166667 0.142129629630</pos>
			<size>0.528125000000 0.249074074074</size>
			<zIndex>3</zIndex>
			<linearSmooth>true</linearSmooth>
			<storyboard>
				<!-- # Bump Arrival # -->
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1250" duration="500" mode="Linear"/>
				<animation property="scale" from="0" to="1" begin="1250" duration="500" mode="bump"/>
				<animation property="scale" from="1" to="1.1" begin="1750" duration="120" autoreverse="true" mode="EasyOutCubic"/>
				<animation property="scale" from="1" to="1.05" begin="1870" duration="120" autoreverse="true" mode="EasyOutCubic"/>
			</storyboard>
		</image>
		<image name="ZELDA_Sys" extra="true">
			<path>./ZELDA.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.263608530773 0.570192667415</pos>
			<size>0.464938021141 0.838103254770</size>
			<zIndex>4</zIndex>
			<linearSmooth>true</linearSmooth>
			<storyboard>
				<!-- # Arrival Left to Right # -->
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="650" duration="2500" mode="Linear"/>
				<animation property="offsetX" from="-1" to="0" begin="650" duration="2500" mode="Linear"/>
			</storyboard>
			<storyboard>
				<!-- # Arrival L→R + Float L→R # -->
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="250" duration="500" mode="Linear"/>
				<animation property="offsetX" from="-1.9" to="0" begin="0" duration="1500" mode="linear"/>
				<animation property="offsetX" from="0" to="0.06" begin="1000" duration="4000" autoreverse="true" repeat="forever" mode="linear"/>
			</storyboard>
		</image>
