<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- Planches explicatives (subset lismoiv2 de theme.xml ; renommer pour refaire apparaitre les planches apres une mise a jour). Langue fr : planches/fr/ ; toutes les autres : planches/en/. -->
	<!-- La 1re ligne <path> pose la version anglaise ; la 2e la remplace par planches/${lang}/ si ce fichier existe
	     (fichier absent : ES garde la valeur précédente). -->
	<view name="system">
		<image name="splashounet" extra="true">
			<path ifSubset="lismoiv2:planche00">${path_vsystopt}/sl-commun/planches/en/00.png</path>
			<path ifSubset="lismoiv2:planche00">${path_vsystopt}/sl-commun/planches/${lang}/00.png</path>
			<path ifSubset="lismoiv2:planche01">${path_vsystopt}/sl-commun/planches/en/01.png</path>
