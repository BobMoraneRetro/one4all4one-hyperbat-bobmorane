<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- <include>${extGametheme.defaut}</include> -->
	<customView name="hyperbat" displayName="${viewchoice.hyperbat}" inherits="gamecarousel">
		<gamecarousel name="gamecarousel">
			<type>vertical</type>
			<pos>0.450 0</pos>
			<logoScale>1</logoScale>
			<logoRotation>-4</logoRotation>
			<logoRotationOrigin>6 0</logoRotationOrigin>
			<logoSize>0.18 0.20</logoSize>
			<logoAlignment>center</logoAlignment>
			<minLogoOpacity>0.4</minLogoOpacity>
			<transitionSpeed>450</transitionSpeed>
		</gamecarousel>
	</customView>
</theme>
