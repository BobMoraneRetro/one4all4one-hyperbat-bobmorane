<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<customView name="hyperbat" inherits="gamecarousel">
		<gamecarousel name="gamecarousel">
			<itemTemplate>
				<container>
					<image name="fondwheel">
						<pos>0.5</pos>
						<origin>0.5</origin>
						<maxSize>1</maxSize>
						<path>${path_vgameopt}/gl-common/logojeux/ovalcarb.png</path>
						<zIndex>99</zIndex>
						<opacity>1</opacity>
						<storyboard event="activate" ifSubset="gamewheelfade:amoitie">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0.3" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="scroll" ifSubset="gamewheelfade:amoitie">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0.3" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="deactivate" ifSubset="gamewheelfade:amoitie">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0.3" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="activate" ifSubset="gamewheelfade:activate">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="scroll" ifSubset="gamewheelfade:activate">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="deactivate" ifSubset="gamewheelfade:activate">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
					</image>
					<image name="marquee">
						<visible>!{game:folder} || !{game:system:collection}</visible>
						<pos>0.5</pos>
						<origin>0.5</origin>
						<maxSize>0.6 0.4</maxSize>
						<path>firstfile(
						"${path_syst_logo}/folderlogos/" + {game:stem} + ".png",
						"${path_syst_logo}/clearlogos/lang-${lang}/" + {game:stem} + "-${lang}.png",
						"${path_syst_logo}/clearlogos/region-${region}/" + {game:stem} + "-${region}.png",
						"${path_syst_logo}/clearlogos/" + {game:stem} + ".png",
						"${path_syst_logo}/clearlogos/lang-${lang}/" + {game:stem} + "-${lang}.svg",
						"${path_syst_logo}/clearlogos/region-${region}/" + {game:stem} + "-${region}.svg",
						"${path_syst_logo}/clearlogos/" + {game:stem} + ".svg",
						{game:marquee})</path>
						<zIndex>99</zIndex>
						<opacity>1</opacity>
						<storyboard event="activate" ifSubset="gamewheelfade:amoitie">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0.5" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="scroll" ifSubset="gamewheelfade:amoitie">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0.5" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="deactivate" ifSubset="gamewheelfade:amoitie">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0.5" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="activate" ifSubset="gamewheelfade:activate">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="scroll" ifSubset="gamewheelfade:activate">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="deactivate" ifSubset="gamewheelfade:activate">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
					</image>
					<image name="marqueecollection">
						<visible>{game:folder} &amp;&amp; {game:system:collection}</visible>
						<pos>0.5</pos>
						<origin>0.5</origin>
						<maxSize>0.6 0.4</maxSize>
						<path>firstfile(
						"${path_syst_logo}/folderlogos/" + {game:system:theme} + ".png",
						"${path_syst_logo}/clearlogos/lang-${lang}/" + {game:system:theme} + "-${lang}.png",
						"${path_syst_logo}/clearlogos/region-${region}/" + {game:system:theme} + "-${region}.png",
						"${path_syst_logo}/clearlogos/" + {game:system:theme} + ".png",
						"${path_syst_logo}/clearlogos/lang-${lang}/" + {game:system:theme} + "-${lang}.svg",
						"${path_syst_logo}/clearlogos/region-${region}/" + {game:system:theme} + "-${region}.svg",
						"${path_syst_logo}/clearlogos/" + {game:system:theme} + ".svg")</path>
						<zIndex>99</zIndex>
						<opacity>1</opacity>
						<storyboard event="activate" ifSubset="gamewheelfade:amoitie">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0.5" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="scroll" ifSubset="gamewheelfade:amoitie">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0.5" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="deactivate" ifSubset="gamewheelfade:amoitie">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0.5" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="activate" ifSubset="gamewheelfade:activate">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="scroll" ifSubset="gamewheelfade:activate">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="deactivate" ifSubset="gamewheelfade:activate">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
					</image>
					<text name="gamename">
						<visible>
						((!{game:folder} || !{game:system:collection})
						&amp;&amp; !exists({game:marquee})
						&amp;&amp; !exists("${path_syst_logo}/folderlogos/" + {game:stem} + ".png")
						&amp;&amp; !exists("${path_syst_logo}/clearlogos/lang-${lang}/" + {game:stem} + "-${lang}.png")
						&amp;&amp; !exists("${path_syst_logo}/clearlogos/region-${region}/" + {game:stem} + "-${region}.png")
						&amp;&amp; !exists("${path_syst_logo}/clearlogos/" + {game:stem} + ".png")
						&amp;&amp; !exists("${path_syst_logo}/clearlogos/" + {game:stem} + ".svg"))
						|| ({game:folder} &amp;&amp; {game:system:collection}
						&amp;&amp; !exists("${path_syst_logo}/folderlogos/" + {game:system:theme} + ".png")
						&amp;&amp; !exists("${path_syst_logo}/clearlogos/lang-${lang}/" + {game:system:theme} + "-${lang}.png")
						&amp;&amp; !exists("${path_syst_logo}/clearlogos/region-${region}/" + {game:system:theme} + "-${region}.png")
						&amp;&amp; !exists("${path_syst_logo}/clearlogos/" + {game:system:theme} + ".png")
						&amp;&amp; !exists("${path_syst_logo}/clearlogos/lang-${lang}/" + {game:system:theme} + "-${lang}.svg")
						&amp;&amp; !exists("${path_syst_logo}/clearlogos/region-${region}/" + {game:system:theme} + "-${region}.svg")
						&amp;&amp; !exists("${path_syst_logo}/clearlogos/" + {game:system:theme} + ".svg"))
						</visible>
						<text>{game:name}</text>
						<fontPath>${fontimpact}</fontPath>
						<color>FFFFFF</color>
						<alignment>center</alignment>
						<fontSize>0.028</fontSize>
						<lineSpacing>1</lineSpacing>
						<size>0.77 0.5</size>
						<pos>0.115 0.25</pos>
						<glowColor>00000066</glowColor>
						<glowSize>2</glowSize>
						<zIndex>400</zIndex>
						<multiLine>true</multiLine>
						<storyboard event="activate" ifSubset="gamewheelfade:amoitie">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0.5" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="scroll" ifSubset="gamewheelfade:amoitie">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0.5" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="deactivate" ifSubset="gamewheelfade:amoitie">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0.5" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="activate" ifSubset="gamewheelfade:activate">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="scroll" ifSubset="gamewheelfade:activate">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="deactivate" ifSubset="gamewheelfade:activate">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
					</text>
					<image name="favorite">
						<visible>{game:favorite}</visible>
						<path>${path_vgameopt}/gl-coinopsnext/favoris/yesfull.png</path>
						<pos>0.78 0.25</pos>
						<zIndex>98</zIndex>
						<maxSize>0.35 0.35</maxSize>
						<storyboard event="activate" ifSubset="gamewheelfade:amoitie">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0.3" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="scroll" ifSubset="gamewheelfade:amoitie">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0.3" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="deactivate" ifSubset="gamewheelfade:amoitie">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0.3" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="activate" ifSubset="gamewheelfade:activate">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="scroll" ifSubset="gamewheelfade:activate">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="deactivate" ifSubset="gamewheelfade:activate">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
					</image>
				</container>
			</itemTemplate>
		</gamecarousel>
	</customView>
</theme>
