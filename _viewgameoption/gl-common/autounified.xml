<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<customView name="hyperbat" inherits="gamecarousel">
		<gamecarousel name="gamecarousel">
			<itemTemplate>
				<container>
					<image name="marquee">
						<visible>(!{game:folder} || {game:stem} != {game:system:theme}) &amp;&amp; (!{game:folder} || !{game:system:collection})</visible>
						<pos>0.5</pos>
						<origin>0.5</origin>
						<maxSize>0.6</maxSize>
						<!-- <path>{game:marquee}</path> -->
						<path>firstfile({game:marquee},"${path_syst_logo}/folderlogos/" + {game:stem} + ".png")</path>
						<zIndex>100</zIndex>
						<linearSmooth>true</linearSmooth>
						<storyboard event="activate" ifSubset="gamewheelfade:amoitie">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0.3" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="scroll" ifSubset="gamewheelfade:amoitie">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0.3" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="deactivate" ifSubset="gamewheelfade:amoitie">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0.3" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="activate" ifSubset="gamewheelfade:activate">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="scroll" ifSubset="gamewheelfade:activate">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="deactivate" ifSubset="gamewheelfade:activate">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
					</image>
					<image name="marqueecollection">
						<visible>{game:folder} &amp;&amp; {game:system:collection}</visible>
						<pos>0.5</pos>
						<origin>0.5</origin>
						<maxSize>0.6</maxSize>
						<path>firstfile(
						"${path_syst_logo}/folderlogos/" + {game:system:theme} + ".png",
						"${path_syst_logo}/clearlogos/lang-${lang}/" + {game:system:theme} + "-${lang}.png",
						"${path_syst_logo}/clearlogos/region-${region}/" + {game:system:theme} + "-${region}.png",
						"${path_syst_logo}/clearlogos/" + {game:system:theme} + ".png",
						"${path_syst_logo}/clearlogos/lang-${lang}/" + {game:system:theme} + "-${lang}.svg",
						"${path_syst_logo}/clearlogos/region-${region}/" + {game:system:theme} + "-${region}.svg",
						"${path_syst_logo}/clearlogos/" + {game:system:theme} + ".svg")</path>
						<zIndex>100</zIndex>
						<linearSmooth>true</linearSmooth>
						<storyboard event="activate" ifSubset="gamewheelfade:amoitie">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0.3" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="scroll" ifSubset="gamewheelfade:amoitie">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0.3" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="deactivate" ifSubset="gamewheelfade:amoitie">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0.3" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="activate" ifSubset="gamewheelfade:activate">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="scroll" ifSubset="gamewheelfade:activate">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="deactivate" ifSubset="gamewheelfade:activate">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
					</image>
					<image name="logosystfolder">
						<visible>{game:folder} &amp;&amp; {game:stem} == {game:system:theme} &amp;&amp; !{game:system:collection}</visible>
						<pos>0.5</pos>
						<origin>0.5</origin>
						<maxSize>1</maxSize>
						<path>firstfile(
						"${path_syst_logo}/clearlogos/"  + ({game:system:theme}) + "-" + ({game:region}) + ".png",
						"${path_syst_logo}/clearlogos/"  + ({game:system:theme}) + ".png",
						"${path_syst_logo}/clearlogos/"  + ({game:folder}) + ".png")</path>
						<intlogoclearallregion>firstfile(
                    "${path_syst_logo}/clearlogos/lang-${lang}/" + {system:theme} + "-${lang}.png",
					"${path_syst_logo}/clearlogos/region-${region}/" + {system:theme} + "-${region}.png",
					"${path_syst_logo}/clearlogos/" + {system:theme} + ".png",
					"${path_syst_logo}/clearlogos/lang-${lang}/" + {system:theme} + "-${lang}.svg",
					"${path_syst_logo}/clearlogos/region-${region}/" + {system:theme} + "-${region}.svg",
					"${path_syst_logo}/clearlogos/" + {system:theme} + ".svg")</intlogoclearallregion>
						<zIndex>99</zIndex>
						<opacity>1</opacity>
						<storyboard event="activate" ifSubset="gamewheelfade:amoitie">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0.3" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="scroll" ifSubset="gamewheelfade:amoitie">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0.3" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="deactivate" ifSubset="gamewheelfade:amoitie">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0.3" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="activate" ifSubset="gamewheelfade:activate">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="scroll" ifSubset="gamewheelfade:activate">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="deactivate" ifSubset="gamewheelfade:activate">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
					</image>
					<text name="gamename">
						<visible>
						((!{game:folder} || !{game:system:collection})
						&amp;&amp; !exists({game:marquee}))
						|| ({game:folder} &amp;&amp; {game:system:collection}
						&amp;&amp; !exists("${path_syst_logo}/folderlogos/" + {game:system:theme} + ".png")
						&amp;&amp; !exists("${path_syst_logo}/clearlogos/lang-${lang}/" + {game:system:theme} + "-${lang}.png")
						&amp;&amp; !exists("${path_syst_logo}/clearlogos/region-${region}/" + {game:system:theme} + "-${region}.png")
						&amp;&amp; !exists("${path_syst_logo}/clearlogos/" + {game:system:theme} + ".png")
						&amp;&amp; !exists("${path_syst_logo}/clearlogos/lang-${lang}/" + {game:system:theme} + "-${lang}.svg")
						&amp;&amp; !exists("${path_syst_logo}/clearlogos/region-${region}/" + {game:system:theme} + "-${region}.svg")
						&amp;&amp; !exists("${path_syst_logo}/clearlogos/" + {game:system:theme} + ".svg"))
						</visible>
						<text>{game:name}</text>
						<fontPath>${fontimpact}</fontPath>
						<color>FFFFFF</color>
						<alignment>center</alignment>
						<fontSize>0.03</fontSize>
						<lineSpacing>1</lineSpacing>
						<size>0.7 0.5</size>
						<pos>0.15 0.25</pos>
						<glowColor>00000066</glowColor>
						<glowSize>2</glowSize>
						<zIndex>400</zIndex>
						<storyboard event="activate" ifSubset="gamewheelfade:amoitie">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0.3" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="scroll" ifSubset="gamewheelfade:amoitie">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0.3" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="deactivate" ifSubset="gamewheelfade:amoitie">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0.3" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="activate" ifSubset="gamewheelfade:activate">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="scroll" ifSubset="gamewheelfade:activate">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
						<storyboard event="deactivate" ifSubset="gamewheelfade:activate">
							<animation property="zIndex" to="10" begin="500" duration="" mode="Linear"/>
							<animation property="opacity" from="1" to="0" begin="1000" duration="250" mode="Linear"/>
						</storyboard>
					</text>
				</container>
			</itemTemplate>
		</gamecarousel>
	</customView>
</theme>
