<?xml version='1.0' encoding='utf-8'?>
<theme>
	<formatVersion>7</formatVersion>
	<customView name="hyperbat" displayName="${viewchoice.hyperbat}" inherits="gamecarousel">
		<text name="gamethemeauthor" extra="true">
			<text>Theme by : Dav</text>
		</text>
		<image name="background" extra="true">
			<path>"${path_syst_theme}/hyperspinxp/" + {game:system:theme} + "/Background.png"</path>
			<pos>0.5 0.5</pos>
			<size>1 1</size>
			<origin>0.5 0.5</origin>
			<zIndex>100</zIndex>
			<scaleOrigin>0 -0.3</scaleOrigin>
		</image>
		<image name="logocustom" extra="true">
			<path>firstfile("${path_syst_logo}/clearlogos/region-${region}/"  + {game:system:theme} + "-${region}.png",
							"${path_syst_logo}/clearlogos/"  + {game:system:theme} + ".png")</path>
			<maxSize>0.5 0.15</maxSize>
			<scaleOrigin>0 -0.3</scaleOrigin>
			<pos>0.512760416666667 0.13</pos>
			<size>0.813020833333333 0.205555555555556</size>
			<origin>0.5 0.5</origin>
			<zIndex>260</zIndex>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="500" duration="1000" mode="Linear" />
				<animation property="offsetY" from="-1" to="0" begin="500" duration="1000" mode="EaseOut" />
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
