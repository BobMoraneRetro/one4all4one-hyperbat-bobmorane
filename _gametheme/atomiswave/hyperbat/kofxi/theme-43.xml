	<customView name="hyperbat">
		<image name="Background" extra="true">
			<!-- storyboard neutre : garde l'element visible malgre l'include -->
			<storyboard event="activate">
				<animation property="opacity" from="1" to="1" duration="1" mode="linear"/>
			</storyboard>
		</image>
		<image name="Artwork1" extra="true">
			<pos>0.449059887262 0.630524975094</pos>
			<size>0.502402300155 0.500384620235</size>
		</image>
		<video name="PreviewVid" extra="true">
			<maxSize>0.508455339916 0.508455339916</maxSize>
		</video>
		<image name="Videobezel" extra="true">
			<pos>0.444527027838 0.624976355313</pos>
			<size>0.549327199095 0.563941537724</size>
		</image>
		<image name="Artwork4" extra="true">
			<size>0.832163063787 0.461039861789</size>
			<!-- storyboard "activateNext" corrige -->
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="1050" duration="500" mode="Linear" />
				<animation property="offsetX" from="1.333333333333" to="-0.133333333333" begin="1050" duration="500" mode="EaseOut" />
				<animation property="offsetX" from="-0.133333333333" to="0" begin="1560" duration="500" mode="EaseOut" />
			</storyboard>
			<!-- storyboard "activatePrev" corrige -->
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="1050" duration="500" mode="Linear" />
				<animation property="offsetX" from="1.333333333333" to="-0.133333333333" begin="1050" duration="500" mode="EaseOut" />
				<animation property="offsetX" from="-0.133333333333" to="0" begin="1560" duration="500" mode="EaseOut" />
			</storyboard>
			<!-- storyboard "open" corrige -->
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="1050" duration="500" mode="Linear" />
				<animation property="offsetX" from="1.333333333333" to="-0.133333333333" begin="1050" duration="500" mode="EaseOut" />
				<animation property="offsetX" from="-0.133333333333" to="0" begin="1560" duration="500" mode="EaseOut" />
			</storyboard>
		</image>
