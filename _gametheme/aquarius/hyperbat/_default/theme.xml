<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<customView name="hyperbat" displayName="${viewchoice.hyperbat}" inherits="gamecarousel">
		<image name="Background-aquarius" extra="true">
			<visible>${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'aquarius'</visible>
			<path>./background.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.499433106576 0.500000000000</pos>
			<size>1.000000000000 1.000000000000</size>
			<zIndex>100</zIndex>
		</image>
		<image name="screenshot-aquarius" extra="true">
			<visible>${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'aquarius'</visible>
			<path>{game:image}</path>
			<autoFade>false</autoFade>
			<origin>0.5 0.5</origin>
			<pos>0.276752985904 0.581172839506</pos>
			<size>0.365 0.645</size>
			<zIndex>200</zIndex>
			<linearSmooth>true</linearSmooth>
			<storyboard>
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="500" duration="500" mode="Linear"/>
				<animation property="offsetY" from="1" to="0" begin="500" duration="500" mode="Linear"/>
				<animation property="rotation" from="0" to="360" begin="500" duration="500" mode="Linear"/>
			</storyboard>
		</image>
		<image name="fiber-aquarius" extra="true">
			<visible>${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'aquarius'</visible>
			<path>./fiber.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.276752985904 0.581172839506</pos>
			<size>0.379909033033 0.496510456034</size>
			<zIndex>190</zIndex>
			<linearSmooth>true</linearSmooth>
			<storyboard>
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="500" duration="500" mode="Linear"/>
				<animation property="offsetY" from="1" to="0" begin="500" duration="500" mode="Linear"/>
				<animation property="rotation" from="0" to="360" begin="500" duration="500" mode="Linear"/>
			</storyboard>
		</image>
		<video name="gameplayprev-aquarius" extra="true">
			<visible>${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'aquarius'</visible>
			<path>{game:video}</path>
			<origin>0.5 0.5</origin>
			<pos>0.276916808390 0.579119425548</pos>
			<maxSize>0.365625000000 0.487037037037</maxSize>
			<zIndex>210</zIndex>
			<effect>none</effect>
			<delay>0.5</delay>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1300" duration="800" mode="EaseIn"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1300" duration="800" mode="EaseIn"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1300" duration="800" mode="EaseIn"/>
			</storyboard>
		</video>
		<image name="Video-aquarius" extra="true">
			<visible>${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'aquarius'</visible>
			<path>./Video.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.278573200113 0.579783950617</pos>
			<size>0.396354166667 0.545370370370</size>
			<zIndex>220</zIndex>
			<linearSmooth>true</linearSmooth>
			<storyboard>
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="500" duration="500" mode="Linear"/>
				<animation property="offsetY" from="1" to="0" begin="500" duration="500" mode="Linear"/>
				<animation property="rotation" from="0" to="360" begin="500" duration="500" mode="Linear"/>
			</storyboard>
		</image>
		<image name="artwork1-aquarius" extra="true">
			<visible>${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'aquarius'</visible>
			<path>./artwork1.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.800781250000 0.271296296296</pos>
			<size>0.398437500000 0.542592592593</size>
			<zIndex>230</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="boxart-aquarius" extra="true">
			<visible>${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'aquarius'</visible>
			<path>exists({game:boxart}) ? {game:boxart} : {game:thumbnail}</path>
			<origin>0.5 0.5</origin>
			<pos>0.655328798186 0.582539682540</pos>
			<maxSize>0.32 0.67</maxSize>
			<zIndex>240</zIndex>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="500" duration="100" mode="Linear"/>
				<animation property="offsetY" from="-1" to="0" begin="500" duration="650" mode="EaseOut"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="500" duration="100" mode="Linear"/>
				<animation property="offsetY" from="-1" to="0" begin="500" duration="650" mode="EaseOut"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="500" duration="100" mode="Linear"/>
				<animation property="offsetY" from="-1" to="0" begin="500" duration="650" mode="EaseOut"/>
			</storyboard>
		</image>
		<image name="Cartridge-aquarius" extra="true">
			<visible>${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'aquarius'</visible>
			<path>{game:cartridge}</path>
			<origin>0.5 0.5</origin>
			<pos>0.838373370181 0.714480977576</pos>
			<maxSize>0.234895833333 0.342592592593</maxSize>
			<zIndex>250</zIndex>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open" repeatAt="1300">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="800" duration="100" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" begin="800" duration="500" mode="EaseOut"/>
				<animation property="rotation" from="0" to="360" begin="7000" duration="300" mode="EaseOut"/>	
			</storyboard>
			<storyboard event="activateNext" repeatAt="1300">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="800" duration="100" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" begin="800" duration="500" mode="EaseOut"/>
				<animation property="rotation" from="0" to="360" begin="7000" duration="300" mode="EaseOut"/>	
			</storyboard>
			<storyboard event="activatePrev" repeatAt="1300">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="800" duration="100" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" begin="800" duration="500" mode="EaseOut"/>
				<animation property="rotation" from="0" to="360" begin="7000" duration="300" mode="EaseOut"/>				
			</storyboard>
		</image>
		<image name="Artwork2-aquarius" extra="true">
			<visible>${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'aquarius'</visible>
			<path>./Artwork2.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.319176941610 0.148715041572</pos>
			<size>0.607812500000 0.242592592593</size>
			<zIndex>260</zIndex>
			<linearSmooth>true</linearSmooth>
			<storyboard>
				<animation property="offsetX" from="-0.8" begin="0" duration="2000" mode="easeOut"/>
				<animation property="opacity" from="0" to="1" duration="350" mode="linear"/>
			</storyboard>
		</image>
		<control name="Cartridge-aquarius, screenshot-aquarius, gameplayprev-aquarius, Video-aquarius, artwork1-aquarius, boxart-aquarius, Artwork2-aquarius">
			<storyboard event="deactivateNext">
				<!-- <animation property="scale" to="3" begin="" autoreverse="false" duration="200" mode="easyIn"/> -->
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<!-- <animation property="scale" to="3" begin="" autoreverse="false" duration="200" mode="easyIn"/> -->
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
		</control>
		<control name="gameplayprev-aquarius">
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
		</control>
	</customView>
</theme>
