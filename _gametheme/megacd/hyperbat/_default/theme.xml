<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<customView name="hyperbat" displayName="${viewchoice.hyperbat}" inherits="gamecarousel">
		<image name="Background-megacd" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'megacd'</visible>
			<path>./background21.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.5 0.667129629630</pos>
			<size>1.001041666667 1.334259259259</size>
			<zIndex>100</zIndex>
		</image>
		<image name="art1Def-megacd" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'megacd'</visible>
			<path>firstfile("${path_game_theme}/"+ ({game:system:theme}) + "/hyperbat/_default/artwork/" + stem({game:rom}) + ".png",
				"${path_game_theme}/" + ({game:system:theme}) + "/hyperbat/_default/snatcher.png")</path>
			<origin>0.5 0.5</origin>
			<pos>0.12 0.5</pos>
			<size>0.3578125 1</size>
			<zIndex>200</zIndex>
			<scaleOrigin>-0.3 -0.3</scaleOrigin>
			<autoFade>false</autoFade>
			<!-- # Arrivee : G->D # -->
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1000" duration="500" mode="EaseIn"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1000" duration="500" mode="EaseIn"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1000" duration="500" mode="EaseIn"/>
			</storyboard>
			<storyboard event="deactivateNext">
				<animation property="scale" from="1" to="1" begin="" duration="250" mode="Linear"/>
				<animation property="opacity" to="0" begin="60" duration="100" mode="EaseIn"/>
				<!-- <animation property="scale" from="1" to="1" begin="" duration="250" mode="Linear"/> -->
				<!-- <animation property="opacity" to="0" begin="60" duration="100" mode="EaseIn"/> -->
				<!-- <animation property="x" to="-0.5" begin="60" duration="250" mode="EaseIn"/> -->
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="scale" from="1" to="1" begin="" duration="250" mode="Linear"/>
				<animation property="opacity" to="0" begin="60" duration="100" mode="EaseIn"/>
				<!-- <animation property="scale" from="1" to="1" begin="" duration="250" mode="Linear"/> -->
				<!-- <animation property="opacity" to="0" begin="60" duration="100" mode="EaseIn"/> -->
				<!-- <animation property="x" to="-0.5" begin="60" duration="250" mode="EaseIn"/> -->
			</storyboard>
		</image>
		<image name="screenshot-megacd" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'megacd'</visible>
			<path>{game:image}</path>
			<origin>0.5 0.5</origin>
			<pos>0.401041666667 0.375000000000</pos>
			<size>0.363541666667 0.485185185185</size>
			<zIndex>210</zIndex>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
		</image>
		<video name="gameplayprev-megacd" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'megacd'</visible>
			<path>{game:video}</path>
			<origin>0.5 0.5</origin>
			<pos>0.401041666667 0.375000000000</pos>
			<maxSize>0.363541666667 0.485185185185</maxSize>
			<zIndex>220</zIndex>
			<effect>none</effect>
			<delay>0.5</delay>
		</video>

		<image name="Video-megacd" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'megacd'</visible>
			<path>./Video.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.402604166667 0.382870370370</pos>
			<size>0.406250000000 0.541666666667</size>
			<zIndex>230</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="MegaCD-megacd" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'megacd'</visible>
			<path>./MegaCD.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.392708333333 0.924074074074</pos>
			<size>0.353125000000 0.181481481481</size>
			<zIndex>240</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="Console-megacd" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'megacd'</visible>
			<path>./Console.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.387239583333 0.745370370370</pos>
			<size>0.371354166667 0.279629629630</size>
			<!-- <scale>0.9</scale> -->
			<zIndex>250</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="Console2-megacd" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'megacd'</visible>
			<path>firstfile(
			"${path_game_theme}/"  + ({game:system:theme}) + "/Hyperbat/_default/Console-" + {game:region} + ".png",
			"${path_game_theme}/"  + ({game:system:theme}) + "/Hyperbat/_default/Console-${region}.png")</path>
			<origin>0.5 0.5</origin>
			<pos>0.349218750000 0.725462962963</pos>
			<size>0.447395833333 0.319444444444</size>
			<zIndex>270</zIndex>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
		</image>
		<image name="Console_ON" extra="true">
			<!-- <visible ifSubset="hsperview:themejeux">!exists("${path_game_theme}/${system.theme}/Hyperbat/" + stem({game:rom}) + "/theme.xml")</visible> -->
			<visible ifSubset="hsperview:themejeux">${IfnoextGamethemeexist}</visible>
			<path>./ON.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.365885 0.739352</pos>
			<size>0.138021 0.026852</size>
			<zIndex>260</zIndex>
			<scaleOrigin>-0.3 -0.3</scaleOrigin>
			<autoFade>false</autoFade>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="0" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1200" duration="200" mode="Linear"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="0" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1200" duration="200" mode="Linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="0" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1200" duration="200" mode="Linear"/>
			</storyboard>
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" mode="Linear"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" mode="Linear"/>
			</storyboard>
		</image>
		<image name="Artwork1-1-megacd" extra="true">
			<!-- <visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; !exists({game:cartridge})&amp;&amp; {game:system:theme} == 'megacd'</visible> -->
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'megacd'</visible>
			<path>./Artwork1-1.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.834114583333 0.839351851852</pos>
			<size>0.180729166667 0.321296296296</size>
			<zIndex>320</zIndex>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="0" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="0" duration="400" mode="Linear"/>
				<animation property="offsetX" from="0.3" to="0" begin="0" duration="800" mode="Linear"/>
			</storyboard>
		</image>
		<image name="cartridge-megacd" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'megacd'</visible>
			<path>{game:cartridge}</path>
			<origin>0.5 0.5</origin>

			<pos>0.833333 0.839352</pos>
			<maxSize>0.2 0.325</maxSize>
<!-- <pos>0.833333 0.838426</pos> -->
<!-- <size>0.182292 0.323148</size> -->
			<!-- <scale ifSubset="boxorthumb:boxback">1.000000000000</scale> -->
			<zIndex>330</zIndex>
			<linearSmooth>true</linearSmooth>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<autoFade>false</autoFade>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="0" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1000" duration="1000" mode="easeIn"/>
				<animation property="rotation" from="0" to="360" begin="2000" duration="5000" mode="easeIn"/>
				<animation property="rotation" from="0" to="360" begin="7000" duration="3200" repeat="forever" mode="linear"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="0" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1000" duration="1000" mode="easeIn"/>
				<animation property="rotation" from="0" to="360" begin="2000" duration="5000" mode="easeIn"/>
				<animation property="rotation" from="0" to="360" begin="7000" duration="3200" repeat="forever" mode="linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="0" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1000" duration="1000" mode="easeIn"/>
				<animation property="rotation" from="0" to="360" begin="2000" duration="5000" mode="easeIn"/>
				<animation property="rotation" from="0" to="360" begin="7000" duration="3200" repeat="forever" mode="linear"/>
			</storyboard>
		</image>
		<image name="logoo-megacd" extra="true">
		<visible ifSubset="hsperview:themejeux">${IfnoextGamethemeexist}</visible>
			<path>firstfile(
			"${path_game_theme}/"  + ({game:system:theme}) + "/Hyperbat/_default/logo-" + {game:region} + ".png",
			"${path_game_theme}/"  + ({game:system:theme}) + "/Hyperbat/_default/logo.png")</path>
			<maxSize>0.55 0.12</maxSize>
			<scaleOrigin>0 -0.3</scaleOrigin>
			<pos>0.40 0.072</pos>
			<origin>0.5 0.5</origin>
			<zIndex>500</zIndex>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="0" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="0" duration="400" mode="Linear"/>
				<animation property="offsetY" from="-0.3" to="0" begin="0" duration="800" mode="Linear"/>
			</storyboard>
		</image>
		<image name="artwork1-megacd" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'megacd'</visible>
			<path>./artwork1.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.866145833333 0.717592592593</pos>
			<size>0.271875000000 0.566666666667</size>
			<zIndex>360</zIndex>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="0" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="0" duration="400" mode="Linear"/>
				<animation property="offsetX" from="0.3" to="0" begin="0" duration="800" mode="Linear"/>
			</storyboard>
		</image>
		<image name="artwork11-megacd" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'megacd'</visible>
			<path>./artwork11.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.866145833333 0.717592592593</pos>
			<size>0.271875000000 0.566666666667</size>
			<zIndex>300</zIndex>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="0" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="0" duration="400" mode="Linear"/>
				<animation property="offsetX" from="0.3" to="0" begin="0" duration="800" mode="Linear"/>
			</storyboard>
		</image>
		<image name="boxart-megacd" extra="true" ifSubset="boxorthumb:thumb">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'megacd'</visible>
			<path>firstfile(${box2dpath},${box3dpath})</path>
			<origin>0.5 0.5</origin>
			<pos>0.783593750000 0.421296296296</pos>
			<maxSize>0.313020833333 0.472222222222</maxSize>
			<zIndex>310</zIndex>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="1" to="1" begin="1000" duration="500" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" begin="1000" duration="1000" mode="EaseOut"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="1" to="1" begin="1000" duration="500" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" begin="1000" duration="1000" mode="EaseOut"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="1" to="1" begin="1000" duration="500" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" begin="1000" duration="1000" mode="EaseOut"/>
			</storyboard>
		</image>
		<image name="boxart-megacd" extra="true" ifSubset="boxorthumb:boxart">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'megacd'</visible>
			<path>firstfile(${box3dpath},${box2dpath})</path>
			<origin>0.5 0.5</origin>
			<!-- <pos>0.757812500000 0.425462962963</pos> -->
			<!-- <maxSize>0.228125000000 0.536111111111</maxSize> -->
			<pos>0.747812500000 0.405462962963</pos>
			<maxSize>0.25 0.6</maxSize>
			<zIndex>300</zIndex>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="1" to="1" begin="1000" duration="500" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" begin="1000" duration="1000" mode="EaseOut"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="1" to="1" begin="1000" duration="500" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" begin="1000" duration="1000" mode="EaseOut"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="1" to="1" begin="1000" duration="500" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" begin="1000" duration="1000" mode="EaseOut"/>
			</storyboard>
		</image>
		<control name="gameplayprev-megacd">
			<storyboard event="deactivateNext">
				<!-- <animation property="scale" to="3" begin="" autoreverse="false" duration="200" mode="easyIn"/> -->
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<!-- <animation property="scale" to="3" begin="" autoreverse="false" duration="200" mode="easyIn"/> -->
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
		</control>
		<control name="screenshot-megacd, Video-megacd, MegaCD-megacd, Console-megacd, Console-eu-megacd, Console-jp-megacd, Console-jp2-megacd, Console-us-megacd, boxart-megacd, boxart-megacd, Artwork1-1-megacd, cartridge-megacd, logo-jp-megacd, Sega Mega-CD (metal version)-03-megacd, artwork1-megacd">
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
		</control>
		<text name="defaultthemeauthor" extra="true">
			<text>Theme by : Dav</text>
		</text>
	</customView>
</theme>
