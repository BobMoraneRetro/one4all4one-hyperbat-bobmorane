<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<customView name="hyperbat" displayName="${viewchoice.hyperbat}" inherits="gamecarousel">
		<image name="Background-atarilynx" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'atarilynx'</visible>
			<path>./Background.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.500781250000 0.500925925926</pos>
			<size>1.001562500000 1.001851851852</size>
			<zIndex>100</zIndex>
		</image>
		<image name="Backscreen-atarilynx" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'atarilynx'</visible>
			<path>./Backscreen.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.336197916667 0.556481481481</pos>
			<size>0.257812500000 0.364814814815</size>
			<zIndex>210</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<video name="gameplayprev-atarilynx" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'atarilynx'</visible>
			<path>{game:video}</path>
			<origin>0.5 0.5</origin>
			<pos>0.335760517799 0.550161812298</pos>
			<size>0.209344660194 0.240920532183</size>
			<zIndex>220</zIndex>
			<effect>none</effect>
			<delay>0.5</delay>
		</video>
		<image name="Video-atarilynx" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'atarilynx'</visible>
			<path>./video.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.335937500000 0.556481481481</pos>
			<size>0.671875000000 0.590740740741</size>
			<zIndex>230</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="led-atarilynx" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'atarilynx'</visible>
			<path>./led.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.198177083333 0.338888888889</pos>
			<size>0.009895833333 0.018518518519</size>
			<zIndex>240</zIndex>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="650" duration="100" mode="Linear"/>
				<animation property="scale" to="1" begin="650" duration="100" autoreverse="false" mode="linear"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="650" duration="100" mode="Linear"/>
				<animation property="scale" to="1" begin="650" duration="100" autoreverse="false" mode="linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="650" duration="100" mode="Linear"/>
				<animation property="scale" to="1" begin="650" duration="100" autoreverse="false" mode="linear"/>
			</storyboard>
		</image>
		<image name="Artwork1-atarilynx" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'atarilynx'</visible>
			<path>./Artwork1.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.336458333333 0.142129629630</pos>
			<size>0.533333333333 0.106481481481</size>
			<zIndex>250</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="Support-atarilynx" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'atarilynx'</visible>
			<path>{game:cartridge}</path>
			<origin>0.5 0.5</origin>
			<pos>0.913241149936 0.687351672060</pos>
			<size>0.142116001099 0.263592233010</size>
			<zIndex>270</zIndex>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="250" duration="500" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="250" duration="1000" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="250" duration="1000" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
		</image>
		<image name="Boxart-atarilynx" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'atarilynx'</visible>
			<path ifSubset="boxorthumb:thumb">firstfile(${box2dpath},${box3dpath})</path>
			<path ifSubset="boxorthumb:boxart">firstfile(${box3dpath},${box2dpath})</path>
			<origin>0.5 0.5</origin>
			<pos>0.791927083333 0.469295085123</pos>
			<maxSize>0.212262338188 0.714088722238</maxSize>
			<zIndex>260</zIndex>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1770" duration="500" mode="Linear"/>
				<animation property="offsetY" from="-1" to="0" begin="1770" duration="400" mode="linear"/>
				<animation property="offsetY" from="0" to="-0.06" begin="2170" duration="350" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.038" begin="2870" duration="250" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.024" begin="3370" duration="140" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.009" begin="3650" duration="60" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.0025" begin="3770" duration="20" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="0" begin="3810" duration="2500" mode="Linear" autoReverse="true"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1770" duration="500" mode="Linear"/>
				<animation property="offsetY" from="-1" to="0" begin="1770" duration="400" mode="linear"/>
				<animation property="offsetY" from="0" to="-0.06" begin="2170" duration="350" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.038" begin="2870" duration="250" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.024" begin="3370" duration="140" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.009" begin="3650" duration="60" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.0025" begin="3770" duration="20" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="0" begin="3810" duration="2500" mode="Linear" autoReverse="true"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1770" duration="500" mode="Linear"/>
				<animation property="offsetY" from="-1" to="0" begin="1770" duration="400" mode="linear"/>
				<animation property="offsetY" from="0" to="-0.06" begin="2170" duration="350" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.038" begin="2870" duration="250" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.024" begin="3370" duration="140" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.009" begin="3650" duration="60" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.0025" begin="3770" duration="20" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="0" begin="3810" duration="2500" mode="Linear" autoReverse="true"/>
			</storyboard>
		</image>
		<control name="Backscreen-atarilynx, gameplayprev-atarilynx, Video-atarilynx, Artwork1-atarilynx">
			<storyboard event="deactivateNext">
				<!-- <animation property="scale" to="3" begin="" autoreverse="false" duration="200" mode="easyIn"/> -->
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<!-- <animation property="scale" to="3" begin="" autoreverse="false" duration="200" mode="easyIn"/> -->
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
		</control>
		<control name="led-atarilynx, Boxart-atarilynx, Support-atarilynx">
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
		</control>
		<text name="defaultthemeauthor" extra="true">
			<text>Theme by : Akeshi</text>
		</text>
	</customView>
</theme>
