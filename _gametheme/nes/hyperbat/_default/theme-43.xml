<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- Correction 4:3 generee par Ratio themes le 2026-10-09 depuis theme.xml (hauteurs x0.75 autour de l'ancre) -->
	<include>./theme.xml</include>
	<customView name="hyperbat">
		<image name="Background-nes" extra="true">
			<!-- storyboard neutre : garde l'element visible malgre l'include -->
			<storyboard event="activate">
				<animation property="opacity" from="1" to="1" duration="1" mode="linear"/>
			</storyboard>
		</image>
		<image name="logo-nes" extra="true">
			<!-- copie du storyboard par defaut, rejoue au changement de jeu (include) -->
			<storyboard event="activate">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="1770" duration="500" mode="Linear" />
			</storyboard>
		</image>
		<image name="screenshotnes" extra="true">
			<size>0.425 0.42</size>
			<!-- storyboard neutre : garde l'element visible malgre l'include -->
			<storyboard event="activate">
				<animation property="opacity" from="1" to="1" duration="1" mode="linear"/>
			</storyboard>
		</image>
		<video name="gameplayprev-nes" extra="true">
			<maxSize>0.43 0.4275</maxSize>
		</video>
		<image name="bezel-nes" extra="true">
			<pos>0.50859375 0.54975038681</pos>
			<size>0.447395833333 0.452777777778</size>
			<!-- storyboard neutre : garde l'element visible malgre l'include -->
			<storyboard event="activate">
				<animation property="opacity" from="1" to="1" duration="1" mode="linear"/>
			</storyboard>
		</image>
		<image name="etuis-cartouche-ne-nes" extra="true">
			<!-- storyboard neutre : garde l'element visible malgre l'include -->
			<storyboard event="activate">
				<animation property="opacity" from="1" to="1" duration="1" mode="linear"/>
			</storyboard>
		</image>
		<text name="gamethemeauthor" extra="true">
			<!-- storyboard neutre : garde l'element visible malgre l'include -->
			<storyboard event="activate">
				<animation property="opacity" from="1" to="1" duration="1" mode="linear"/>
			</storyboard>
		</text>
	</customView>
</theme>
