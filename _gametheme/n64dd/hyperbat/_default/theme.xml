				<!-- <animation property="offsetY" from="-1" to="0" duration="4000" mode="EaseOutQuint"/> -->
			<!-- </storyboard> -->

		</image>
		<image name="boxart-n64dd" extra="true" ifSubset="boxorthumb:thumb">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'n64dd'</visible>
			<path>firstfile(${box2dpath},${box3dpath})</path>
			<origin>0.5 0.5</origin>
			<!-- <pos>0.809098639456 0.462758251449</pos> -->
			<!-- <maxSize>0.268750000000 0.412037037037</maxSize> -->
			<pos>0.818370890023 0.500153747258</pos>
			<maxSize>0.287294501134 0.440468744202</maxSize>
			<zIndex>230</zIndex>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
			<shader>
				<path>${bobmediapath}/_common/shaders/border_multi_gradient.glsl</path>
				<cornerRadius>0.002</cornerRadius>
				<innerShadowSize>0.01</innerShadowSize>
				<innerShadowColor>00000030</innerShadowColor>
				<outerShadowSize>0.01</outerShadowSize>
				<outerShadowColor>00000050</outerShadowColor>
				<gradientMode/>
