				<borderSize2/>
				<borderColor2/>
				<borderColorStart2/>
				<borderColorEnd2/>
				<borderSize3/>
				<borderColor3/>
				<borderColorStart3/>
				<borderColorEnd3/>
			</shader>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="650" duration="500" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" begin="650" duration="500" mode="Linear"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="650" duration="500" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" begin="650" duration="500" mode="Linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="650" duration="500" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" begin="650" duration="500" mode="Linear"/>
			</storyboard>
		</image>
		<image name="boxart-n64dd" extra="true" ifSubset="boxorthumb:boxart">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'n64dd'</visible>
			<path>firstfile(${box3dpath},${box2dpath})</path>
			<origin>0.5 0.5</origin>
			<pos>0.803477536848 0.498680398085</pos>
			<maxSize>0.258854166667 0.521296296296</maxSize>
			<zIndex>240</zIndex>
