<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<customView name="hyperbat" displayName="${viewchoice.hyperbat}" inherits="gamecarousel">
		<image name="Background-n64dd" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'n64dd'</visible>
			<path>./Background.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.500000000000 0.500000000000</pos>
			<size>1.000000000000 1.000000000000</size>
			<zIndex>100</zIndex>
		</image>
		<image name="fanart-n64dd" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'n64dd'</visible>
			<path>{game:fanart}</path>
			<origin>0.5 0.5</origin>
			<pos>0.5 0.5</pos>
			<size>1 1</size>
			<zIndex>205</zIndex>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="0.7" begin="950" duration="500" mode="Linear"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="0.7" begin="950" duration="500" mode="Linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="0.7" begin="300" duration="650" mode="Linear"/>
			</storyboard>
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" begin="" duration="300" mode="linear"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" begin="" duration="300" mode="linear"/>
			</storyboard>
		</image>
		<video name="gameplayprev-n64dd" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'n64dd'</visible>
			<path>{game:video}</path>
			<origin>0.5 0.5</origin>
			<!-- <pos>0.447211592971 0.560887503149</pos> -->
			<!-- <size>0.390625000000 0.521296296296</size> -->
			<pos>0.458227040816 0.560648148148</pos>
			<size>0.390625000000 0.521296296296</size>
			<zIndex>210</zIndex>
			<effect>none</effect>
			<delay>0.5</delay>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1250" duration="500" mode="Linear"/>
			</storyboard>
		</video>
		<image name="screenshot-n64dd" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'n64dd'</visible>
			<path>{game:image}</path>
			<origin>0.5 0.5</origin>
			<!-- <pos>0.447211592971 0.560887503149</pos> -->
			<!-- <size>0.390625000000 0.521296296296</size> -->
			<pos>0.458227040816 0.560648148148</pos>
			<size>0.390625000000 0.521296296296</size>
			<zIndex>205</zIndex>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="200" duration="500" mode="Linear"/>
				<animation property="offsetY" from="1" to="0" begin="200" duration="500" mode="easeOut"/>
			</storyboard>
		</image>
		<image name="video-n64dd" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'n64dd'</visible>
			<path>./video.png</path>
			<origin>0.5 0.5</origin>
			<!-- <pos>0.451294997166 0.574571680524</pos> -->
			<!-- <size>0.450017715420 0.629113126732</size> -->
			<pos>0.46297037982 0.574571680524</pos>
			<size>0.450017715420 0.629113126732</size>
			<zIndex>220</zIndex>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="200" duration="500" mode="Linear"/>
				<animation property="offsetY" from="1" to="0" begin="200" duration="500" mode="easeOut"/>
			</storyboard>
		</image>
		<image name="cartridge-n64dd" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'n64dd'</visible>
			<path>{game:cartridge}</path>
			<origin>0.5 0.5</origin>
			<!-- <pos>0.887852536848 0.710339506173</pos> -->
			<!-- <size>0.199479166667 0.354629629630</size> -->
			<pos>0.889239654195 0.728029730411</pos>
			<size>0.164838435374 0.293046107332</size>
			<zIndex>250</zIndex>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="950" duration="500" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" begin="950" duration="500" mode="Linear"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="950" duration="500" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" begin="950" duration="500" mode="Linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="950" duration="500" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" begin="950" duration="500" mode="Linear"/>
			</storyboard>
		</image>
		<image name="Artwork2-n64dd" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'n64dd'</visible>
			<path>./Artwork2.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.151822916667 0.388441672965</pos>
			<size>0.303645833333 0.881481481481</size>
			<zIndex>260</zIndex>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="500" duration="1000" mode="Linear"/>
				<animation property="offsetY" from="-0.5" to="0.04" begin="500" duration="800" mode="easeOut"/>
				<animation property="offsetY" from="0.04" to="-0.025" begin="1300" duration="800" autoreverse="false" mode="bump"/>
				<animation property="offsetY" from="-0.025" to="0.01" begin="2100" duration="800" autoreverse="false" mode="bump"/>
				<animation property="offsetY" from="0.01" to="-0.002" begin="2900" duration="800" autoreverse="false" mode="bump"/>
				<animation property="offsetY" from="-0.002" to="0" begin="3700" duration="800" autoreverse="false" mode="bump"/>
				<!-- <animation property="scale" from="1" to="1.05" begin="4500" duration="3800" autoreverse="true" repeat="forever" mode="easeInOut"/> -->
			</storyboard>

			<storyboard event="deactivate">
				<animation property="opacity" to="0" begin="" duration="" mode="linear"/>
			</storyboard>
			<!-- <storyboard event="deactivatePrev"> -->
				<!-- <animation property="opacity" to="0" begin="100" duration="150" mode="linear"/> -->
			<!-- </storyboard> -->
		</image>
		<image name="Atrwork1-n64dd" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'n64dd'</visible>
			<path>./Atrwork1.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.441819019274 0.15</pos>
			<size>0.353125000000 0.302777777778</size>
			<zIndex>270</zIndex>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="250" duration="500" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
			<!-- <storyboard event="activateNext"> -->
				<!-- <animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/> -->
				<!-- <animation property="opacity" from="0" to="1" begin="250" duration="1000" mode="Linear"/> -->
