<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<customView name="hyperbat" displayName="${viewchoice.hyperbat}" inherits="gamecarousel">
		<image name="Background-gbc2players" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'gbc2players'</visible>
			<path>./Background.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.500000000000 0.500000000000</pos>
			<size>1.000000000000 1.000000000000</size>
			<zIndex>100</zIndex>
		</image>
		<image name="Backscreen-gbc2players" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'gbc2players'</visible>
			<path>./Backscreen.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.264843750000 0.260185185185</pos>
			<size>0.188020833333 0.301851851852</size>
			<zIndex>210</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<video name="gameplayprev-gbc2players" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'gbc2players'</visible>
			<path>{game:video}</path>
			<origin>0.5 0.5</origin>
			<pos>0.265473300971 0.260248112190</pos>
			<size>0.188106796117 0.297554836390</size>
			<zIndex>220</zIndex>
			<effect>none</effect>
			<delay>0.5</delay>
		</video>
		<image name="Cable-gbc2players" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'gbc2players'</visible>
			<path>./Cable.png</path>
			<origin>0.5 0.5</origin>
			<pos>-0.083333333333 0.488888888889</pos>
			<size>0.415625000000 0.518518518519</size>
			<zIndex>230</zIndex>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="250" duration="500" mode="Linear"/>
				<animation property="offsetX" from="-7.9" to="0" begin="0" duration="750" mode="EaseOutQuint"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="250" duration="500" mode="Linear"/>
				<animation property="offsetX" from="-7.9" to="0" begin="0" duration="750" mode="EaseOutQuint"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="250" duration="500" mode="Linear"/>
				<animation property="offsetX" from="-7.9" to="0" begin="0" duration="750" mode="EaseOutQuint"/>
			</storyboard>
		</image>
		<image name="Video-gbc2players" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'gbc2players'</visible>
			<path>./video.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.266406250000 0.508333333333</pos>
			<size>0.324479166667 0.983333333333</size>
			<zIndex>240</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="Led-gbc2players" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'gbc2players'</visible>
			<path>./Led.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.137500000000 0.199537037037</pos>
			<size>0.011458333333 0.019444444444</size>
			<zIndex>250</zIndex>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1000" duration="100" mode="Linear"/>
				<animation property="scale" to="1" begin="1000" duration="100" autoreverse="false" mode="linear"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1000" duration="100" mode="Linear"/>
				<animation property="scale" to="1" begin="1000" duration="100" autoreverse="false" mode="linear"/>
