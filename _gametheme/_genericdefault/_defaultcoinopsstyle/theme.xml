<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<variables>
		<!-- Variables utilisees dans ce fichier (definitions reprises de theme.xml) -->
		<!-- <bobmediapath>${themePath}/../_bobmedia</bobmediapath> -->
		<extgamescreenjpg>("${path_game_media}/"  + ({game:system:theme}) + "/screenshots/" + stem({game:rom}) + ".jpg")</extgamescreenjpg>
		<globalgamecabs>"${path_game_media}/" + ({game:system:theme}) + "/cabs/" + stem({game:rom}) + ".png"</globalgamecabs>
		<intcoinopscollec>firstfile(  "${path_game_media}/" + ({game:system:theme}) + "/cabs/" + stem({game:rom}) + ".png",
					"${path_game_media}/" + ({game:system:theme}) + "/cabs/_"  + ({game:system:theme}) + ".png",
					"${path_game_media}/_systemcoinops/"  + ({game:system:theme}) + ".png",
					"${path_game_media}/_defaultgamemedia/cabs/default.png")
		</intcoinopscollec>
		<intcoinopsnext>("${themePath}/_viewgame/coinops/coinopsnext/"  + ({game:system:theme}) + ".png")</intcoinopsnext>
	</variables>
	<customView name="hyperbat" displayName="${viewchoice.hyperbat}" inherits="gamecarousel">
		<!-- ######## Conditions de visibilité du theme generic : uniquement si pas de theme de jeu ni de theme defaut specific au système ############ -->
		<control name="overlaybase,overlaymore,fondecranmarquee,fondecranpreview,fondmur,fondsystem,screenshotscust,previewvid1,screenshader,fondwheel,loop01,fondposter1,fondposter2">
			<visible ifSubset="gameviewsource:actualsystem|mamefolder">${gamethemefile} == ""</visible>
			<!-- <visible>!exists("${path_game_theme}/${system.theme}/hyperbat/_default/theme.xml")</visible> -->
		</control>
		<image name="overlaybase" extra="true">
			<path>${themePath}/_viewgame/coinops/overlay/overlay.png</path>
			<size>1 1</size>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<zIndex>20</zIndex>
			<opacity>0.7</opacity>
		</image>
		<image name="overlaymore" extra="true">
			<path>${path_vgame}/coinops/overlay/vignette.png</path>
			<size>1 1</size>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<zIndex>50</zIndex>
		</image>
		<image name="fondecranmarquee" extra="true">
			<path>${path_vgame}/coinops/overlay/fiber.png</path>
			<size>0.44 0.36</size>
			<pos>0.245 0.1</pos>
			<origin>0.5 0.5</origin>
			<color>000000</color>
			<zIndex>3</zIndex>
			<opacity>1</opacity>
			<roundCorners>0.05</roundCorners>
		</image>
		<image name="fondecranpreview" extra="true">
			<path>${path_vgame}/coinops/overlay/fiber.png</path>
			<size>0.395 0.52</size>
			<pos>0.241 0.54</pos>
			<origin>0.5 0.5</origin>
			<color>000000</color>
			<zIndex>4</zIndex>
			<opacity>1</opacity>
			<roundCorners>0.05</roundCorners>
		</image>
		<!-- ############################ fond générique du système ########################################		 -->
		<image name="fondmur" extra="true">
			<path>./_viewgame/coinops/murnuarrondi.png</path>
			<size>1 1</size>
			<pos>0.45 0.5</pos>
			<origin>0.5 0.5</origin>
			<zIndex>2</zIndex>
			<opacity>1</opacity>
		</image>
		<!-- Si aucun cabinets n'existe, prend le fond système dans coinops collec -->
		<image name="fondwheel" extra="true">
			<path>firstfile(${extgamecoverjpg},${standardsbuildsfanart},{game:thumbnail},{game:boxart},"${path_syst_fanart}/fresh/${system.theme}.jpg")</path>
			<pos>0.71 0.5</pos>
			<size>0 1.07</size>
			<origin>0.5 0.5</origin>
			<color>FFFFFFFF</color>
			<colorEnd>FFFFFFDD</colorEnd>
			<gradientType>horizontal</gradientType>
			<linearSmooth>true</linearSmooth>
			<zIndex>0</zIndex>
			<scaleOrigin>-0.15 0</scaleOrigin>
			<autoFade>false</autoFade>
			<scaleOrigin>-0.15 0</scaleOrigin>
			<!-- <storyboard event="open"> -->
				<!-- <animation property="opacity" to="1" duration="1" mode="easeIn"/> -->
			<!-- </storyboard> -->
			<!-- <storyboard event="activateNext"> -->
				<!-- <animation property="offsetX" from="0.02" to="0" duration="200" mode="linear"/> -->
				<!-- <animation property="opacity" from="0" to="1" duration="100" mode="easeInCubic"/> -->
			<!-- </storyboard> -->
			<!-- <storyboard event="activatePrev"> -->
				<!-- <animation property="offsetX" from="-0.02" to="0" duration="200" mode="linear"/> -->
				<!-- <animation property="opacity" from="0" to="1" duration="100" mode="easeInCubic"/> -->
			<!-- </storyboard> -->
			<!-- <storyboard event="deactivateNext"> -->
				<!-- <animation property="offsetX" to="-0.02" duration="200" mode="linear"/> -->
				<!-- <animation property="opacity" to="0" begin="100" duration="200" mode="easeIn"/> -->
			<!-- </storyboard> -->
			<!-- <storyboard event="deactivatePrev"> -->
				<!-- <animation property="offsetX" to="0.02" duration="200" mode="linear"/> -->
				<!-- <animation property="opacity" to="0" begin="100" duration="200" mode="easeIn"/> -->
			<!-- </storyboard> -->
		</image>
		<image name="screenshotscust" extra="true">
			<autoFade>false</autoFade>
			<path>firstfile(${extgamescreenjpg},{game:screenshot},{game:image})</path>
			<pos>0.2485 0.538</pos>
			<maxSize>0.4 0.488</maxSize>
			<origin>0.5 0.5</origin>
			<zIndex>5</zIndex>
			<scaleOrigin>0.15 0.15</scaleOrigin>
			<storyboard event="open">
				<animation property="opacity" to="1" duration="20" mode="easeIn"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="scale" from="1" to="1" begin="" duration="250" mode="easeOut"/>
				<animation property="opacity" from="0" to="1" duration="" mode="easeIn"/>
				<animation enabled="exists({game:video})" property="opacity" from="1" to="0" begin="500" duration="300" mode="easeIn"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="scale" from="1" to="1" begin="" duration="250" mode="easeOut"/>
				<animation property="opacity" from="0" to="1" begin="" duration="" mode="easeIn"/>
				<animation enabled="exists({game:video})" property="opacity" from="1" to="0" begin="500" duration="300" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivateNext">
				<animation property="scale" from="1" to="1" begin="" duration="250" mode="linear"/>
				<animation property="opacity" to="0" begin="60" duration="" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="scale" from="1" to="1" begin="" duration="250" mode="linear"/>
				<animation property="opacity" to="0" begin="60" duration="" mode="easeIn"/>
			</storyboard>
		</image>
		<video name="previewvid1" extra="true">
			<path>{game:video}</path>
			<delay>0.3</delay>
			<pos>0.2485 0.538</pos>
			<maxSize>0.39 0.488</maxSize>
			<origin>0.5 0.5</origin>
			<effect>none</effect>
			<zIndex>9</zIndex>
		</video>
		<image name="screenshader" extra="true">
			<pos>0.060 0.295</pos>
			<maxSize>0.38 0.49</maxSize>
			<path>${path_vgame}/coinops/scanlines01.png</path>
			<color>FFFFFF60</color>
			<tile>true</tile>
			<zIndex>9</zIndex>
		</image>
		<video name="loop01" extra="true">
			<path>${path_vgame}/coinops/background.mp4</path>
			<effect>none</effect>
			<origin>0.5 0.5</origin>
			<pos>0.75 0.5</pos>
			<size>1 1</size>
			<zIndex>2</zIndex>
			<opacity>0.3</opacity>
		</video>
		<image name="fondsystem" extra="true">
			<linearSmooth>true</linearSmooth>
			<origin>0.5 0.5</origin>
			<pos>0.46 0.5</pos>
			<size>1 1</size>
			<autoFade>false</autoFade>
			<path>${intcoinopscollec}</path>
			<zIndex>10</zIndex>
			<scaleOrigin>-0.1 0</scaleOrigin>
			<storyboard event="open">
				<animation property="opacity" to="1" duration="1" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" begin="100" duration="200" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" begin="100" duration="200" mode="easeIn"/>
			</storyboard>
		</image>
		<!-- ############################## cabs 3D classique #################################		 -->
		<image name="fondposter1" extra="true">
			<path>firstfile({game:fanart},"${path_syst_fanart}/fresh/${system.theme}.jpg",{game:image})</path>
			<color>b7b7b7</color>
			<colorEnd>FFFFFFDD</colorEnd>
			<autoFade>false</autoFade>
			<tile>false</tile>
			<maxSize>0.43 1</maxSize>
			<size>0.43 0.45</size>
			<pos>0.25 0.15</pos>
			<clipRect>0.000001 0.00001 0.7 0.21</clipRect>
			<origin>0.5 0.5</origin>
			<saturation>0.5</saturation>
			<zIndex>3</zIndex>
			<scaleOrigin>-0.1 0</scaleOrigin>
		</image>
		<image name="fondposter2" ifSubset="systback:cpscollection" extra="true">
			<autoFade>false</autoFade>
			<tile>false</tile>
			<maxSize>0.2 0.2</maxSize>
			<pos>0.25 0.11</pos>
			<origin>0.5 0.5</origin>
			<zIndex>3</zIndex>
			<scaleOrigin>-0.1 0</scaleOrigin>
			<path>firstfile({game:marquee},{game:wheel})</path>
		</image>
