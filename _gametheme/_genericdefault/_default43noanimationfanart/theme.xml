				<animation property="scale" from="1" to="1.2" begin="200" duration="15000" mode="EaseOut" autoreverse="true"/>
				<animation property="x" from="0" to="-0.1" begin="200" duration="15000" mode="EaseOut" autoreverse="true"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="0" duration="1" mode="linear"/>
				<animation property="opacity" from="0" to="0.5" begin="0" duration="300" mode="linear"/>
				<animation property="scale" from="1" to="1.2" begin="200" duration="15000" mode="EaseOut" autoreverse="true"/>
				<animation property="x" from="0" to="-0.1" begin="200" duration="15000" mode="EaseOut" autoreverse="true"/>
			</storyboard>
