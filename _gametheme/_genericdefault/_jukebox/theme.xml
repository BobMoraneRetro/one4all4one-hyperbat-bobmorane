<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<customView name="hyperbat" displayName="${viewchoice.hyperbat}" inherits="gamecarousel">
		<!-- ######## Conditions de visibilité du theme generic : uniquement si pas de theme de jeu ni de theme defaut specific au système ############ -->
		<control name="BackgrSystdeffanart,cdfond,test,cdcentre,cdtexte,casefond,box,caseglass,parentaladvisory,compactdisc,logocustshadowddejukebox,logocustdejukebox,logocustshadowddejukeboxcollection,logocustdejukeboxcollection">
			<visible ifSubset="gameviewsource:actualsystem|mamefolder">${gamethemefile} == ""</visible>
			<!-- <visible>!exists("${path_game_theme}/${system.theme}/hyperbat/_default/theme.xml")</visible> -->
		</control>
		<image name="BackgrSystdeffanart" extra="true">
			<path ifSubset="custombuilds:standardbuilds">firstfile({game:fanart},{game:screenshot},{game:image},{game:thumbnail},{game:boxart},"${path_syst_fanart}/fresh/${system.theme}.jpg")</path>
			<path ifSubset="custombuilds:retrofreshbat">firstfile({game:image},{game:fanart},{game:screenshot},{game:thumbnail},{game:boxart},"${path_syst_fanart}/fresh/${system.theme}.jpg")</path>
			<linearSmooth>true</linearSmooth>
			<size>1 1</size>
			<pos>0 0</pos>
			<origin>0 0</origin>
			<zIndex>1</zIndex>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="0" duration="1" mode="linear"/>
				<animation property="opacity" from="0" to="0.5" begin="0" duration="300" mode="linear"/>
				<animation property="scale" from="1" to="1.2" begin="200" duration="15000" mode="EaseOut" autoreverse="true"/>
				<animation property="x" from="0" to="-0.1" begin="200" duration="15000" mode="EaseOut" autoreverse="true"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="0" duration="1" mode="linear"/>
				<animation property="opacity" from="0" to="0.5" begin="0" duration="300" mode="linear"/>
				<animation property="scale" from="1" to="1.2" begin="200" duration="15000" mode="EaseOut" autoreverse="true"/>
				<animation property="x" from="0" to="-0.1" begin="200" duration="15000" mode="EaseOut" autoreverse="true"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="0" duration="1" mode="linear"/>
				<animation property="opacity" from="0" to="0.5" begin="0" duration="300" mode="linear"/>
				<animation property="scale" from="1" to="1.2" begin="200" duration="15000" mode="EaseOut" autoreverse="true"/>
				<animation property="x" from="0" to="-0.1" begin="200" duration="15000" mode="EaseOut" autoreverse="true"/>
			</storyboard>
		</image>
		<!-- ################################## Test jukeBox ######################################		 -->
		<image name="cdfond" extra="true">
			<path>${path_game_theme}/_genericdefault/_jukebox/cdfond.svg</path>
			<linearSmooth>true</linearSmooth>
			<maxSize>0.9 1</maxSize>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<zIndex>200</zIndex>
			<opacity>0.7</opacity>
		</image>
		<image name="test" extra="true">
			<path ifSubset="custombuilds:standardbuilds">firstfile({game:fanart},{game:screenshot},{game:image},{game:thumbnail},{game:boxart},"${path_syst_fanart}/fresh/${system.theme}.jpg")</path>
			<path ifSubset="custombuilds:retrofreshbat">firstfile({game:image},{game:fanart},{game:screenshot},{game:thumbnail},{game:boxart},"${path_syst_fanart}/fresh/${system.theme}.jpg")</path>
			<linearSmooth>true</linearSmooth>
			<size>0.96 0.96</size>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<zIndex>201</zIndex>
			<opacity>1</opacity>
			<saturation>0.2</saturation>
			<shader>
				<path>${path_com_shaders}/cd_disc.glsl</path>
				<radius>0.495</radius>
				<holeRadius>0.15</holeRadius>
				<scaleX>1</scaleX>
				<scaleY>1</scaleY>
				<offsetX>0.0</offsetX>
				<offsetY>0.0</offsetY>
				<borderWidth>0.000001</borderWidth>
				<centerRingWidth>0.000001</centerRingWidth>
			</shader>
		</image>
		<image name="cdcentre" extra="true">
			<path>${path_game_theme}/_genericdefault/_jukebox/cdcentre.svg</path>
			<linearSmooth>true</linearSmooth>
			<maxSize>0.9 1</maxSize>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<zIndex>202</zIndex>
		</image>
		<image name="cdtexte" extra="true">
			<path>${path_game_theme}/_genericdefault/_jukebox/cdtexte.png</path>
			<linearSmooth>true</linearSmooth>
			<maxSize>0.9 1</maxSize>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<zIndex>202</zIndex>
		</image>
		<control name="cdfond,test,cdcentre,cdtexte" extra="true">
			<offsetX>0.225</offsetX>
			<scale>0.9</scale>
			<storyboard event="open">
				<animation property="rotation" from="-360" begin="1500" duration="25000" mode="linear" repeat="forever"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="rotation" from="-360" begin="1500" duration="25000" mode="linear" repeat="forever"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="rotation" from="-360" begin="1500" duration="25000" mode="linear" repeat="forever"/>
			</storyboard>
		</control>
		
		
		
		<image name="parentaladvisory" extra="true">
			<path>${path_game_theme}/_genericdefault/_jukebox/Parental_Advisory_label.svg</path>
			<linearSmooth>true</linearSmooth>
			<pos>0.09 0.885648</pos>
			<size>0.1 0.112037</size>
			<origin>0 0.5</origin>
			<zIndex>203</zIndex>
			<opacity>1</opacity>
		</image>
		<image name="compactdisc" extra="true">
			<path>${path_game_theme}/_genericdefault/_jukebox/logocd.png</path>
			<linearSmooth>true</linearSmooth>
			<pos>0.5 0.886111</pos>
			<size>0.099479 0.087037</size>
			<origin>0 0.5</origin>
			<zIndex>203</zIndex>
			<opacity>1</opacity>
		</image>
			<image name="logocustshadowddejukebox" extra="true">
			<visible>${gamethemefile} == "" &amp;&amp; (!{game:folder} || !{game:system:collection})</visible>
			<maxSize>0.5 0.25</maxSize>
			<scaleOrigin>0 -0.3</scaleOrigin>
			<pos>0.098 0.183</pos>
			<origin>0 0.5</origin>
			<zIndex>900</zIndex>
			<color>000000</color>
			<path>{game:marquee}</path>
			<linearSmooth>true</linearSmooth>
			<horizontalAlignment>center</horizontalAlignment>
		</image>
			<image name="logocustshadowddejukeboxcollection" extra="true">
			<visible>${gamethemefile} == "" &amp;&amp; {game:folder} &amp;&amp; {game:system:collection}</visible>
			<maxSize>0.5 0.25</maxSize>
			<scaleOrigin>0 -0.3</scaleOrigin>
			<pos>0.098 0.183</pos>
			<origin>0 0.5</origin>
			<zIndex>900</zIndex>
			<color>000000</color>
			<path>firstfile(
			"${path_syst_logo}/clearlogos/lang-${lang}/" + {game:system:theme} + "-${lang}.png",
			"${path_syst_logo}/clearlogos/region-${region}/" + {game:system:theme} + "-${region}.png",
			"${path_syst_logo}/clearlogos/" + {game:system:theme} + ".png")</path>
			<linearSmooth>true</linearSmooth>
			<horizontalAlignment>center</horizontalAlignment>
		</image>
		<image name="logocustdejukebox" extra="true">
			<visible>${gamethemefile} == "" &amp;&amp; (!{game:folder} || !{game:system:collection})</visible>
			<maxSize>0.5 0.25</maxSize>
			<scaleOrigin>0 -0.3</scaleOrigin>
			<pos>0.1 0.18</pos>
			<origin>0 0.5</origin>
			<zIndex>901</zIndex>
			<path>{game:marquee}</path>
			<linearSmooth>true</linearSmooth>
			<horizontalAlignment>center</horizontalAlignment>
		</image>
		<image name="logocustdejukeboxcollection" extra="true">
			<visible>${gamethemefile} == "" &amp;&amp; {game:folder} &amp;&amp; {game:system:collection}</visible>
			<maxSize>0.5 0.25</maxSize>
			<scaleOrigin>0 -0.3</scaleOrigin>
			<pos>0.1 0.18</pos>
			<origin>0 0.5</origin>
			<zIndex>901</zIndex>
			<path>firstfile(
			"${path_syst_logo}/clearlogos/lang-${lang}/" + {game:system:theme} + "-${lang}.png",
			"${path_syst_logo}/clearlogos/region-${region}/" + {game:system:theme} + "-${region}.png",
			"${path_syst_logo}/clearlogos/" + {game:system:theme} + ".png")</path>
			<linearSmooth>true</linearSmooth>
			<horizontalAlignment>center</horizontalAlignment>
		</image>
		
		
		
		
		<image name="casefond" extra="true">
			<path>${path_game_theme}/_genericdefault/_jukebox/casefond.svg</path>
			<linearSmooth>true</linearSmooth>
			<maxSize>1 1</maxSize>
			<pos>0 0.52</pos>
			<origin>0 0.5</origin>
			<zIndex>203</zIndex>
			<opacity>1</opacity>
		</image>
		<image name="box" extra="true">
			<autoFade>false</autoFade>
			<path ifSubset="custombuilds:standardbuilds">{game:fanart}</path>
			<path ifSubset="custombuilds:retrofreshbat">{game:image}</path>
			<linearSmooth>true</linearSmooth>
			<maxSize>1 0.953</maxSize>
			<pos>0 0.5</pos>
			<origin>0 0.496</origin>
			<zIndex>203</zIndex>
			<saturation>1</saturation>
			<!-- <color>0000000</color> -->
			<clipRect>0.079 0 0.548 0</clipRect>
		</image>
		<image name="caseglass" extra="true">
			<path>${path_game_theme}/_genericdefault/_jukebox/caseglass.svg</path>
			<linearSmooth>true</linearSmooth>
			<maxSize>1 1</maxSize>
			<pos>0 0.52</pos>
			<origin>0 0.5</origin>
			<zIndex>205</zIndex>
			<opacity>1</opacity>
		</image>
	</customView>
</theme>
