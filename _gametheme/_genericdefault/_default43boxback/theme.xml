<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<customView name="hyperbat" displayName="${viewchoice.hyperbat}" inherits="gamecarousel">
		<!-- ######## Conditions de visibilité du theme generic : uniquement si pas de theme de jeu ni de theme defaut specific au système ############ -->
		<control name="screenshotgames,BackgrSyst,blur,blur1,blur2,fiberback,genericbezel,previewvid1,logocustshadow,logocust,boxartboxback,cartridge,boxback">
			<!-- !exists("${path_game_theme}/_groupedtheme/" + {game:system:theme} + "/hyperbat/" + stem({game:rom}) + "/theme.xml") &amp;&amp; -->
			<visible ifSubset="gameviewsource:actualsystem|mamefolder">${gamethemefile} == ""</visible>
			<!-- <visible ifSubset="gameviewsource:groupedsystem"> -->
			<!-- !exists("${path_game_theme}/_groupedtheme/" + {game:system:theme} + "/hyperbat/" + stem({game:rom}) + "/theme.xml") &amp;&amp; -->
			<!-- !exists("${path_game_theme}/mame/hyperbat/" + stem({game:rom}) + "/theme.xml") &amp;&amp; -->
			<!-- !exists("${path_game_theme}/" + {game:system:theme} + "/hyperbat/" + stem({game:rom}) + "/theme.xml") &amp;&amp; -->
			<!-- !exists("${path_game_theme}/" + {game:system:theme} + "/hyperbat/_default/theme.xml") &amp;&amp; -->
			<!-- !exists("${path_game_theme}/${system.theme}/hyperbat/_default/theme.xml")</visible> -->
		</control>
		<image name="BackgrSyst" extra="true">
			<path>firstfile(
			"${path_vgame}/hyperbat/fondsysteme/region-" + {game:region} + "/"  + ({game:system:theme}) + "-" + {game:region} + ".png",
			"${path_vgame}/hyperbat/fondsysteme/" + {game:system:theme} + ".png",
			"${path_syst_fanart}/fresh/" + {game:system:theme} + ".jpg")</path>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<size>1 1</size>
			<zIndex>0</zIndex>
			<linearSmooth>true</linearSmooth>
			<storyboard>
				<animation property="opacity" from="0" to="0" begin="0" duration="1" mode="linear"/>
				<animation property="opacity" from="0" to="1" begin="0" duration="300" mode="linear"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="0" duration="1" mode="linear"/>
				<animation property="opacity" from="0" to="1" begin="0" duration="300" mode="linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="0" duration="1" mode="linear"/>
				<animation property="opacity" from="0" to="1" begin="0" duration="300" mode="linear"/>
			</storyboard>
		</image>
		<screenshader name="blur" extra="true">
			<visible>!exists("${path_vgame}/hyperbat/fondsysteme/" + {game:system:theme} + ".png")</visible>
			<path>:/shaders/blur.glsl</path>
			<size>1 1</size>
			<pos>0 0</pos>
			<blur>15</blur>
			<zIndex>1</zIndex>
			<blurColor>000000</blurColor>
		</screenshader>
		<screenshader name="blur1" extra="true">
			<visible>!exists("${path_vgame}/hyperbat/fondsysteme/" + {game:system:theme} + ".png")</visible>
			<path>:/shaders/blur.glsl</path>
			<size>1 1</size>
			<pos>0 0</pos>
			<blur>8</blur>
			<zIndex>1</zIndex>
			<blurColor>000000</blurColor>
		</screenshader>
		<screenshader name="blur2" extra="true">
			<visible>!exists("${path_vgame}/hyperbat/fondsysteme/" + {game:system:theme} + ".png")</visible>
			<path>:/shaders/blur.glsl</path>
			<size>1 1</size>
			<pos>0 0</pos>
			<blur>6</blur>
			<zIndex>1</zIndex>
			<blurColor>000000</blurColor>
		</screenshader>
		<image name="screenshotgames" extra="true">
			<!-- <visible>!{game:folder} &amp;&amp;  -->
			<!-- !exists("${path_game_theme}/" + {game:system:theme} + "/hyperbat/" + stem({game:rom}) + "/theme.xml") &amp;&amp; -->
			<!-- !exists("${path_game_theme}/" + {game:system:theme} + "/hyperbat/_default/theme.xml") &amp;&amp; -->
			<!-- !exists("${path_game_theme}/${system.theme}/hyperbat/_default/theme.xml")</visible> -->
			<!-- <visible ifSubset="gameviewsource:mamefolder"> -->
			<!-- !exists("${path_game_theme}/mame/hyperbat/" + stem({game:rom}) + "/theme.xml") &amp;&amp; -->
			<!-- !{game:folder} &amp;&amp;  -->
			<!-- !exists("${path_game_theme}/" + {game:system:theme} + "/hyperbat/" + stem({game:rom}) + "/theme.xml") &amp;&amp; -->
			<!-- !exists("${path_game_theme}/" + {game:system:theme} + "/hyperbat/_default/theme.xml") &amp;&amp; -->
			<!-- !exists("${path_game_theme}/${system.theme}/hyperbat/_default/theme.xml")</visible> -->
			<path>{game:image}</path>
			<origin>0.5 0.5</origin>
			<pos>0.27 0.52</pos>
			<size>0.38 0.49</size>
			<size if="{system.theme} == 'ps3' 
			|| {system.theme} == 'xbox360'
			|| {system.theme} == 'psp'
			|| {system.theme} == 'psvita'
			|| {system.theme} == 'switch'
			|| {system.theme} == 'ps4'
			|| {system.theme} == 'ps5'
			|| {system.theme} == 'wiiu'
			|| {system.theme} == 'wii'
			|| {system.theme} == 'windows'
			|| {system.theme} == 'virtualboy'">0.5 0.49</size>
			<zIndex>500</zIndex>
			<scaleOrigin>0.15 0.15</scaleOrigin>
			<autoFade>false</autoFade>
			<storyboard event="open">
				<animation property="opacity" to="1" duration="" mode="linear"/>
				<animation enabled="exists({game:video})" property="opacity" to="0" begin="625" duration="350" mode="easeOut"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" to="1" duration="" mode="linear"/>
				<animation enabled="exists({game:video})" property="opacity" to="0" begin="625" duration="350" mode="easeOut"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" to="1" begin="" duration="" mode="easeIn"/>
				<animation enabled="exists({game:video})" property="opacity" to="0" begin="625" duration="350" mode="easeOut"/>
			</storyboard>
			<storyboard event="deactivateNext">
				<animation property="scale" from="1" to="1" begin="" duration="250" mode="linear"/>
				<animation property="opacity" to="0" begin="60" duration="" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="scale" from="1" to="1" begin="" duration="250" mode="linear"/>
				<animation property="opacity" to="0" begin="60" duration="" mode="easeIn"/>
			</storyboard>
		</image>
		<image name="fiberback" extra="true">
			<path>${path_vgame}/hyperbat/fondsysteme/fiber.png</path>
			<origin>0.5 0.5</origin>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<pos>0.27 0.52</pos>
			<size>0.39 0.5</size>
			<size if="{system.theme} == 'ps3' 
			|| {system.theme} == 'xbox360'
			|| {system.theme} == 'psp'
			|| {system.theme} == 'psvita'
			|| {system.theme} == 'switch'
			|| {system.theme} == 'ps4'
			|| {system.theme} == 'ps5'
			|| {system.theme} == 'wiiu'
			|| {system.theme} == 'wii'
			|| {system.theme} == 'windows'">0.5 0.5</size>
			<zIndex>199</zIndex>
		</image>
		<image name="genericbezel" extra="true">
			<path>./video.png</path>
			<linearSmooth>true</linearSmooth>
			<origin>0.5 0.5</origin>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<pos>0.27 0.52</pos>
			<size>0.42 0.54</size>
			<size if="{system.theme} == 'ps3' 
			|| {system.theme} == 'xbox360'
			|| {system.theme} == 'psp'
			|| {system.theme} == 'psvita'
			|| {system.theme} == 'switch'
			|| {system.theme} == 'ps4'
			|| {system.theme} == 'ps5'
			|| {system.theme} == 'wiiu'
			|| {system.theme} == 'wii'
			|| {system.theme} == 'windows'
			|| {system.theme} == 'virtualboy'">0.535 0.55</size>
			<zIndex>700</zIndex>
		</image>
		<video name="previewvid1" extra="true">
			<path>{game:video}</path>
			<origin>0.5 0.5</origin>
			<pos>0.27 0.52</pos>
			<size>0.38 0.49</size>
			<size if="{system.theme} == 'ps3' 
			|| {system.theme} == 'xbox360'
			|| {system.theme} == 'psp'
			|| {system.theme} == 'psvita'
			|| {system.theme} == 'switch'
			|| {system.theme} == 'ps4'
			|| {system.theme} == 'ps5'
			|| {system.theme} == 'wiiu'
			|| {system.theme} == 'wii'
			|| {system.theme} == 'windows'
			|| {system.theme} == 'virtualboy'">0.5 0.49</size>
			<zIndex>201</zIndex>
			<effect>none</effect>
			<delay>0.3</delay>
		</video>
		<video name="previewviddefault" extra="true">
			<visible>!exists({game:image}) &amp;&amp; !exists({game:video})</visible>
			<visible ifSubset="gameviewsource:actualsystem|mamefolder">${gamethemefile} == "" &amp;&amp; !exists({game:image}) &amp;&amp; !exists({game:video})</visible>
			<!-- <visible ifSubset="gameviewsource:groupedsystem"> -->
			<!-- !exists("${path_game_theme}/_groupedtheme/" + {game:system:theme} + "/hyperbat/" + stem({game:rom}) + "/theme.xml") &amp;&amp; -->
			<!-- !exists("${path_game_theme}/mame/hyperbat/" + stem({game:rom}) + "/theme.xml") &amp;&amp; -->
			<!-- !exists("${path_game_theme}/" + {game:system:theme} + "/hyperbat/" + stem({game:rom}) + "/theme.xml") &amp;&amp; -->
			<!-- !exists("${path_game_theme}/" + {game:system:theme} + "/hyperbat/_default/theme.xml") &amp;&amp; -->
			<!-- !exists("${path_game_theme}/${system.theme}/hyperbat/_default/theme.xml") &amp;&amp; -->
			<!-- !exists({game:image}) &amp;&amp; !exists({game:video})</visible> -->
			<path>firstfile("${path_syst_theme}/hyperpie/" + {game:stem} + ".mp4",
			"${videodefautpath}")</path>
			<origin>0.5 0.5</origin>
			<pos>0.27 0.52</pos>
			<size>0.38 0.49</size>
			<size if="{system.theme} == 'ps3' 
			|| {system.theme} == 'xbox360'
			|| {system.theme} == 'psp'
			|| {system.theme} == 'psvita'
			|| {system.theme} == 'switch'
			|| {system.theme} == 'ps4'
			|| {system.theme} == 'ps5'
			|| {system.theme} == 'wiiu'
			|| {system.theme} == 'wii'
			|| {system.theme} == 'windows'
			|| {system.theme} == 'virtualboy'">0.5 0.49</size>
			<zIndex>201</zIndex>
			<effect>none</effect>
			<delay>0.3</delay>
		</video>
		<image name="logocustshadow" extra="true">
			<path>firstfile("${path_syst_logo}/clearlogos/region-" + {game:region} + "/"  + ({game:system:theme}) + "-" + {game:region} + ".png",
			"${path_syst_logo}/clearlogos/lang-${lang}/" + ({game:system:theme}) + "-${lang}.png",
			"${path_syst_logo}/clearlogos/"  + ({game:system:theme}) + ".png")</path>
			<maxSize>0.5 0.25</maxSize>
			<scaleOrigin>0 -0.3</scaleOrigin>
			<pos>0.278 0.133</pos>
			<origin>0.5 0.5</origin>
			<zIndex>199</zIndex>
			<color>000000</color>
			<storyboard>
				<animation property="x" from="-0.5" begin="0" duration="2000" mode="easeOut"/>
				<animation property="opacity" from="0" to="1" duration="350" mode="linear"/>
			</storyboard>
		</image>
		<image name="logocust" extra="true">
			<path>firstfile("${path_syst_logo}/clearlogos/region-" + {game:region} + "/"  + ({game:system:theme}) + "-" + {game:region} + ".png",
			"${path_syst_logo}/clearlogos/lang-${lang}/" + ({game:system:theme}) + "-${lang}.png",
			"${path_syst_logo}/clearlogos/"  + ({game:system:theme}) + ".png")</path>
			<maxSize>0.5 0.25</maxSize>
			<scaleOrigin>0 -0.3</scaleOrigin>
			<pos>0.28 0.13</pos>
			<origin>0.5 0.5</origin>
			<zIndex>200</zIndex>
			<storyboard>
				<animation property="x" from="-0.5" begin="0" duration="2000" mode="easeOut"/>
				<animation property="opacity" from="0" to="1" duration="350" mode="linear"/>
			</storyboard>
		</image>
		<!-- ################################################################## gestion de la cartouche ou du CD ########################################### -->
		<image name="cartridge" extra="true">
			<path>{game:cartridge}</path>
			<linearSmooth>true</linearSmooth>
			<pos>0.85 0.52</pos>
			<pos if="{system.theme} == 'n64' 
		|| {system.theme} == 'snes'">0.85 0.6</pos>
			<origin>0.5 0.5</origin>
			<maxSize>0.4 0.4</maxSize>
			<maxSize if="{system.theme} == 'n64' 
		|| {system.theme} == 'n64dd'
		|| {system.theme} == 'snes'
		|| {system.theme} == 'mastersystem'
		|| {system.theme} == 'actionmax'
		|| {system.theme} == 'megadrive'
		|| {system.theme} == 'sega32x'">0.4 0.35</maxSize>
			<zIndex>349</zIndex>
			<storyboard event="open">
				<animation enabled="exists({game:boxback})" property="maxSize" from="" to="0.2 0.2" begin="500" duration="400" mode="EaseOut"/>
				<animation enabled="exists({game:boxback})" property="zIndex" from="" to="351" begin="" duration="" mode="linear"/>
				<animation enabled="exists({game:boxback})" property="pos" from="" to="0.9 0.75" begin="" duration="" mode="linear"/>
				<animation property="opacity" from="0" to="0" begin="0" duration="" mode="linear"/>
				<animation property="opacity" from="0" to="1" begin="2000" duration="500" mode="linear"/>
				<animation property="offsetX" from="0.5" begin="2000" duration="500" mode="linear"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation enabled="exists({game:boxback})" property="maxSize" from="" to="0.2 0.2" begin="500" duration="400" mode="EaseOut"/>
				<animation enabled="exists({game:boxback})" property="zIndex" from="" to="351" begin="" duration="" mode="linear"/>
				<animation enabled="exists({game:boxback})" property="pos" from="" to="0.9 0.75" begin="" duration="" mode="linear"/>
				<animation property="opacity" from="0" to="0" begin="0" duration="" mode="linear"/>
				<animation property="opacity" from="0" to="0" begin="0" duration="" mode="linear"/>
				<animation property="opacity" from="0" to="1" begin="2000" duration="500" mode="linear"/>
				<animation property="offsetX" from="0.5" begin="2000" duration="500" mode="linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation enabled="exists({game:boxback})" property="maxSize" from="" to="0.2 0.2" begin="500" duration="400" mode="EaseOut"/>
				<animation enabled="exists({game:boxback})" property="zIndex" from="" to="351" begin="" duration="" mode="linear"/>
				<animation enabled="exists({game:boxback})" property="pos" from="" to="0.9 0.75" begin="" duration="" mode="linear"/>
				<animation property="opacity" from="0" to="0" begin="0" duration="" mode="linear"/>
				<animation property="opacity" from="0" to="0" begin="0" duration="" mode="linear"/>
				<animation property="opacity" from="0" to="1" begin="2000" duration="500" mode="linear"/>
				<animation property="offsetX" from="0.5" begin="2000" duration="500" mode="linear"/>
			</storyboard>
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" duration="150" mode="linear"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" duration="150" mode="linear"/>
			</storyboard>
		</image>
		<control name="cartridge" extra="true" if="{system.theme} == 'dreamcast' 
		|| {system.theme} == 'ps2' 
		|| {system.theme} == '3do' 
		|| {system.theme} == 'gc' 
		|| {system.theme} == 'wii'  
		|| {system.theme} == 'ps3' 
		|| {system.theme} == 'amigacd32' 
		|| {system.theme} == 'cdi' 
		|| {system.theme} == 'neogeocd' 
		|| {system.theme} == 'pce-cd' 
		|| {system.theme} == 'pcfx' 
		|| {system.theme} == 'psx' 
		|| {system.theme} == 'saturn' 
		|| {system.theme} == 'segacd' 
		|| {system.theme} == 'xbox360'
		|| {system.theme} == 'xbox'">
			<storyboard event="open">
				<animation enabled="exists({game:boxback})" property="scale" from="" to="0.5" begin="500" duration="400" mode="EaseOut"/>
				<animation enabled="exists({game:boxback})" property="zIndex" from="" to="351" begin="" duration="" mode="linear"/>
				<animation enabled="exists({game:boxback})" property="pos" from="" to="0.9 0.75" begin="" duration="" mode="linear"/>
				<animation property="opacity" from="0" to="0" begin="0" duration="" mode="linear"/>
				<animation property="opacity" from="0" to="1" begin="1750" duration="500" mode="linear"/>
				<animation property="offsetX" from="1.5" begin="1750" duration="500" mode="linear"/>
				<animation property="rotation" from="-360" begin="2500" duration="2000" mode="EaseIn"/>
				<animation property="rotation" from="-360" begin="4500" duration="1000" mode="linear" repeat="forever"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation enabled="exists({game:boxback})" property="scale" from="" to="0.5" begin="500" duration="400" mode="EaseOut"/>
				<animation enabled="exists({game:boxback})" property="zIndex" from="" to="351" begin="" duration="" mode="linear"/>
				<animation enabled="exists({game:boxback})" property="pos" from="" to="0.9 0.75" begin="" duration="" mode="linear"/>
				<animation property="opacity" from="0" to="0" begin="0" duration="" mode="linear"/>
				<animation property="opacity" from="0" to="1" begin="1750" duration="500" mode="linear"/>
				<animation property="offsetX" from="1.5" begin="1750" duration="500" mode="linear"/>
				<animation property="rotation" from="-360" begin="2500" duration="5000" mode="EaseIn"/>
				<animation property="rotation" from="-360" begin="7500" duration="2900" mode="linear" repeat="forever"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation enabled="exists({game:boxback})" property="scale" from="" to="0.5" begin="500" duration="400" mode="EaseOut"/>
				<animation enabled="exists({game:boxback})" property="zIndex" from="" to="351" begin="" duration="" mode="linear"/>
				<animation enabled="exists({game:boxback})" property="pos" from="" to="0.9 0.75" begin="" duration="" mode="linear"/>
				<animation property="opacity" from="0" to="0" begin="0" duration="" mode="linear"/>
				<animation property="opacity" from="0" to="1" begin="1750" duration="500" mode="linear"/>
				<animation property="offsetX" from="1.5" begin="1750" duration="500" mode="linear"/>
				<animation property="rotation" from="-360" begin="2500" duration="5000" mode="EaseIn"/>
				<animation property="rotation" from="-360" begin="7500" duration="2900" mode="linear" repeat="forever"/>
			</storyboard>
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" duration="150" mode="linear"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" duration="150" mode="linear"/>
			</storyboard>
		</control>
		<!-- ################################################################### gestion de la boite de jeu ########################################################################## -->
		<!-- <subset name="boxorthumb" displayName="${boxorthumb}" appliesTo="hyperbat"> -->
		<!-- <include name="boxbackart" displayName="${boxbackart}"/> -->
		<!-- <include name="boxbackthumb" displayName="${boxbackthumb}"/> -->
		<!-- <include name="boxart" displayName="${boxart}"/> -->
		<!-- <include name="thumb" displayName="${thumb}"/> -->
		<!-- </subset> -->
		<image name="boxartboxback" ifSubset="boxorthumb:boxart" extra="true">
			<path>${box3dpath}</path>
			<origin>0 0.5</origin>
			<pos>0.7 0.516902872260</pos>
			<pos if="{system.theme} == 'ps3' 
			|| {system.theme} == 'xbox360'
			|| {system.theme} == 'psp'
			|| {system.theme} == 'psvita'
			|| {system.theme} == 'switch'
			|| {system.theme} == 'ps4'
			|| {system.theme} == 'ps5'
			|| {system.theme} == 'wiiu'
			|| {system.theme} == 'wii'
			|| {system.theme} == 'windows'
			|| {system.theme} == 'virtualboy'">0.75 0.516902872260</pos>
			<offsetX>-0.18</offsetX>
			<maxSize>0.3 0.6</maxSize>
			<zIndex>350</zIndex>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="0" duration="1" mode="linear"/>
				<animation property="opacity" from="0" to="1" begin="0" duration="300" mode="linear"/>
				<animation enabled="exists({game:boxback})" property="offsetX" from="-0.18" to="0" begin="1000" duration="400" mode="EaseOut"/>
				<animation enabled="!exists({game:boxback})" property="offsetX" from="-0.18" to="-0.12" begin="1000" duration="400" mode="EaseOut"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="0" duration="1" mode="linear"/>
				<animation property="opacity" from="0" to="1" begin="0" duration="300" mode="linear"/>
				<animation enabled="exists({game:boxback})" property="offsetX" from="-0.18" to="0" begin="1000" duration="400" mode="EaseOut"/>
				<animation enabled="!exists({game:boxback})" property="offsetX" from="-0.18" to="-0.12" begin="1000" duration="400" mode="EaseOut"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="0" duration="1" mode="linear"/>
				<animation property="opacity" from="0" to="1" begin="0" duration="300" mode="linear"/>
				<animation enabled="exists({game:boxback})" property="offsetX" from="-0.18" to="0" begin="1000" duration="400" mode="EaseOut"/>
				<animation enabled="!exists({game:boxback})" property="offsetX" from="-0.18" to="-0.12" begin="1000" duration="400" mode="EaseOut"/>
			</storyboard>
			<storyboard event="deactivateNext">
				<animation property="opacity" from="0" to="0" duration="" mode="linear"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" from="0" to="0" duration="" mode="linear"/>
			</storyboard>
		</image>
		<image name="boxartboxback" ifSubset="boxorthumb:thumb" extra="true">
			<path>${box2dpath}</path>
			<origin>0 0.5</origin>
			<pos>0.7 0.516902872260</pos>
			<pos if="{system.theme} == 'ps3' 
			|| {system.theme} == 'xbox360'
			|| {system.theme} == 'psp'
			|| {system.theme} == 'psvita'
