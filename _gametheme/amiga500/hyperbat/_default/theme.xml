		</control>
		<control name="Artwork1-amiga500, Artwork4-amiga500, screenshot-amiga500, gameplayprev-amiga500, Artwork2-amiga500, cartridge-amiga500">
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
		</control>
	</customView>
</theme>
