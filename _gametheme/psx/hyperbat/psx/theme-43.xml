<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- Correction 4:3 generee par Ratio themes le 2026-10-09 depuis theme.xml (hauteurs x0.75 autour de l'ancre) -->
	<include>./theme.xml</include>
	<customView name="hyperbat">
		<text name="gamethemeauthor" extra="true">
			<!-- storyboard neutre : garde l'element visible malgre l'include -->
			<storyboard event="activate">
				<animation property="opacity" from="1" to="1" duration="1" mode="linear"/>
			</storyboard>
		</text>
		<image name="background" extra="true">
			<!-- storyboard neutre : garde l'element visible malgre l'include -->
			<storyboard event="activate">
				<animation property="opacity" from="1" to="1" duration="1" mode="linear"/>
			</storyboard>
		</image>
		<image name="Videobezel" extra="true">
			<pos>0.5 0.567166666667</pos>
			<size>0.461458333333 0.49125</size>
		</image>
		<image name="Image_Vid" extra="true">
			<pos>0.5 0.5505</pos>
			<size>0.43 0.465</size>
		</image>
		<video name="PreviewVid" extra="true">
			<maxSize>0.46 0.4275</maxSize>
		</video>
		<image name="PreviewScreen" extra="true">
			<maxSize>0.46 0.4275</maxSize>
		</image>
		<image name="md_cartridge" extra="true">
			<!-- storyboard neutre : garde l'element visible malgre l'include -->
			<storyboard event="activate">
				<animation property="opacity" from="1" to="1" duration="1" mode="linear"/>
			</storyboard>
		</image>
		<image name="md_boxart" extra="true">
			<!-- storyboard neutre : garde l'element visible malgre l'include -->
			<storyboard event="activate">
				<animation property="opacity" from="1" to="1" duration="1" mode="linear"/>
			</storyboard>
		</image>
	</customView>
</theme>
