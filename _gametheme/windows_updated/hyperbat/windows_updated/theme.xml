<?xml version='1.0' encoding='utf-8'?>
<theme>
	<formatVersion>7</formatVersion>
	<customView name="hyperbat" displayName="${viewchoice.hyperbat}" inherits="gamecarousel">
		<image name="fanartflix" extra="true">
			<!-- <visible>${ifnoextsysthemeexist}</visible> -->
			<visible ifSubset="videofondcops1:hyperspinorunified">${ifnoextsysthemeexist}</visible>
			<autoFade>false</autoFade>
			<!-- <path ifSubset="imagefondcops1:fanartfreshone">${intfanartfresh}</path> -->
			<!-- <path ifSubset="imagefondcops1:fanartcustom">${intfanartfresh}</path> -->
			<!-- <path ifSubset="imagefondcops1:fanartcustom">${intfanartcustom}</path> -->
			<!-- <path ifSubset="imagefondcops1:fanartfreshone">("${path_syst_fanart}/fresh/" + {game:system:theme} + ".jpg")</path> -->
			<!-- <path ifSubset="imagefondcops1:fanartcustom">${path_syst_fanart}/fresh/" + {game:system:theme} + ".jpg"</path> -->
			<!-- <path ifSubset="imagefondcops1:fanartcustom">("${path_syst_fanart}/custom/" + {game:system:theme} + ".jpg")</path> -->
			<path>("${path_syst_fanart}/fresh/" + {game:system:theme} + ".jpg")</path>
			<origin>0 0</origin>
			<pos>-0.015 0</pos>
			<pos ifSubset="hyperwheel:verticalghjp">0 0</pos>
			<size>1.03 1.02</size>
			<zIndex>100</zIndex>
			<linearSmooth>false</linearSmooth>
		</image>
		<image name="righttart" extra="true">
			<visible ifSubset="videofondcops1:hyperspinorunified">${ifnoextsysthemeexist}</visible>
			<linearSmooth>true</linearSmooth>
			<size>0 0.9</size>
			<path>${path_syst_theme}/hyperspin/rightart/${system.theme}.png</path>
			<path>${path_syst_theme}/hyperspin/rightart/${system.theme}_left.png</path>
			<path>${path_syst_theme}/hyperspin/rightart/${system.theme}_right.png</path>
			<scaleOrigin>0 -0.3</scaleOrigin>
			<pos>0.85 0.515</pos>
			<pos ifHelpPrompts="false">0.85 0.55</pos>
			<origin>0.5 0.5</origin>
			<zIndex>200</zIndex>
			<storyboard event="open">
				<animation property="x" from="1.5" begin="0" duration="2000" mode="easeOut" />
				<animation property="opacity" from="0" to="1" duration="350" mode="linear" />
			</storyboard>
			<storyboard event="activateNext">
				<animation property="x" from="1.5" begin="0" duration="2000" mode="easeOut" />
				<animation property="opacity" from="0" to="1" duration="350" mode="linear" />
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="x" from="1.5" begin="0" duration="2000" mode="easeOut" />
				<animation property="opacity" from="0" to="1" duration="350" mode="linear" />
			</storyboard>
		</image>
		<image name="fondecransmall" ifSubset="videofondcops1:hyperspin|hyperspinorunified" extra="true">
			<visible ifSubset="videofondcops1:hyperspinorunified">${ifnoextsysthemeexist}</visible>
			<origin>0.52 0.5</origin>
			<path>${comcadre169}</path>
			<size>0.66 0.72</size>
			<pos>0.5 0.55</pos>
			<linearSmooth>true</linearSmooth>
			<zIndex>210</zIndex>
			<storyboard event="open">
				<animation property="y" from="0.45" duration="350" mode="easeOut" />
				<animation property="opacity" from="0" to="1" duration="550" mode="easeIn" />
				<animation property="scale" from="0" to="1" duration="350" mode="easeOut" />
			</storyboard>
			<storyboard event="activateNext">
				<animation property="y" from="0.45" duration="350" mode="easeOut" />
				<animation property="opacity" from="0" to="1" duration="550" mode="easeIn" />
				<animation property="scale" from="0" to="1" duration="350" mode="easeOut" />
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="y" from="0.45" duration="350" mode="easeOut" />
				<animation property="opacity" from="0" to="1" duration="550" mode="easeIn" />
				<animation property="scale" from="0" to="1" duration="350" mode="easeOut" />
			</storyboard>
		</image>
		<video name="PreviewVid" extra="true">
			<visible ifSubset="videofondcops1:hyperspinorunified">${ifnoextsysthemeexist}</visible>
			<path>${extsubsystvideo}</path>
			<maxSize>0.5 0.52</maxSize>
			<pos>0.5 0.55</pos>
			<origin>0.5 0.5</origin>
			<delay>0.2</delay>
			<showSnapshotNoVideo>true</showSnapshotNoVideo>
			<showSnapshotDelay>true</showSnapshotDelay>
			<zIndex>220</zIndex>
			<effect>none</effect>
		</video>
		<image name="PreviewScreen" extra="true">
			<visible>${ifnosubsystvideo}</visible>
			<path>${extsubsystimage}</path>
			<size>0.5 0.52</size>
			<pos>0.5 0.55</pos>
			<origin>0.5 0.5</origin>
			<showSnapshotNoVideo>true</showSnapshotNoVideo>
			<showSnapshotDelay>true</showSnapshotDelay>
			<zIndex>220</zIndex>
			<effect>none</effect>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="200" duration="500" mode="Linear" />
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="200" duration="500" mode="Linear" />
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="200" duration="500" mode="Linear" />
			</storyboard>
		</image>
		<image name="Videobezel" ifSubset="videofondcops1:hyperspin|hyperspinorunified" extra="true">
			<visible ifSubset="videofondcops1:hyperspinorunified">${ifnoextsysthemeexist}</visible>
			<origin>0.5 0.5</origin>
			<path>firstfile(
					"${path_syst_bezel}/region-${region}/" + {game:system:theme} + "-${region}.png",
					"${path_syst_bezel}/" + ({game:system:theme}) + ".png")</path>
			<maxSize>0.52 0.52</maxSize>
			<pos>0.5 0.55</pos>
			<linearSmooth>true</linearSmooth>
			<zIndex>230</zIndex>
			<storyboard event="open">
				<animation property="opacity" from="0" to="1" duration="550" mode="easeIn" />
				<animation property="scale" from="0" to="1" duration="350" mode="easeOut" />
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="1" duration="550" mode="easeIn" />
				<animation property="scale" from="0" to="1" duration="350" mode="easeOut" />
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="1" duration="550" mode="easeIn" />
				<animation property="scale" from="0" to="1" duration="350" mode="easeOut" />
			</storyboard>
		</image>
		<image name="logocustomunified" extra="true">
			<visible ifSubset="videofondcops1:hyperspinorunified">${ifnoextsysthemeexist}</visible>
			<path>${intlogoclearpng}</path>
			<path region="fr">${intlogoclearfrpng}</path>
			<path region="eu">${intlogoclearfrpng}</path>
			<path region="us">${intlogoclearuspng}</path>
			<path region="jp">${intlogoclearjppng}</path>
			<maxSize>0.5 0.25</maxSize>
			<scaleOrigin>0 -0.3</scaleOrigin>
			<pos>0.5 0.15</pos>
			<origin>0.5 0.5</origin>
			<zIndex>240</zIndex>
			<storyboard event="open">
				<animation property="y" from="-0.5" begin="0" duration="2000" mode="easeOut" />
				<animation property="opacity" from="0" to="1" duration="350" mode="linear" />
			</storyboard>
			<storyboard event="activateNext">
				<animation property="y" from="-0.5" begin="0" duration="2000" mode="easeOut" />
				<animation property="opacity" from="0" to="1" duration="350" mode="linear" />
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="y" from="-0.5" begin="0" duration="2000" mode="easeOut" />
				<animation property="opacity" from="0" to="1" duration="350" mode="linear" />
			</storyboard>
		</image>
		<image name="leftart" extra="true">
			<visible ifSubset="videofondcops1:hyperspinorunified">${ifnoextsysthemeexist}</visible>
			<linearSmooth>true</linearSmooth>
			<size>0 0.9</size>
			<path>${path_syst_theme}/hyperspin/leftart/${system.theme}.png</path>
			<path>${path_syst_theme}/hyperspin/leftart/${system.theme}_right.png</path>
			<path>${path_syst_theme}/hyperspin/leftart/${system.theme}_left.png</path>
			<scaleOrigin>0 -0.3</scaleOrigin>
			<pos>0.15 0.515</pos>
			<pos ifHelpPrompts="false">0.15 0.55</pos>
			<origin>0.5 0.5</origin>
			<zIndex>250</zIndex>
			<storyboard event="open">
				<animation property="x" from="-0.5" begin="0" duration="2000" mode="easeOut" />
				<animation property="opacity" from="0" to="1" duration="350" mode="linear" />
			</storyboard>
			<storyboard event="activateNext">
				<animation property="x" from="-0.5" begin="0" duration="2000" mode="easeOut" />
				<animation property="opacity" from="0" to="1" duration="350" mode="linear" />
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="x" from="-0.5" begin="0" duration="2000" mode="easeOut" />
				<animation property="opacity" from="0" to="1" duration="350" mode="linear" />
			</storyboard>
		</image>
		<image name="md_cartridge" extra="true">
			<visible>false</visible>
			<zIndex>260</zIndex>
		</image>
		<image name="md_boxart" extra="true">
			<visible>false</visible>
			<zIndex>260</zIndex>
		</image>
		<control name="PreviewScreen, PreviewVid, Videobezel, fondecransmall, leftart, logocustomunified, righttart">
			<storyboard event="deactivateNext">
				<animation property="scale" to="3" begin="" autoreverse="false" duration="200" mode="easyIn" />
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear" />
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="scale" to="3" begin="" autoreverse="false" duration="200" mode="easyIn" />
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear" />
			</storyboard>
		</control>
	</customView>
</theme>