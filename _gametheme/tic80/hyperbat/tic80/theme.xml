<?xml version='1.0' encoding='utf-8'?>
<theme>
	<formatVersion>7</formatVersion>
	<customView name="hyperbat" displayName="${viewchoice.hyperbat}" inherits="gamecarousel">
		<image name="Background" extra="true">
			<path>"${path_syst_theme}/hyperspinxp/" + {game:system:theme} + "/3.png"</path>
			<origin>0.5 0.5</origin>
			<pos>0.531565656566 0.641227085672</pos>
			<size>1.078282828283 1.333333333333</size>
			<zIndex>100</zIndex>
		</image>
		<image name="1" extra="true">
			<path>"${path_syst_theme}/hyperspinxp/" + {game:system:theme} + "/1.png"</path>
			<origin>0.5 0.5</origin>
			<pos>0.774184553872 0.573138795361</pos>
			<size>0.449042508418 0.766180321736</size>
			<zIndex>200</zIndex>
			<linearSmooth>true</linearSmooth>
			<shader>
				<path>:/shaders/pixelate.glsl</path>
				<pixelSize>80</pixelSize>
			</shader>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="300" duration="1000" mode="easeIn" />
				<animation property="shader.pixelSize" from="80" to="0" begin="300" duration="1200" mode="easeOut" />
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="300" duration="1000" mode="easeIn" />
				<animation property="shader.pixelSize" from="80" to="0" begin="300" duration="1200" mode="easeOut" />
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="300" duration="1000" mode="easeIn" />
				<animation property="shader.pixelSize" from="80" to="0" begin="300" duration="1200" mode="easeOut" />
			</storyboard>
		</image>
		<image name="2" extra="true">
			<path>"${path_syst_theme}/hyperspinxp/" + {game:system:theme} + "/2.png"</path>
			<origin>0.5 0.5</origin>
			<pos>0.516940235690 0.138421249532</pos>
			<size>0.562500000000 0.345679012346</size>
			<zIndex>210</zIndex>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="250" duration="1000" mode="Linear" />
				<animation property="offsetY" from="-1" to="0" duration="4000" mode="EaseOutQuint" />
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="250" duration="1000" mode="Linear" />
				<animation property="offsetY" from="-1" to="0" duration="4000" mode="EaseOutQuint" />
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="250" duration="1000" mode="Linear" />
				<animation property="offsetY" from="-1" to="0" duration="4000" mode="EaseOutQuint" />
			</storyboard>
		</image>
		<video name="PreviewVid" extra="true">
			<path>${extsubsystvideo}</path>
			<pos>0.321969696970 0.56</pos>
			<maxSize>0.428451178451 0.615039281706</maxSize>
			<origin>0.5 0.5</origin>
			<zIndex>220</zIndex>
			<delay>0.4</delay>
			<effect>none</effect>
			<rotationOrigin>0.5 0.5</rotationOrigin>
		</video>
		<image name="PreviewScreen" extra="true">
			<visible>${ifnosubsystvideo}</visible>
			<path>${extsubsystimage}</path>
			<pos>0.321969696970 0.56</pos>
			<maxSize>0.428451178451 0.615039281706</maxSize>
			<origin>0.5 0.5</origin>
			<zIndex>220</zIndex>
			<effect>none</effect>
