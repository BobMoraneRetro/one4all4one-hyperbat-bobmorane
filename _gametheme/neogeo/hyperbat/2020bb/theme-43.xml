<?xml version="1.0" encoding="UTF-8"?>
<theme defaultView="hyperbat">
	<formatVersion>7</formatVersion>
	<include>./theme.xml</include>
	<view name="detailed, gamecarousel">
		<!-- storyboard neutre : rend l'element visible malgre l'include -->
		<image name="Background" extra="true">
			<storyboard event="activate">
				<animation property="opacity" from="1" to="1" duration="1" mode="linear"/>
			</storyboard>
		</image>
		<image name="Videobezel" extra="true">
			<size>0.3875 0.388888888888889</size>
			<storyboard event="activate">
				<animation property="opacity" from="1" to="1" duration="1" mode="linear"/>
			</storyboard>
		</image>
		<image name="Artwork4" extra="true">
			<size>0.258333333333333 0.347222222222222</size>
		</image>
		<video name="PreviewVid" extra="true">
			<maxSize>0.46 0.375</maxSize>
			<minSize>0.375 0.375</minSize>
		</video>
	</view>
</theme>