<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- Correction 4:3 generee par Ratio themes le 2026-10-09 depuis theme.xml (hauteurs x0.75 autour de l'ancre) -->
	<include>./theme.xml</include>
	<customView name="hyperbat">
		<image name="Background" extra="true">
			<!-- storyboard neutre : garde l'element visible malgre l'include -->
			<storyboard event="activate">
				<animation property="opacity" from="1" to="1" duration="1" mode="linear"/>
			</storyboard>
		</image>
		<image name="Particle" extra="true">
			<size>0.1036295945 0.13695002459</size>
			<!-- storyboard "activateNext" corrige -->
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="250" duration="500" mode="Linear" />
				<animation property="offsetX" from="1.9" to="0" begin="0" duration="1500" mode="linear" />
				<animation property="offsetX" from="0" to="-0.1" begin="1000" duration="4000" autoreverse="true" repeat="forever" mode="easein" />
				<animation property="offsetY" from="0" to="-0.075" begin="1500" duration="2500" autoreverse="true" repeat="forever" mode="easeout" />
			</storyboard>
			<!-- storyboard "activatePrev" corrige -->
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="250" duration="500" mode="Linear" />
				<animation property="offsetX" from="1.9" to="0" begin="0" duration="1500" mode="linear" />
				<animation property="offsetX" from="0" to="-0.1" begin="1000" duration="4000" autoreverse="true" repeat="forever" mode="easein" />
				<animation property="offsetY" from="0" to="-0.075" begin="1500" duration="2500" autoreverse="true" repeat="forever" mode="easeout" />
			</storyboard>
			<!-- storyboard "open" corrige -->
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="250" duration="500" mode="Linear" />
				<animation property="offsetX" from="1.9" to="0" begin="0" duration="1500" mode="linear" />
				<animation property="offsetX" from="0" to="-0.1" begin="1000" duration="4000" autoreverse="true" repeat="forever" mode="easein" />
				<animation property="offsetY" from="0" to="-0.075" begin="1500" duration="2500" autoreverse="true" repeat="forever" mode="easeout" />
			</storyboard>
		</image>
		<image name="md_cartridge" extra="true">
			<!-- storyboard neutre : garde l'element visible malgre l'include -->
			<storyboard event="activate">
				<animation property="opacity" from="1" to="1" duration="1" mode="linear"/>
			</storyboard>
		</image>
		<image name="md_boxart" extra="true">
			<!-- storyboard neutre : garde l'element visible malgre l'include -->
			<storyboard event="activate">
				<animation property="opacity" from="1" to="1" duration="1" mode="linear"/>
			</storyboard>
		</image>
		<text name="gamethemeauthor" extra="true">
			<!-- storyboard neutre : garde l'element visible malgre l'include -->
			<storyboard event="activate">
				<animation property="opacity" from="1" to="1" duration="1" mode="linear"/>
			</storyboard>
		</text>
	</customView>
</theme>
