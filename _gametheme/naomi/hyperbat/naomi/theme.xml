			<visible>${ifnosubsystvideo}</visible>
			<path>${extsubsystimage}</path>
			<maxSize>0.47 0.65</maxSize>
			<origin>0.5 0.5</origin>
			<showSnapshotNoVideo>false</showSnapshotNoVideo>
			<showSnapshotDelay>false</showSnapshotDelay>
			<effect>none</effect>
			<pos>0.500520833333333 0.52</pos>
			<zIndex>220</zIndex>
			<shader>
				<path>:/shaders/border.glsl</path>
				<cornerRadius>0.05</cornerRadius>
				<borderSize>0.015</borderSize>
