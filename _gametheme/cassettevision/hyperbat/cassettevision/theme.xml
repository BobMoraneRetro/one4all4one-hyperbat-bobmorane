<?xml version='1.0' encoding='utf-8'?>
<theme>
	<formatVersion>7</formatVersion>
	<customView name="hyperbat" displayName="${viewchoice.hyperbat}" inherits="gamecarousel">
		<image name="Background" extra="true">
			<path>"${path_syst_theme}/hyperspinxp/" + {game:system:theme} + "/Background.png"</path>
			<origin>0.5 0.5</origin>
			<pos>0.500841750842 0.665170220726</pos>
			<size>1.000000000000 1.333333333333</size>
			<zIndex>100</zIndex>
		</image>
		<image name="Artwork1" extra="true">
			<path>"${path_syst_theme}/hyperspinxp/" + {game:system:theme} + "/Artwork1.png"</path>
			<origin>0.5 0.5</origin>
			<pos>0.741948127104 0.172610362888</pos>
			<size>0.229687500000 0.360185185185</size>
			<zIndex>200</zIndex>
			<linearSmooth>true</linearSmooth>
			<shader>
				<path>:/shaders/pixelate.glsl</path>
				<pixelSize>80</pixelSize>
			</shader>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="300" duration="1000" mode="easeIn" />
				<animation property="shader.pixelSize" from="80" to="0" begin="300" duration="1200" mode="easeOut" />
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="300" duration="1000" mode="easeIn" />
				<animation property="shader.pixelSize" from="80" to="0" begin="300" duration="1200" mode="easeOut" />
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="300" duration="1000" mode="easeIn" />
				<animation property="shader.pixelSize" from="80" to="0" begin="300" duration="1200" mode="easeOut" />
			</storyboard>
		</image>
		<video name="PreviewVid" extra="true">
			<path>${extsubsystvideo}</path>
			<pos>0.751959701178 0.527861952862</pos>
			<maxSize>0.434895833333 0.705555555556</maxSize>
			<origin>0.5 0.5</origin>
			<zIndex>210</zIndex>
			<delay>0.4</delay>
			<effect>none</effect>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<rotation>5</rotation>
			<shader>
				<path>${path_com_shaders}/border_multi_gradient.glsl</path>
				<cornerRadius>0.00</cornerRadius>
				<innerShadowSize>0.01</innerShadowSize>
				<innerShadowColor>00000030</innerShadowColor>
				<outerShadowSize>0.020</outerShadowSize>
				<outerShadowColor>00000050</outerShadowColor>
				<gradientMode>4</gradientMode>
				<saturation />
				<borderSize>0.005</borderSize>
				<borderColor>000000</borderColor>
				<borderColorStart />
				<borderColorEnd />
				<borderSize2>0.010</borderSize2>
				<borderColor2>ffffff</borderColor2>
				<borderColorStart2>000000</borderColorStart2>
				<borderColorEnd2>ffffff</borderColorEnd2>
				<borderSize3>0.005</borderSize3>
				<borderColor3>000000FF</borderColor3>
				<borderColorStart3 />
				<borderColorEnd3 />
			</shader>
		</video>
		<image name="PreviewScreen" extra="true">
			<visible>${ifnosubsystvideo}</visible>
			<path>${extsubsystimage}</path>
			<pos>0.751959701178 0.527861952862</pos>
			<maxSize>0.434895833333 0.705555555556</maxSize>
			<origin>0.5 0.5</origin>
			<zIndex>210</zIndex>
			<effect>none</effect>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<rotation>5</rotation>
			<shader>
				<path>${path_com_shaders}/border_multi_gradient.glsl</path>
				<cornerRadius>0.00</cornerRadius>
				<innerShadowSize>0.01</innerShadowSize>
				<innerShadowColor>00000030</innerShadowColor>
				<outerShadowSize>0.020</outerShadowSize>
				<outerShadowColor>00000050</outerShadowColor>
				<gradientMode>4</gradientMode>
				<saturation />
				<borderSize>0.005</borderSize>
				<borderColor>000000</borderColor>
				<borderColorStart />
				<borderColorEnd />
				<borderSize2>0.010</borderSize2>
				<borderColor2>ffffff</borderColor2>
				<borderColorStart2>000000</borderColorStart2>
				<borderColorEnd2>ffffff</borderColorEnd2>
				<borderSize3>0.005</borderSize3>
				<borderColor3>000000FF</borderColor3>
				<borderColorStart3 />
				<borderColorEnd3 />
			</shader>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="400" duration="500" mode="Linear" />
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="400" duration="500" mode="Linear" />
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="400" duration="500" mode="Linear" />
			</storyboard>
		</image>
		<image name="Artwork2" extra="true">
			<path>"${path_syst_theme}/hyperspinxp/" + {game:system:theme} + "/Artwork2.png"</path>
			<origin>0.5 0.5</origin>
			<pos>0.264309764310 0.616400112233</pos>
			<size>0.513468013468 0.712037037037</size>
			<zIndex>220</zIndex>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="1000" duration="1200" mode="Linear" />
				<animation property="offsetX" from="-1" to="0" begin="1000" duration="1200" mode="Linear" />
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="1000" duration="1200" mode="Linear" />
				<animation property="offsetX" from="-1" to="0" begin="1000" duration="1200" mode="Linear" />
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="1000" duration="1200" mode="Linear" />
				<animation property="offsetX" from="-1" to="0" begin="1000" duration="1200" mode="Linear" />
			</storyboard>
		</image>
		<image name="Artwork3" extra="true">
			<path>"${path_syst_theme}/hyperspinxp/" + {game:system:theme} + "/Artwork3.png"</path>
			<origin>0.5 0.5</origin>
			<pos>0.224389730640 0.147297044519</pos>
			<size>0.320833333333 0.279629629630</size>
			<zIndex>230</zIndex>
			<linearSmooth>true</linearSmooth>
			<shader>
				<path>:/shaders/wave.glsl</path>
				<waveTime>0</waveTime>
			</shader>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="850" duration="1000" mode="Linear" />
				<animation property="offsetX" from="-1" to="0" begin="850" duration="2500" mode="easeOut" />
				<animation property="shader.waveTime" from="0" to="5" begin="1500" duration="2000" mode="easeOut" />
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="850" duration="1000" mode="Linear" />
				<animation property="offsetX" from="-1" to="0" begin="850" duration="2500" mode="easeOut" />
				<animation property="shader.waveTime" from="0" to="5" begin="1500" duration="2000" mode="easeOut" />
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="850" duration="1000" mode="Linear" />
				<animation property="offsetX" from="-1" to="0" begin="850" duration="2500" mode="easeOut" />
				<animation property="shader.waveTime" from="0" to="5" begin="1500" duration="2000" mode="easeOut" />
			</storyboard>
		</image>
		<text name="gamethemeauthor" extra="true">
			<text>Theme by : Finch</text>
		</text>
		<image name="md_cartridge" extra="true">
			<visible>false</visible>
			<zIndex>240</zIndex>
		</image>
		<image name="md_boxart" extra="true">
			<visible>false</visible>
			<zIndex>240</zIndex>
		</image>
		<control name="Artwork1, Artwork2, Artwork3, PreviewScreen, PreviewVid">
			<storyboard event="deactivateNext">
				<animation property="scale" to="3" begin="" autoreverse="false" duration="200" mode="easyIn" />
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear" />
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="scale" to="3" begin="" autoreverse="false" duration="200" mode="easyIn" />
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear" />
			</storyboard>
		</control>
	</customView>
</theme>