<?xml version='1.0' encoding='utf-8'?>
<theme>
	<formatVersion>7</formatVersion>
	<customView name="hyperbat" displayName="${viewchoice.hyperbat}" inherits="gamecarousel">
		<image name="Background" extra="true">
			<path>"${path_syst_theme}/hyperspinxp/" + {game:system:theme} + "/Background.png"</path>
			<origin>0.5 0.5</origin>
			<pos>0.492424242424 0.499064721287</pos>
			<size>1.038720538721 1.025065469510</size>
			<zIndex>100</zIndex>
		</image>
		<image name="Image-video" extra="true">
			<path>"${path_syst_theme}/hyperspinxp/" + {game:system:theme} + "/Image-video.png"</path>
			<origin>0.5 0.5</origin>
			<pos>0.297 0.306</pos>
			<size>0.349 0.48</size>
			<zIndex>200</zIndex>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="400" duration="400" mode="Linear" />
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="400" duration="400" mode="Linear" />
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="400" duration="400" mode="Linear" />
			</storyboard>
		</image>
		<video name="PreviewVid" extra="true">
			<path>${extsubsystvideo}</path>
			<pos>0.297 0.304</pos>
			<maxSize>0.347 0.48</maxSize>
			<origin>0.5 0.5</origin>
			<zIndex>210</zIndex>
			<delay>0.4</delay>
			<effect>none</effect>
			<rotationOrigin>0.5 0.5</rotationOrigin>
		</video>
		<image name="PreviewScreen" extra="true">
			<visible>${ifnosubsystvideo}</visible>
			<path>${extsubsystimage}</path>
			<pos>0.297 0.304</pos>
			<maxSize>0.347 0.48</maxSize>
			<origin>0.5 0.5</origin>
			<zIndex>210</zIndex>
			<effect>none</effect>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="400" duration="500" mode="Linear" />
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="400" duration="500" mode="Linear" />
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="400" duration="500" mode="Linear" />
			</storyboard>
		</image>
		<image name="Video" extra="true">
			<path>"${path_syst_theme}/hyperspinxp/" + {game:system:theme} + "/Video.png"</path>
			<origin>0.5 0.5</origin>
			<pos>0.3 0.3</pos>
			<size>0.501678240741 0.676524504302</size>
			<zIndex>220</zIndex>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="400" duration="400" mode="Linear" />
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="400" duration="400" mode="Linear" />
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="400" duration="400" mode="Linear" />
			</storyboard>
		</image>
		<image name="Artwork1" extra="true">
			<path>"${path_syst_theme}/hyperspinxp/" + {game:system:theme} + "/Artwork1_new.png"</path>
			<origin>0.5 0.5</origin>
			<pos>0.55 0.7</pos>
			<maxSize>0.8 1</maxSize>
