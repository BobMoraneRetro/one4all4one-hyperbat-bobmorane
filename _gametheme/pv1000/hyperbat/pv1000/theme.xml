				<animation property="opacity" from="0" to="1" begin="1000" duration="1000" mode="Linear" />
				<animation property="offsetX" from="1" to="0" begin="1000" duration="1000" mode="Linear" />
			</storyboard>
		</image>
		<image name="Artwork2" extra="true">
			<path>"${path_syst_theme}/hyperspinxp/" + {game:system:theme} + "/Artwork2.png"</path>
			<origin>0.5 0.5</origin>
			<pos>0.75 0.2</pos>
			<size>0.360269360269 0.279358398803</size>
			<zIndex>240</zIndex>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
