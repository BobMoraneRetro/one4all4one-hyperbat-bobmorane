<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<customView name="hyperbat" displayName="${viewchoice.hyperbat}" inherits="gamecarousel">
		<image name="Background-gbc" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'gbc'</visible>
			<path>./Background.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.500000000000 0.500000000000</pos>
			<size>1.000000000000 1.000000000000</size>
			<zIndex>100</zIndex>
		</image>
		<image name="Backscreen-gbc" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'gbc'</visible>
			<path>./Backscreen.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.245572916667 0.260185185185</pos>
			<size>0.188020833333 0.301851851852</size>
			<zIndex>200</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="screenshotgbc" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'gbc'</visible>
			<path>{game:image}</path>
			<origin>0.5 0.5</origin>
			<pos>0.245920138889 0.259413580247</pos>
			<size>0.225 0.299074074074</size>
			<zIndex>209</zIndex>
			<autoFade>false</autoFade>
		</image>
		<video name="gameplayprev-gbc" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'gbc'</visible>
			<path>{game:video}</path>
			<origin>0.5 0.5</origin>
			<pos>0.245920138889 0.259413580247</pos>
			<size>0.186979166667 0.299074074074</size>
			<zIndex>210</zIndex>
			<effect>none</effect>
			<delay>0.5</delay>
		</video>
		<image name="Video-gbc" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'gbc'</visible>
			<path>./Video.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.247135416667 0.508333333333</pos>
			<size>0.324479166667 0.983333333333</size>
			<zIndex>220</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="Led-gbc" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'gbc'</visible>
			<path>./Led.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.118229166667 0.199537037037</pos>
			<size>0.011458333333 0.019444444444</size>
			<zIndex>230</zIndex>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1000" duration="100" mode="Linear"/>
				<animation property="scale" to="1" begin="1000" duration="100" autoreverse="false" mode="linear"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1000" duration="100" mode="Linear"/>
				<animation property="scale" to="1" begin="1000" duration="100" autoreverse="false" mode="linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1000" duration="100" mode="Linear"/>
				<animation property="scale" to="1" begin="1000" duration="100" autoreverse="false" mode="linear"/>
			</storyboard>
		</image>
		<image name="Artwork1-gbc" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'gbc'</visible>
			<path>./Artwork1.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.736458333333 0.144444444444</pos>
			<size>0.341666666667 0.255555555556</size>
			<zIndex>240</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="Support-gbc" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'gbc'</visible>
			<path>{game:cartridge}</path>
			<origin>0.5 0.5</origin>
			<pos>0.863311589806 0.738201186624</pos>
			<size>0.168229166667 0.347222222222</size>
			<zIndex>260</zIndex>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="450" duration="500" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="450" duration="1000" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="450" duration="1000" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" begin="450" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
		</image>
		<image name="Boxart-gbc" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'gbc'</visible>
			<path ifSubset="boxorthumb:thumb">firstfile(${box2dpath},${box3dpath})</path>
			<path ifSubset="boxorthumb:boxart">firstfile(${box3dpath},${box2dpath})</path>
			<origin>0.5 0.5</origin>
			<pos>0.665104166667 0.611574074074</pos>
			<maxSize>0.277083333333 0.647222222222</maxSize>
			<zIndex>250</zIndex>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="450" duration="500" mode="Linear"/>
				<animation property="offsetY" from="-1" to="0" begin="450" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="450" duration="1000" mode="Linear"/>
				<animation property="offsetY" from="-1" to="0" begin="450" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="450" duration="1000" mode="Linear"/>
				<animation property="offsetY" from="-1" to="0" begin="450" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
		</image>
		<!-- <control name="Backscreen-gbc, Calque 1-gbc, Artwork1-gbc"> -->
			<!-- <storyboard event="deactivateNext"> -->
				<!-- <animation property="scale" to="3" begin="" autoreverse="false" duration="200" mode="easyIn"/> -->
				<!-- <animation property="opacity" to="0" begin="100" duration="150" mode="linear"/> -->
			<!-- </storyboard> -->
			<!-- <storyboard event="deactivatePrev"> -->
				<!-- <animation property="scale" to="3" begin="" autoreverse="false" duration="200" mode="easyIn"/> -->
				<!-- <animation property="opacity" to="0" begin="100" duration="150" mode="linear"/> -->
			<!-- </storyboard> -->
		<!-- </control> -->
		<control name="gameplayprev-gbc, Led-gbc, Boxart-gbc, Support-gbc">
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
		</control>
		<text name="defaultthemeauthor" extra="true">
			<text>Theme default by : Akeshi</text>
		</text>
	</customView>
</theme>
