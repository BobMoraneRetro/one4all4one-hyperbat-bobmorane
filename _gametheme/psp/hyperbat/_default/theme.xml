<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<customView name="hyperbat" displayName="${viewchoice.hyperbat}" inherits="gamecarousel">
		<image name="Background-psp" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'psp'</visible>
			<path>./Background.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.500000000000 0.500000000000</pos>
			<size>1.000000000000 1.000000000000</size>
			<zIndex>100</zIndex>
		</image>
		<image name="Artwork1-psp" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'psp'</visible>
			<path>./Artwork1.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.331770833333 0.183796296296</pos>
			<size>0.368750000000 0.213888888889</size>
			<zIndex>210</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="Support-psp" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'psp'</visible>
			<path>{game:cartridge}</path>
			<origin>0.5 0.5</origin>
			<pos>0.909895833333 0.753703703704</pos>
			<size>0.136458333333 0.244444444444</size>
			<zIndex>230</zIndex>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="250" duration="500" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="250" duration="1000" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="250" duration="1000" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
		</image>
		<image name="Backscreen-psp" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'psp'</visible>
			<path>./Backscreen.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.331770833333 0.583333333333</pos>
			<size>0.362500000000 0.368518518519</size>
			<zIndex>240</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="screenshot-psp" extra="true">
			<visible>${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'psp'</visible>
			<path>{game:image}</path>
			<origin>0.5 0.5</origin>
			<pos>0.331715210356 0.584322186264</pos>
			<size>0.363066343042 0.368572455951</size>
			<zIndex>249</zIndex>
			<autoFade>false</autoFade>
		</image>
		<video name="gameplayprev-psp" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'psp'</visible>
			<path>{game:video}</path>
			<origin>0.5 0.5</origin>
			<pos>0.331715210356 0.584322186264</pos>
			<size>0.363066343042 0.368572455951</size>
			<zIndex>250</zIndex>
			<effect>none</effect>
			<delay>0.5</delay>
		</video>
		<image name="Video-psp" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'psp'</visible>
			<path>./video.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.296354166667 0.753240740741</pos>
			<size>0.702083333333 0.780555555556</size>
			<zIndex>260</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="led-psp" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'psp'</visible>
			<path>./led.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.628906250000 0.686111111111</pos>
			<size>0.006770833333 0.011111111111</size>
			<zIndex>270</zIndex>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="800" duration="100" mode="Linear"/>
				<animation property="scale" to="1" begin="800" duration="100" autoreverse="false" mode="linear"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="800" duration="100" mode="Linear"/>
				<animation property="scale" to="1" begin="800" duration="100" autoreverse="false" mode="linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="800" duration="100" mode="Linear"/>
				<animation property="scale" to="1" begin="800" duration="100" autoreverse="false" mode="linear"/>
			</storyboard>
		</image>
		<image name="Boxart-psp" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'psp'</visible>
			<path ifSubset="boxorthumb:thumb">firstfile(${box2dpath},${box3dpath})</path>
			<path ifSubset="boxorthumb:boxart">firstfile(${box3dpath},${box2dpath})</path>
			<origin>0.5 0.5</origin>
			<pos>0.774739583333 0.500000000000</pos>
			<maxSize>0.183854166667 0.755555555556</maxSize>
			<zIndex>220</zIndex>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="500" duration="500" mode="Linear"/>
				<animation property="offsetY" from="-1" to="0" begin="500" duration="400" mode="linear"/>
				<animation property="offsetY" from="0" to="-0.06" begin="900" duration="350" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.038" begin="1600" duration="250" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.024" begin="2100" duration="140" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.009" begin="2380" duration="60" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.0025" begin="2500" duration="20" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="0" begin="2540" duration="2500" mode="Linear" autoReverse="true"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="500" duration="500" mode="Linear"/>
				<animation property="offsetY" from="-1" to="0" begin="500" duration="400" mode="linear"/>
				<animation property="offsetY" from="0" to="-0.06" begin="900" duration="350" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.038" begin="1600" duration="250" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.024" begin="2100" duration="140" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.009" begin="2380" duration="60" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.0025" begin="2500" duration="20" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="0" begin="2540" duration="2500" mode="Linear" autoReverse="true"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="500" duration="500" mode="Linear"/>
				<animation property="offsetY" from="-1" to="0" begin="500" duration="400" mode="linear"/>
				<animation property="offsetY" from="0" to="-0.06" begin="900" duration="350" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.038" begin="1600" duration="250" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.024" begin="2100" duration="140" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.009" begin="2380" duration="60" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.0025" begin="2500" duration="20" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="0" begin="2540" duration="2500" mode="Linear" autoReverse="true"/>
			</storyboard>
		</image>
