<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<customView name="hyperbat" displayName="${viewchoice.hyperbat}" inherits="gamecarousel">
		<image name="Background-gba" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'gba'</visible>
			<path>./Background.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.500000000000 0.500000000000</pos>
			<size>1.000000000000 1.000000000000</size>
			<zIndex>100</zIndex>
		</image>
		<image name="Artwork1-gba" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'gba'</visible>
			<path>./Artwork1.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.503385416667 0.121296296296</pos>
			<size>0.673437500000 0.153703703704</size>
			<zIndex>200</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="Backscreen-gba" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'gba'</visible>
			<path>./Backscreen.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.326562500000 0.523611111111</pos>
			<size>0.285416666667 0.349074074074</size>
			<zIndex>210</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="screenshotgba" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'gba'</visible>
			<path>{game:image}</path>
			<origin>0.5 0.5</origin>
			<pos>0.327922734628 0.523642574613</pos>
			<size>0.27 0.37</size>
			<zIndex>219</zIndex>
			<autoFade>false</autoFade>
		</image>
		<video name="gameplayprev-gba" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'gba'</visible>
			<path>{game:video}</path>
			<origin>0.5 0.5</origin>
			<pos>0.327922734628 0.523642574613</pos>
			<size>0.273563915858 0.329917295937</size>
			<zIndex>220</zIndex>
			<effect>none</effect>
			<delay>0.5</delay>
		</video>

		<image name="Video-gba" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'gba'</visible>
			<path>./video.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.331250000000 0.563888888889</pos>
			<size>0.621875000000 0.642592592593</size>
			<zIndex>230</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="Led-gba" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'gba'</visible>
			<path>./Led.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.530729166667 0.350000000000</pos>
			<size>0.013541666667 0.025925925926</size>
			<zIndex>240</zIndex>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1000" duration="100" mode="Linear"/>
				<animation property="scale" to="1" begin="1000" duration="100" autoreverse="false" mode="linear"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1000" duration="100" mode="Linear"/>
				<animation property="scale" to="1" begin="1000" duration="100" autoreverse="false" mode="linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1000" duration="100" mode="Linear"/>
				<animation property="scale" to="1" begin="1000" duration="100" autoreverse="false" mode="linear"/>
			</storyboard>
		</image>
		<image name="Support-gba" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'gba'</visible>
			<path>{game:cartridge}</path>
			<origin>0.5 0.5</origin>
			<pos>0.882552083333 0.742592592593</pos>
			<size>0.167187500000 0.177777777778</size>
			<zIndex>260</zIndex>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="250" duration="500" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="250" duration="1000" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="250" duration="1000" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
		</image>
		<image name="Boxart-gba" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'gba'</visible>
			<path ifSubset="boxorthumb:thumb">firstfile(${box2dpath},${box3dpath})</path>
			<path ifSubset="boxorthumb:boxart">firstfile(${box3dpath},${box2dpath})</path>
			<origin>0.5 0.5</origin>
			<pos>0.780208333333 0.545833333333</pos>
			<maxSize>0.244791666667 0.571296296296</maxSize>
			<zIndex>250</zIndex>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="250" duration="500" mode="Linear"/>
				<animation property="offsetY" from="-1" to="0" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="250" duration="1000" mode="Linear"/>
				<animation property="offsetY" from="-1" to="0" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="250" duration="1000" mode="Linear"/>
				<animation property="offsetY" from="-1" to="0" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
		</image>
		<!-- <control name="Artwork1-gba, Backscreen-gba, gameplayprev-gba, Video-gba"> -->
			<!-- <storyboard event="deactivateNext"> -->
				<!-- <animation property="scale" to="3" begin="" autoreverse="false" duration="200" mode="easyIn"/> -->
				<!-- <animation property="opacity" to="0" begin="100" duration="150" mode="linear"/> -->
			<!-- </storyboard> -->
			<!-- <storyboard event="deactivatePrev"> -->
				<!-- <animation property="scale" to="3" begin="" autoreverse="false" duration="200" mode="easyIn"/> -->
				<!-- <animation property="opacity" to="0" begin="100" duration="150" mode="linear"/> -->
			<!-- </storyboard> -->
		<!-- </control> -->
		<control name="Led-gba, Boxart-gba, Support-gba">
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
		</control>
		<text name="defaultthemeauthor" extra="true">
			<text>Theme by : Akeshi</text>
		</text>
	</customView>
</theme>
