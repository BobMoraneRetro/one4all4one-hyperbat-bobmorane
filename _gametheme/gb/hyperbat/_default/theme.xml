<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<customView name="hyperbat" displayName="${viewchoice.hyperbat}" inherits="gamecarousel">
		<image name="Background-gb" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'gb'</visible>
			<path>./Background.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.500000000000 0.500000000000</pos>
			<size>1.000000000000 1.000000000000</size>
			<zIndex>100</zIndex>
		</image>
		<image name="Backscreen-gb" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'gb'</visible>
			<path>./Backscreen.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.251562500000 0.287037037037</pos>
			<size>0.191666666667 0.312962962963</size>
			<zIndex>210</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<video name="gameplayprev-gb" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'gb'</visible>
			<path>{game:video}</path>
			<origin>0.5 0.5</origin>
			<pos>0.250520833333 0.286111111111</pos>
			<maxSize>0.175000000000 0.287037037037</maxSize>
			<zIndex>220</zIndex>
			<effect>none</effect>
			<delay>0.5</delay>
			<color>8BAC0F</color>
			<saturation>0</saturation>
			<autoFade>false</autoFade>
		</video>
		<image name="Video-gb" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'gb'</visible>
			<path>./video.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.249739583333 0.500000000000</pos>
			<size>0.328645833333 0.966666666667</size>
			<zIndex>230</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="led-gb" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'gb'</visible>
			<path>./led.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.133072916667 0.239814814815</pos>
			<size>0.009895833333 0.018518518519</size>
			<zIndex>240</zIndex>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="450" duration="100" mode="Linear"/>
				<animation property="scale" to="1" begin="450" duration="100" autoreverse="false" mode="linear"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="450" duration="100" mode="Linear"/>
				<animation property="scale" to="1" begin="450" duration="100" autoreverse="false" mode="linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="450" duration="100" mode="Linear"/>
				<animation property="scale" to="1" begin="450" duration="100" autoreverse="false" mode="linear"/>
			</storyboard>
		</image>
		<image name="Support-gb" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'gb'</visible>
			<path>{game:cartridge}</path>
			<origin>0.5 0.5</origin>
			<pos>0.854947916667 0.733796296296</pos>
			<size>0.170312500000 0.336111111111</size>
			<zIndex>260</zIndex>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="400" duration="500" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="400" duration="1000" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="400" duration="1000" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
		</image>
		<image name="Logo-gb" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'gb'</visible>
			<path>./Logo.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.708854166667 0.136111111111</pos>
			<size>0.520833333333 0.194444444444</size>
			<zIndex>270</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="Boxart-gb" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'gb'</visible>
			<path ifSubset="boxorthumb:thumb">firstfile(${box2dpath},${box3dpath})</path>
			<path ifSubset="boxorthumb:boxart">firstfile(${box3dpath},${box2dpath})</path>
			<origin>0.5 0.5</origin>
			<pos>0.670052083333 0.594907407407</pos>
			<maxSize>0.263020833333 0.613888888889</maxSize>
			<zIndex>250</zIndex>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="400" duration="500" mode="Linear"/>
				<animation property="offsetY" from="-1" to="0" begin="400" duration="400" mode="linear"/>
				<animation property="offsetY" from="0" to="-0.06" begin="800" duration="350" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.038" begin="1500" duration="250" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.024" begin="2000" duration="140" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.009" begin="2280" duration="60" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.0025" begin="2400" duration="20" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="0" begin="2440" duration="2500" mode="Linear" autoReverse="true"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="400" duration="500" mode="Linear"/>
				<animation property="offsetY" from="-1" to="0" begin="400" duration="400" mode="linear"/>
				<animation property="offsetY" from="0" to="-0.06" begin="800" duration="350" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.038" begin="1500" duration="250" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.024" begin="2000" duration="140" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.009" begin="2280" duration="60" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.0025" begin="2400" duration="20" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="0" begin="2440" duration="2500" mode="Linear" autoReverse="true"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="400" duration="500" mode="Linear"/>
				<animation property="offsetY" from="-1" to="0" begin="400" duration="400" mode="linear"/>
				<animation property="offsetY" from="0" to="-0.06" begin="800" duration="350" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.038" begin="1500" duration="250" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.024" begin="2000" duration="140" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.009" begin="2280" duration="60" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="-0.0025" begin="2400" duration="20" mode="EaseOutCubic" autoReverse="true"/>
				<animation property="offsetY" from="0" to="0" begin="2440" duration="2500" mode="Linear" autoReverse="true"/>
			</storyboard>
		</image>
